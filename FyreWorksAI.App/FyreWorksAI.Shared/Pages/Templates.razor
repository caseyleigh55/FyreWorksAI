@page "/templates"
@inject WorkspaceStore Store

<PageTitle>Bid Templates</PageTitle>

@if (!Store.IsInitialized)
{
    <div class="loading-state">
        <h1>Loading templates...</h1>
        <p>Preparing bid profiles, numbering rules, rates, and the install matrix.</p>
    </div>
}
else
{
    <section class="workspace-grid">
        <button class="workspace-flag" type="button" @onclick="ToggleDirectoryPanel" title="Toggle Templates panel">Templates</button>
        @if (IsDirectoryPanelExpanded)
        {
            <button class="workspace-drawer-scrim" type="button" @onclick="CloseDirectoryPanel" aria-label="Close Templates panel"></button>
        }
        <aside class="directory-panel directory-drawer @(IsDirectoryPanelExpanded ? "directory-drawer-open" : null)">
            <div class="panel-header">
                <div>
                    <p class="eyebrow">Estimating standards</p>
                    <h2>Templates</h2>
                </div>
                <div class="panel-header-actions">
                    <button class="button" type="button" @onclick="CreateTemplateAsync">New Template</button>
                    <button class="button button-secondary" type="button" @onclick="CloseDirectoryPanel">Collapse</button>
                </div>
            </div>

            <div class="directory-group">
                <h3>Available</h3>
                @foreach (var template in Store.Workspace.Templates.OrderBy(template => template.Name))
                {
                    <button class="directory-item @(SelectedTemplate?.Id == template.Id ? "selected" : null)" type="button" @onclick="() => SelectTemplate(template.Id)">
                        <strong>@template.Name</strong>
                        <span>@(Store.Workspace.Settings.DefaultTemplateId == template.Id ? "Default Profile" : "Bid Profile")</span>
                        <small>@template.BidNumberFormat</small>
                    </button>
                }
            </div>
        </aside>

        <div class="detail-column">
            @if (SelectedTemplate is null)
            {
                <section class="empty-state panel">
                    <h2>No template selected</h2>
                    <p>Create a bid profile to control numbering, rates, markup, and the location/install matrix.</p>
                    <button class="button" type="button" @onclick="CreateTemplateAsync">Create Template</button>
                </section>
            }
            else
            {
                <section class="panel">
                    <div class="panel-header">
                        <div>
                            <p class="eyebrow">Template editor</p>
                            <h2>@SelectedTemplate.Name</h2>
                        </div>
                        <div class="button-row">
                            <button class="button button-secondary" type="button" @onclick="SetDefaultTemplateAsync">Set As Default</button>
                            <button class="button" type="button" @onclick="SaveAsync">Save Template</button>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(StatusMessage))
                    {
                        <p class="callout callout-success">@StatusMessage</p>
                    }

                    <div class="form-grid two-columns">
                        <label><span>Template Name</span><input @bind="SelectedTemplate.Name" /></label>
                        <label class="checkbox-field"><span>Archived</span><input type="checkbox" @bind="SelectedTemplate.IsArchived" /></label>
                        <label><span>Bid Number Format</span><input @bind="SelectedTemplate.BidNumberFormat" /></label>
                        <label><span>Default Markup %</span><input type="number" step="0.01" @bind="SelectedTemplate.DefaultMarkupPercent" /></label>
                    </div>

                    <label class="full-width">
                        <span>Notes</span>
                        <textarea rows="3" @bind="SelectedTemplate.Notes"></textarea>
                    </label>
                </section>

                <section class="panel">
                    <div class="panel-header">
                        <div><p class="eyebrow">Rates</p><h3>Direct + Billed Labor</h3></div>
                    </div>
                    <table class="data-table">
                        <thead>
                            <tr><th>Type</th><th>Hours</th><th>Direct Rate</th><th>Billed Rate</th></tr>
                        </thead>
                        <tbody>
                            <tr><td>Journeyman</td><td>Regular</td><td><input type="number" step="0.01" @bind="SelectedTemplate.JourneymanRegularDirectRate" /></td><td><input type="number" step="0.01" @bind="SelectedTemplate.JourneymanRegularBilledRate" /></td></tr>
                            <tr><td>Journeyman</td><td>Overnight</td><td><input type="number" step="0.01" @bind="SelectedTemplate.JourneymanOvernightDirectRate" /></td><td><input type="number" step="0.01" @bind="SelectedTemplate.JourneymanOvernightBilledRate" /></td></tr>
                            <tr><td>Apprentice</td><td>Regular</td><td><input type="number" step="0.01" @bind="SelectedTemplate.ApprenticeRegularDirectRate" /></td><td><input type="number" step="0.01" @bind="SelectedTemplate.ApprenticeRegularBilledRate" /></td></tr>
                            <tr><td>Apprentice</td><td>Overnight</td><td><input type="number" step="0.01" @bind="SelectedTemplate.ApprenticeOvernightDirectRate" /></td><td><input type="number" step="0.01" @bind="SelectedTemplate.ApprenticeOvernightBilledRate" /></td></tr>
                            <tr><td>Administrative</td><td>Office</td><td><input type="number" step="0.01" @bind="SelectedTemplate.AdminDirectRate" /></td><td><input type="number" step="0.01" @bind="SelectedTemplate.AdminBilledRate" /></td></tr>
                            <tr><td>Engineering</td><td>Office</td><td><input type="number" step="0.01" @bind="SelectedTemplate.EngineeringDirectRate" /></td><td><input type="number" step="0.01" @bind="SelectedTemplate.EngineeringBilledRate" /></td></tr>
                        </tbody>
                    </table>
                </section>

                <section class="panel">
                    <div class="panel-header">
                        <div><p class="eyebrow">Rules</p><h3>Location + Install Time Matrix</h3></div>
                        <button class="button button-secondary" type="button" @onclick="AddRule">Add Rule</button>
                    </div>
                    <table class="data-table wide">
                        <thead>
                            <tr><th class="group-end">Location Profile</th><th class="group-end">Condition</th><th>Install</th><th>Demo</th><th>Trim</th><th class="group-end">Test</th><th>Notes</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var rule in SelectedTemplate.Rules)
                            {
                                <tr @key="rule.Id">
                                    <td><input @bind="rule.LocationProfile" /></td>
                                    <td><input @bind="rule.InstallType" /></td>
                                    <td><input type="number" step="1" @bind="rule.InstallMinutes" /></td>
                                    <td><input type="number" step="1" @bind="rule.DemoMinutes" /></td>
                                    <td><input type="number" step="1" @bind="rule.TrimMinutes" /></td>
                                    <td><input type="number" step="1" @bind="rule.TestMinutes" /></td>
                                    <td><input @bind="rule.Notes" /></td>
                                    <td><button class="text-button danger" type="button" @onclick="() => RemoveRule(rule.Id)">Remove</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </section>
            }
        </div>
    </section>
}

