                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    }
                </section>

                <section class="panel">
                    <div class="panel-header">
                        <div>
                            <p class="eyebrow">Invoice tracking</p>
                            <h3>Invoices</h3>
                        </div>
                        <div class="panel-header-actions">
                            <button class="button button-secondary" type="button" @onclick="AddInvoice">Add Invoice</button>
                            <button class="button button-secondary" type="button" @onclick='() => ToggleSection("invoices")'>@(IsSectionExpanded("invoices") ? "Collapse" : "Expand")</button>
                        </div>
                    </div>

                    @if (invoiceItems.Count == 0)
                    {
                        <p class="muted">Create invoice references here, then assign bid devices and job devices to them for actual cost tracking.</p>
                    }
                    else
                    {
                        <div class="stats-inline">
                            <span>Invoice Total @EstimateMath.GetCurrency(invoiceItems.Sum(item => item.InvoiceTotal))</span>
                            <span>Linked Items @EstimateMath.GetCurrency(invoiceItems.Sum(item => JobFinancialMath.GetInvoiceLinkedActualCost(SelectedJob, item.Id)))</span>
                            <span>Tax / Remainder @EstimateMath.GetCurrency(invoiceItems.Sum(item => JobFinancialMath.GetInvoiceAutoRemainder(SelectedJob, item)))</span>
                        </div>

                        @if (IsSectionExpanded("invoices"))
                        {
                            <div class="field-card-list">
                                @foreach (var invoice in invoiceItems)
                                {
                                    var isExpanded = IsInvoiceExpanded(invoice.Id);

                                    <article class="field-card @(isExpanded ? "field-card-expanded" : "field-card-collapsed")" @key="invoice.Id">
                                        <div class="field-card-summary-row">
                                            <button class="field-card-summary-button" type="button" @onclick="() => ToggleInvoiceExpanded(invoice.Id)">
                                                <strong>@GetInvoiceLabel(invoice)</strong>
                                                <span>Total @EstimateMath.GetCurrency(invoice.InvoiceTotal)</span>
                                                <span>Linked @EstimateMath.GetCurrency(JobFinancialMath.GetInvoiceLinkedActualCost(SelectedJob, invoice.Id))</span>
                                                <span>Remainder @EstimateMath.GetCurrency(JobFinancialMath.GetInvoiceAutoRemainder(SelectedJob, invoice))</span>
                                            </button>
                                            <div class="field-card-summary-actions">
                                                <span class="pill">@((isExpanded ? "Expanded" : "Collapsed"))</span>
                                                <button class="text-button danger" type="button" @onclick="() => RemoveInvoice(invoice.Id)">Remove</button>
                                            </div>
                                        </div>

                                        @if (isExpanded)
                                        {
                                            <div class="field-card-grid field-card-grid-four">
                                                <label>
                                                    <span>Reference #</span>
                                                    <input @bind="invoice.ReferenceNumber" />
                                                </label>
                                                <label>
                                                    <span>Vendor</span>
                                                    <input @bind="invoice.Vendor" />
                                                </label>
                                                <label>
                                                    <span>Invoice #</span>
                                                    <input @bind="invoice.InvoiceNumber" />
                                                </label>
                                                <label>
                                                    <span>Invoice Date</span>
                                                    <input type="date" @bind="invoice.InvoiceDate" @bind:format="yyyy-MM-dd" />
                                                </label>
                                            </div>

                                            <div class="field-card-grid field-card-grid-four">
                                                <label>
                                                    <span>Invoice Total</span>
                                                    <input type="number" step="0.01" @bind="invoice.InvoiceTotal" @bind:event="oninput" @bind:after="@(() => NormalizeInvoice(invoice))" />
                                                </label>
                                                <label>
                                                    <span>Linked Items</span>
                                                    <div class="input-shell value-pill">
                                                        <span class="input-prefix">$</span>
                                                        <span>@EstimateMath.GetCurrency(JobFinancialMath.GetInvoiceLinkedActualCost(SelectedJob, invoice.Id))</span>
                                                    </div>
                                                </label>
                                                <label>
                                                    <span>Auto Tax / Remainder</span>
                                                    <div class="input-shell value-pill">
                                                        <span class="input-prefix">$</span>
                                                        <span>@EstimateMath.GetCurrency(JobFinancialMath.GetInvoiceAutoRemainder(SelectedJob, invoice))</span>
                                                    </div>
                                                </label>
                                                <label>
                                                    <span>Notes</span>
                                                    <textarea class="notes-field" rows="1" @bind="invoice.Notes"></textarea>
                                                </label>
                                            </div>

                                            <AttachmentManager Attachments="invoice.Attachments" Area="@GetInvoiceAttachmentArea()" OwnerId="invoice.Id" />
                                        }
                                    </article>
                                }
                            </div>
                        }
                    }
                </section>

