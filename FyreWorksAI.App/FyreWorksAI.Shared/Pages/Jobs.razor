                                            <td><input type="number" step="0.25" value="@GetTimeEntryHoursInputValue(entry)" @oninput="args => OnTimeEntryHoursChanged(entry, args)" /></td>
                                            <td><span style="@GetTimeEntryRemainingHoursStyle(entry)">@GetTimeEntryRemainingHoursDisplay(entry)</span></td>
                                            <td><input type="number" step="0.01" @bind="entry.HourlyRate" @bind:event="oninput" @bind:after="@(() => NormalizeTimeEntry(entry))" /></td>
