                                            <td><input type="date" @bind="entry.WorkDate" @bind:format="yyyy-MM-dd" /></td>
                                            <td>
                                                <select @bind="entry.CrewMember" @bind:after="@(() => OnTimeEntryLaborTypeChanged(entry))">
