@page "/jobs"
@inject WorkspaceStore Store
@inject NavigationManager NavigationManager

<PageTitle>Jobs</PageTitle>

@if (!Store.IsInitialized)
{
    <div class="loading-state">
        <h1>Loading jobs...</h1>
        <p>Restoring baselines, live costs, commitments, and export settings.</p>
    </div>
}
else
{
    var activeJobs = Store.Workspace.Jobs.Where(item => item.IsActive).OrderBy(item => item.ProjectName).ToList();
    var inactiveJobs = Store.Workspace.Jobs.Where(item => !item.IsActive).OrderByDescending(item => item.CreatedOn).ToList();
    var currentClient = CurrentClient;
    var sourceBid = CurrentSourceBid;
    var bidDeviceItems = SelectedJob?.Baseline.LineItems
        .OrderBy(item => GetDeviceSortOrder(item.CategoryCode))
        .ThenBy(item => item.SourceSection)
        .ThenBy(item => item.Description)
        .ToList() ?? [];
    var officeBidDeviceItems = bidDeviceItems
        .Where(item => JobCostCodes.Normalize(item.CategoryCode) is JobCostCodes.Admin or JobCostCodes.Engineering)
        .ToList();
    var componentBidDeviceItems = bidDeviceItems
        .Where(item => JobCostCodes.Normalize(item.CategoryCode) == JobCostCodes.Components)
        .ToList();
    var wireBidDeviceItems = bidDeviceItems
        .Where(item => JobCostCodes.Normalize(item.CategoryCode) == JobCostCodes.Wire)
        .ToList();
    var materialBidDeviceItems = bidDeviceItems
        .Where(item => JobCostCodes.Normalize(item.CategoryCode) == JobCostCodes.Material)
        .ToList();
    var groupedBidDeviceItems = officeBidDeviceItems
        .Concat(componentBidDeviceItems)
        .Concat(wireBidDeviceItems)
        .Concat(materialBidDeviceItems)
        .DistinctBy(item => item.Id)
        .ToList();
    var bidDeviceTotalItems = groupedBidDeviceItems.Count > 0 ? groupedBidDeviceItems : bidDeviceItems;
    var jobDeviceItems = SelectedJob?.JobDevices
        .OrderBy(item => GetDeviceSortOrder(item.CategoryCode))
        .ThenBy(item => item.Description)
        .ToList() ?? [];
    var invoiceItems = SelectedJob?.Invoices
        .OrderByDescending(item => item.InvoiceDate)
        .ThenBy(item => item.ReferenceNumber)
        .ToList() ?? [];
    var scheduleValueItems = SelectedJob?.ScheduleOfValues
        .OrderBy(item => item.IsChangeOrderLine)
        .ThenBy(item => GetScheduleValueSortOrder(item))
        .ThenBy(item => item.Description)
        .ToList() ?? [];

    <section class="workspace-grid">
        <button class="workspace-flag" type="button" @onclick="ToggleDirectoryPanel" title="Toggle Jobs panel">Jobs</button>
        @if (IsDirectoryPanelExpanded)
        {
            <button class="workspace-drawer-scrim" type="button" @onclick="CloseDirectoryPanel" aria-label="Close Jobs panel"></button>
        }
        <aside class="directory-panel directory-drawer @(IsDirectoryPanelExpanded ? "directory-drawer-open" : null)">
            <div class="panel-header">
                <div>
                    <p class="eyebrow">Project controls</p>
                    <h2>Jobs</h2>
                </div>
                <div class="panel-header-actions">
                    <button class="button" type="button" @onclick="CreateJobAsync">New Job</button>
                    <button class="button button-secondary" type="button" @onclick="CloseDirectoryPanel">Collapse</button>
                </div>
            </div>

            <div class="directory-group">
                <h3>Active</h3>
                @if (activeJobs.Count == 0)
                {
                    <p class="muted">No active jobs yet.</p>
                }
                else
                {
                    @foreach (var job in activeJobs)
                    {
                        <button class="directory-item @(SelectedJob?.Id == job.Id ? "selected" : null)" type="button" @onclick="() => SelectJob(job.Id)">
                            <strong>@job.JobNumber</strong>
                            <span>@job.ProjectName</span>
                            <small>@job.Status</small>
                        </button>
                    }
                }
            </div>

            <div class="directory-group">
                <h3>Inactive</h3>
                @if (inactiveJobs.Count == 0)
                {
                    <p class="muted">No inactive jobs.</p>
                }
                else
                {
                    @foreach (var job in inactiveJobs)
                    {
                        <button class="directory-item @(SelectedJob?.Id == job.Id ? "selected" : null)" type="button" @onclick="() => SelectJob(job.Id)">
                            <strong>@job.JobNumber</strong>
                            <span>@job.ProjectName</span>
                            <small>Closed</small>
                        </button>
                    }
                }
            </div>
        </aside>

        <div class="detail-column">
            @if (SelectedJob is null)
            {
                <section class="empty-state panel">
                    <h2>No job selected</h2>
                    <p>Convert a bid or create a direct-entry job to start cost tracking.</p>
                    <button class="button" type="button" @onclick="CreateJobAsync">Create Job</button>
                </section>
            }
            else
            {
                <section class="panel">
                    <div class="panel-header">
                        <div>
                            <p class="eyebrow">Job editor</p>
                            <h2>@SelectedJob.ProjectName</h2>
                        </div>
                        <div class="button-row">
                            <button class="button button-danger" type="button" @onclick="DeleteJobAsync">Delete Job</button>
                            <button class="button button-secondary" type="button" @onclick="SaveAsync">Save Job</button>
                            <button class="button" type="button" @onclick="ExportAsync">Export Job Cost</button>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(StatusMessage))
                    {
                        <p class="callout callout-success">@StatusMessage</p>
                    }

                    <div class="form-grid two-columns">
                        <label>
                            <span>Job Number</span>
                            <input @bind="SelectedJob.JobNumber" />
                        </label>
                        <label>
                            <span>Project Name</span>
                            <input @bind="SelectedJob.ProjectName" />
                        </label>
                        <label>
                            <span>Status</span>
                            <select @bind="SelectedJob.Status">
                                <option>Planning</option>
                                <option>In Progress</option>
                                <option>Billing</option>
                                <option>Closeout</option>
                                <option>Closed</option>
                            </select>
                        </label>
                        <label class="checkbox-field">
                            <span>Active</span>
                            <input type="checkbox" @bind="SelectedJob.IsActive" />
                        </label>
                        <label>
                            <span>Created</span>
                            <input type="date" @bind="SelectedJob.CreatedOn" @bind:format="yyyy-MM-dd" />
                        </label>
                        <label>
                            <span>Client</span>
                            <select value="@(SelectedJob.ClientId?.ToString() ?? string.Empty)" @onchange="OnClientChanged">
                                <option value="">Unassigned</option>
                                @foreach (var client in Store.Workspace.Clients.Where(client => client.IsActive))
                                {
                                    <option value="@client.Id">@client.Name</option>
                                }
                            </select>
                        </label>
                    </div>
                </section>

                <section class="summary-grid job-summary-grid">
                    <article class="summary-card">
                        <p class="eyebrow">Total Sale</p>
                        <h3>@EstimateMath.GetCurrency(EstimateMath.GetJobRevenue(SelectedJob))</h3>
                        <p>Original contract sale plus approved change orders.</p>
                    </article>
                    <article class="summary-card">
                        <p class="eyebrow">Estimated Cost</p>
                        <h3>@EstimateMath.GetCurrency(EstimateMath.GetJobEstimatedCost(SelectedJob))</h3>
                        <p>Baseline estimated cost plus approved change-order cost.</p>
                    </article>
                    <article class="summary-card">
                        <p class="eyebrow">Actual Cost</p>
                        <h3>@EstimateMath.GetCurrency(EstimateMath.GetJobActualCost(SelectedJob))</h3>
                        <p>Labor, tracked purchases, billed commitments, and approved change-order cost.</p>
                    </article>
                    <article class="summary-card">
                        <p class="eyebrow">Variance To Estimate</p>
                        <h3>@EstimateMath.GetCurrency(EstimateMath.GetJobActualCost(SelectedJob) - EstimateMath.GetJobEstimatedCost(SelectedJob))</h3>
                        <p>Actual cost minus the current estimated cost target.</p>
                    </article>
                    <article class="summary-card">
                        <p class="eyebrow">Profit</p>
                        <h3>@EstimateMath.GetCurrency(EstimateMath.GetJobProfit(SelectedJob))</h3>
                        <p>@EstimateMath.GetPercent(EstimateMath.GetJobMarginPercent(SelectedJob)) margin on current contract value.</p>
                    </article>
                </section>

                <section class="panel">
                    <div class="panel-header">
                        <div>
                            <p class="eyebrow">Client + site</p>
                            <h3>Project Contacts</h3>
                        </div>
                        <div class="panel-header-actions">
                            <button class="button button-secondary" type="button" @onclick="CreateClientForJob">New Client</button>
                            <button class="button button-secondary" type="button" @onclick='() => ToggleSection("project-contacts")'>@(IsSectionExpanded("project-contacts") ? "Collapse" : "Expand")</button>
                        </div>
                    </div>

                    @if (IsSectionExpanded("project-contacts"))
                    {
                        @if (currentClient is null)
                        {
                            <p class="muted">Assign a client to link the job to a company record.</p>
                        }
                        else
                        {
                            <div class="form-grid two-columns">
                                <label>
                                    <span>Client Name</span>
                                    <input @bind="currentClient.Name" />
                                </label>
                                <label>
                                    <span>Primary Contact</span>
                                    <input @bind="currentClient.PrimaryContact" />
                                </label>
                                <label>
                                    <span>Email</span>
                                    <input @bind="currentClient.Email" />
                                </label>
                                <label>
                                    <span>Phone</span>
                                    <input @bind="currentClient.Phone" />
                                </label>
                                <label class="full-width">
                                    <span>Billing Address</span>
                                    <textarea class="notes-field" rows="2" @bind="currentClient.BillingAddress"></textarea>
                                </label>
                            </div>
                        }

                        <div class="form-grid two-columns">
                            <label>
                                <span>Site Name</span>
                                <input @bind="SelectedJob.Site.SiteName" />
                            </label>
                            <label>
                                <span>Occupancy</span>
                                <input @bind="SelectedJob.Site.OccupancyType" />
                            </label>
                            <label>
                                <span>Address Line 1</span>
                                <input @bind="SelectedJob.Site.AddressLine1" />
                            </label>
                            <label>
                                <span>Address Line 2</span>
                                <input @bind="SelectedJob.Site.AddressLine2" />
                            </label>
                            <label>
                                <span>City</span>
                                <input @bind="SelectedJob.Site.City" />
                            </label>
                            <label>
                                <span>State</span>
                                <input @bind="SelectedJob.Site.State" />
                            </label>
                            <label>
                                <span>Postal Code</span>
                                <input @bind="SelectedJob.Site.PostalCode" />
                            </label>
                            <label class="full-width">
                                <span>Site Notes</span>
                                <textarea class="notes-field" rows="1" @bind="SelectedJob.Site.Notes"></textarea>
                            </label>
                        </div>
                    }
                </section>

                <section class="panel">
                    <div class="panel-header">
                        <div>
                            <p class="eyebrow">Client Facing Copy</p>
                            <h3>Exclusions + Proposal</h3>
                        </div>
                        <button class="button button-secondary" type="button" @onclick='() => ToggleSection("client-facing")'>@(IsSectionExpanded("client-facing") ? "Collapse" : "Expand")</button>
                    </div>
                    @if (IsSectionExpanded("client-facing"))
                    {
                        <div class="form-grid">
                            <label class="full-width">
                                <span>Exclusions</span>
                                <textarea class="notes-field" rows="2" @bind="SelectedJob.Exclusions"></textarea>
                            </label>
                            <label class="full-width">
                                <span>Proposal Summary</span>
                                <textarea class="notes-field" rows="2" @bind="SelectedJob.ProposalSummary"></textarea>
                            </label>
                            <label class="full-width">
                                <span>Proposal Closing</span>
                                <textarea class="notes-field" rows="2" @bind="SelectedJob.ProposalClosing"></textarea>
                            </label>
                        </div>
                    }
                </section>

                <section class="panel accent">
                    <div class="panel-header">
                        <div>
                            <p class="eyebrow">Original estimate</p>
                            <h3>Baseline Reference</h3>
                        </div>
                        <div class="panel-header-actions">
                            @if (sourceBid is not null)
                            {
                                <button class="pill pill-button" type="button" @onclick='() => NavigateToBid(sourceBid.Id)'>From @sourceBid.BidNumber</button>
                            }
                            else if (!string.IsNullOrWhiteSpace(SelectedJob.Baseline.SourceBidNumber))
                            {
                                <span class="pill">From @SelectedJob.Baseline.SourceBidNumber</span>
                            }
                            <button class="button button-secondary" type="button" @onclick='() => ToggleSection("baseline-reference")'>@(IsSectionExpanded("baseline-reference") ? "Collapse" : "Expand")</button>
                        </div>
                    </div>

                    <div class="stats-inline">
                        <span>Cost @EstimateMath.GetCurrency(SelectedJob.Baseline.EstimatedTotalCost)</span>
                        <span>Sale @EstimateMath.GetCurrency(SelectedJob.Baseline.OriginalRevenue)</span>
                        <span>Total Hours @EstimateMath.GetHours(GetBaselineTotalHours())</span>
                    </div>

                    @if (IsSectionExpanded("baseline-reference"))
                    {
                        @if (!string.IsNullOrWhiteSpace(SelectedJob.Baseline.ScopeSummary))
                        {
                            <p>@SelectedJob.Baseline.ScopeSummary</p>
                        }

                        <div class="summary-grid">
                            <article class="summary-card">
                                <p class="eyebrow">Admin / Eng</p>
                                <h3>Cost @EstimateMath.GetCurrency(SelectedJob.Baseline.EstimatedAdminCost + SelectedJob.Baseline.EstimatedEngineeringCost)</h3>
                                <p>Sale @EstimateMath.GetCurrency(SelectedJob.Baseline.EstimatedAdminSale + SelectedJob.Baseline.EstimatedEngineeringSale)</p>
                            </article>
                            <article class="summary-card">
                                <p class="eyebrow">Material</p>
                                <h3>Cost @EstimateMath.GetCurrency(SelectedJob.Baseline.EstimatedComponentCost + SelectedJob.Baseline.EstimatedWireCost + SelectedJob.Baseline.EstimatedMaterialOnlyCost)</h3>
                                <p>Sale @EstimateMath.GetCurrency(SelectedJob.Baseline.EstimatedComponentSale + SelectedJob.Baseline.EstimatedWireSale + SelectedJob.Baseline.EstimatedMaterialOnlySale)</p>
                            </article>
                            <article class="summary-card">
                                <p class="eyebrow">Field Labor</p>
                                <h3>Cost @EstimateMath.GetCurrency(SelectedJob.Baseline.EstimatedInstallCost + SelectedJob.Baseline.EstimatedDemoCost + SelectedJob.Baseline.EstimatedTrimCost + SelectedJob.Baseline.EstimatedTestCost)</h3>
                                <p>Sale @EstimateMath.GetCurrency(SelectedJob.Baseline.EstimatedInstallSale + SelectedJob.Baseline.EstimatedDemoSale + SelectedJob.Baseline.EstimatedTrimSale + SelectedJob.Baseline.EstimatedTestSale)</p>
                            </article>
                            <article class="summary-card">
                                <p class="eyebrow">Bid Components</p>
                                <h3>@GetBidComponentCount()</h3>
                                <p>Original bid components available for cost tracking.</p>
                            </article>
                        </div>

                        <table class="data-table wide">
                            <thead>
                                <tr>
                                    <th>Phase</th>
                                    <th>Specified Hours</th>
                                    <th>Used Hours</th>
                                    <th>Remaining Hours</th>
                                    <th>Estimated Cost</th>
                                    <th>Estimated Sale</th>
                                    <th>Actual Cost</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var costCode in JobCostCodes.TimeEntryCodes.Where(code => code != JobCostCodes.Other))
                                {
                                    var specifiedHours = JobFinancialMath.GetBaselineHours(SelectedJob.Baseline, costCode);
                                    var usedHours = JobFinancialMath.GetJobActualHours(SelectedJob, costCode);
                                    var remainingHours = specifiedHours - usedHours;
                                    <tr>
                                        <td>@JobCostCodes.GetLabel(costCode)</td>
                                        <td>@EstimateMath.GetHours(specifiedHours)</td>
                                        <td>@EstimateMath.GetHours(usedHours)</td>
                                        <td>
                                            <span style="@(remainingHours < 0m ? "color: var(--danger);" : null)">@EstimateMath.GetHours(remainingHours)</span>
                                        </td>
                                        <td>@EstimateMath.GetCurrency(GetBaselineCostForCode(costCode))</td>
                                        <td>@EstimateMath.GetCurrency(GetBaselineSaleForCode(costCode))</td>
                                        <td>@EstimateMath.GetCurrency(GetActualCostForCode(costCode))</td>
                                    </tr>

                                        @if (costCode == JobCostCodes.Engineering)
                                        {
                                            <tr class="sov-total-row">
                                                <td><p class="eyebrow">Office Phase Totals</p></td>
                                                <td><span class="compact-total-value">@EstimateMath.GetHours(GetBaselineHoursTotal(BaselineOfficePhaseCodes))</span></td>
                                                <td><span class="compact-total-value">@EstimateMath.GetHours(GetActualHoursTotal(BaselineOfficePhaseCodes))</span></td>
                                                <td><span class="compact-total-value">@EstimateMath.GetHours(GetRemainingHoursTotal(BaselineOfficePhaseCodes))</span></td>
                                                <td><span class="compact-total-value">@EstimateMath.GetCurrency(GetBaselineCostTotal(BaselineOfficePhaseCodes))</span></td>
                                                <td><span class="compact-total-value">@EstimateMath.GetCurrency(GetBaselineSaleTotal(BaselineOfficePhaseCodes))</span></td>
                                                <td><span class="compact-total-value">@EstimateMath.GetCurrency(GetActualCostTotal(BaselineOfficePhaseCodes))</span></td>
                                            </tr>
                                        }
                                    }
                                <tr class="sov-total-row">
                                    <td><p class="eyebrow">Field Phase Totals</p></td>
                                    <td><span class="compact-total-value">@EstimateMath.GetHours(GetBaselineHoursTotal(BaselineFieldPhaseCodes))</span></td>
                                    <td><span class="compact-total-value">@EstimateMath.GetHours(GetActualHoursTotal(BaselineFieldPhaseCodes))</span></td>
                                    <td><span class="compact-total-value">@EstimateMath.GetHours(GetRemainingHoursTotal(BaselineFieldPhaseCodes))</span></td>
                                    <td><span class="compact-total-value">@EstimateMath.GetCurrency(GetBaselineCostTotal(BaselineFieldPhaseCodes))</span></td>
                                    <td><span class="compact-total-value">@EstimateMath.GetCurrency(GetBaselineSaleTotal(BaselineFieldPhaseCodes))</span></td>
                                    <td><span class="compact-total-value">@EstimateMath.GetCurrency(GetActualCostTotal(BaselineFieldPhaseCodes))</span></td>
                                </tr>
                                <tr class="sov-total-row">
                                    <td><strong>All Phase Totals</strong></td>
                                    <td>@EstimateMath.GetHours(GetBaselineHoursTotal(BaselinePhaseCodes))</td>
                                    <td>@EstimateMath.GetHours(GetActualHoursTotal(BaselinePhaseCodes))</td>
                                    <td>@EstimateMath.GetHours(GetRemainingHoursTotal(BaselinePhaseCodes))</td>
                                    <td>@EstimateMath.GetCurrency(GetBaselineCostTotal(BaselinePhaseCodes))</td>
                                    <td>@EstimateMath.GetCurrency(GetBaselineSaleTotal(BaselinePhaseCodes))</td>
                                    <td>@EstimateMath.GetCurrency(GetActualCostTotal(BaselinePhaseCodes))</td>
                                </tr>
                            </tbody>
                        </table>

                        <p class="muted">Bid devices below compare the original estimated cost and estimated sale against the actual cost you assign and tie back to invoice references.</p>
                    }
                </section>

                <section class="panel">
                    <div class="panel-header">
                        <div>
                            <p class="eyebrow">Progress billing</p>
                            <h3>Schedule Of Values</h3>
                        </div>
                        <div class="panel-header-actions">
                            <button class="button button-secondary" type="button" @onclick="AddScheduleValue">Add Line</button>
                            <button class="button button-secondary" type="button" @onclick='() => ToggleSection("schedule-of-values")'>@(IsSectionExpanded("schedule-of-values") ? "Collapse" : "Expand")</button>
                        </div>
                    </div>

                    @if (SelectedJob.ScheduleOfValues.Count == 0)
                    {
                        <p class="muted">Track bid sale references, total values, billed amounts, and collections by billing line.</p>
                    }
                    else
                    {
                        @if (IsSectionExpanded("schedule-of-values"))
                        {
                            <div class="summary-grid">
                                <article class="summary-card">
                                    <p class="eyebrow">Sale Contract</p>
                                    <h3>@EstimateMath.GetCurrency(EstimateMath.GetJobRevenue(SelectedJob))</h3>
                                    <p>Original contract sale plus approved change orders.</p>
                                </article>
                                <article class="summary-card">
                                    <p class="eyebrow">Total Value</p>
                                    <h3>@EstimateMath.GetCurrency(scheduleValueItems.Sum(item => item.ScheduledValue))</h3>
                                    <p>@EstimateMath.GetCurrency(scheduleValueItems.Sum(item => item.ScheduledValue) - EstimateMath.GetJobRevenue(SelectedJob)) variance to sale contract.</p>
                                </article>
                                <article class="summary-card">
                                    <p class="eyebrow">Billed To Date</p>
                                    <h3>@EstimateMath.GetCurrency(EstimateMath.GetJobBilledRevenue(SelectedJob))</h3>
                                    <p>@EstimateMath.GetCurrency(EstimateMath.GetJobCollectedRevenue(SelectedJob)) paid to date.</p>
                                </article>
                                <article class="summary-card">
                                    <p class="eyebrow">Remaining To Bill</p>
                                    <h3>@EstimateMath.GetCurrency(scheduleValueItems.Sum(item => item.RemainingToBill))</h3>
                                    <p>Bid sale references stay visible beside each line's total value.</p>
                                </article>
                            </div>

                            <div class="field-card-list">
                                @foreach (var item in scheduleValueItems)
                                {
                                    var isExpanded = IsScheduleValueExpanded(item.Id);
                                    var isApprovedChangeOrder = IsScheduleValueChangeOrderApproved(item);

                                    <article class="field-card @(isExpanded ? "field-card-expanded" : "field-card-collapsed")" style="@(item.IsChangeOrderLine && !isApprovedChangeOrder ? "opacity: 0.68;" : null)" @key="item.Id">
                                        <div class="field-card-summary-row">
                                            <button class="field-card-summary-button" type="button" @onclick="() => ToggleScheduleValueExpanded(item.Id)">
                                                <strong>@item.Description</strong>
                                                <span>@JobCostCodes.GetLabel(item.CategoryCode)</span>
                                                @if (!item.IsChangeOrderLine)
                                                {
                                                    <span>Bid Sale Ref @EstimateMath.GetCurrency(item.ReferenceValue)</span>
                                                }
                                                <span>Total Value @EstimateMath.GetCurrency(item.ScheduledValue)</span>
                                                <span>% Of Contract @EstimateMath.GetPercent(item.PercentageOfTotal / 100m)</span>
                                                <span>Billed @EstimateMath.GetCurrency(item.BilledToDate)</span>
                                                <span>Paid @EstimateMath.GetCurrency(item.PaidToDate)</span>
                                                <span>Linked Commit % @EstimateMath.GetPercent(GetLinkedCommitmentPaidPercent(item) / 100m)</span>
                                            </button>
                                            <div class="field-card-summary-actions">
                                                <span class="pill">
                                                    @(item.IsChangeOrderLine
                                                        ? (isApprovedChangeOrder ? "Approved" : "Unapproved")
                                                        : (isExpanded ? "Expanded" : "Collapsed"))
                                                </span>
                                                @if (!item.IsChangeOrderLine)
                                                {
                                                    <button class="text-button danger" type="button" @onclick="() => RemoveScheduleValue(item.Id)">Remove</button>
                                                }
                                            </div>
                                        </div>

                                        @if (isExpanded)
                                        {
                                            <table class="data-table compact-table sov-line-editor-table">
                                                <thead>
                                                    <tr>
                                                        <th>Line</th>
                                                        <th>Category</th>
                                                        <th>@(item.IsChangeOrderLine ? "Status" : "Bid Sale Ref")</th>
                                                        <th>Total Value</th>
                                                        <th>% Of Contract</th>
                                                        <th>Billed</th>
                                                        <th>Paid</th>
                                                        <th>% Of SOV Paid</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr>
                                                        <td><input @bind="item.Description" disabled="@item.IsChangeOrderLine" /></td>
                                                        <td>
                                                            <select @bind="item.CategoryCode" disabled="@item.IsChangeOrderLine" @bind:after="@(() => OnScheduleValueCategoryChanged(item))">
                                                                @foreach (var categoryCode in JobCostCodes.ScheduleValueCodes)
                                                                {
                                                                    <option value="@categoryCode">@JobCostCodes.GetLabel(categoryCode)</option>
                                                                }
                                                            </select>
                                                        </td>
                                                        <td>
                                                            <span class="compact-readonly-value">@(item.IsChangeOrderLine ? (isApprovedChangeOrder ? "Approved" : "Unapproved") : EstimateMath.GetCurrency(item.ReferenceValue))</span>
                                                        </td>
                                                        <td>
                                                            <span class="compact-readonly-value">@EstimateMath.GetCurrency(item.ScheduledValue)</span>
                                                        </td>
                                                        <td>
                                                            <span class="compact-readonly-value">@EstimateMath.GetPercent(item.PercentageOfTotal / 100m)</span>
                                                        </td>
                                                        <td>
                                                            <span class="compact-readonly-value">@EstimateMath.GetCurrency(item.BilledToDate)</span>
                                                        </td>
                                                        <td>
                                                            <span class="compact-readonly-value">@EstimateMath.GetCurrency(item.PaidToDate)</span>
                                                        </td>
                                                        <td>
                                                            <span class="compact-readonly-value">@EstimateMath.GetPercent(JobFinancialMath.GetScheduleValuePaidPercent(item) / 100m)</span>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>

                                            <label class="full-width">
                                                <span>Notes</span>
                                                <textarea class="notes-field notes-field-compact" rows="1" @bind="item.Notes"></textarea>
                                            </label>

                                            <div class="sov-subline-panel">
                                                <div class="panel-header minor">
                                                    <div>
                                                        <p class="eyebrow">Progress Entries</p>
                                                        <h4>@item.Description</h4>
                                                    </div>
                                                    <button class="button button-secondary" type="button" @onclick="() => AddScheduleValueSubLine(item)">Add Subline</button>
                                                </div>

                                                @if (item.SubLines.Count == 0)
                                                {
                                                    <p class="muted">Add progress entries here to track multiple billings and payments against this SOV line.</p>
                                                }
                                                else
                                                {
                                                    <table class="data-table compact-table">
                                                        <thead>
                                                            <tr>
                                                                <th>Description</th>
                                                                <th>Linked Commitment</th>
                                                                <th>Line Value</th>
                                                                <th>Billed</th>
                                                                <th>Paid</th>
                                                                <th>% Of Line</th>
                                                                <th>Notes</th>
                                                                <th></th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var subLine in item.SubLines)
                                                            {
                                                                <tr @key="subLine.Id">
                                                                    <td><input @bind="subLine.Description" @bind:after="@SyncJobFinancials" /></td>
                                                                    <td><span>@GetScheduleValueSubLineLinkLabel(subLine)</span></td>
                                                                    <td><input type="number" step="0.01" value="@GetCurrencyInputValue(subLine.LineValue)" @oninput="args => OnScheduleValueSubLineLineValueChanged(item, subLine, args)" /></td>
                                                                    <td><input type="number" step="0.01" @bind="subLine.BilledAmount" @bind:event="oninput" @bind:after="@SyncJobFinancials" /></td>
                                                                    <td><input type="number" step="0.01" @bind="subLine.PaidAmount" @bind:event="oninput" @bind:after="@SyncJobFinancials" /></td>
                                                                    <td>@EstimateMath.GetPercent(GetScheduleValueSubLinePaidPercent(subLine) / 100m)</td>
                                                                    <td><textarea class="notes-field notes-field-compact" rows="1" @bind="subLine.Notes"></textarea></td>
                                                                    <td>
                                                                        @if (subLine.IsAutoGenerated)
                                                                        {
                                                                            <span class="muted small">Auto</span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <button class="text-button danger" type="button" @onclick="() => RemoveScheduleValueSubLine(item, subLine.Id)">Remove</button>
                                                                        }
                                                                    </td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                }
                                            </div>
                                        }
                                    </article>
                                }
                            </div>

                            <table class="data-table compact-table">
                                <thead>
                                    <tr>
                                        <th>Total Type</th>
                                        <th>Bid Sale Ref</th>
                                        <th>Total Value</th>
                                        <th>% Of Contract</th>
                                        <th>Billed</th>
                                        <th>Paid</th>
                                        <th>% Of SOV Paid</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr class="sov-total-row">
                                        <td><strong>Totals</strong></td>
                                        <td>@EstimateMath.GetCurrency(GetScheduleValueReferenceTotal(scheduleValueItems))</td>
                                        <td>@EstimateMath.GetCurrency(scheduleValueItems.Sum(item => item.ScheduledValue))</td>
                                        <td><span style="@GetScheduleValuePercentTotalStyle(scheduleValueItems)">@EstimateMath.GetPercent(GetScheduleValuePercentTotal(scheduleValueItems) / 100m)</span></td>
                                        <td>@EstimateMath.GetCurrency(GetScheduleValueBilledTotal(scheduleValueItems))</td>
                                        <td>@EstimateMath.GetCurrency(GetScheduleValuePaidTotal(scheduleValueItems))</td>
                                        <td>@EstimateMath.GetPercent(GetScheduleValuePaidPercentTotal(scheduleValueItems) / 100m)</td>
                                    </tr>
                                </tbody>
                            </table>
                        }
                    }
                </section>

                <section class="panel">
                    <div class="panel-header">
