    private Guid? GetNextJobId() =>
        Store.Workspace.Jobs
            .Where(job => job.IsActive)
            .OrderBy(job => job.ProjectName)
            .Select(job => (Guid?)job.Id)
            .Concat(
                Store.Workspace.Jobs
                    .Where(job => !job.IsActive)
                    .OrderByDescending(job => job.CreatedOn)
                    .Select(job => (Guid?)job.Id))
            .FirstOrDefault();

