                                                <td><span class="compact-total-value">@EstimateMath.GetCurrency(GetBidDeviceEstimatedSaleTotal(componentBidDeviceItems))</span></td>
                                                <td><span class="compact-total-value">@EstimateMath.GetCurrency(GetBidDeviceActualCostTotal(componentBidDeviceItems))</span></td>
