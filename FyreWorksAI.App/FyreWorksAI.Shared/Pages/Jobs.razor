                <section class="panel">
                    <div class="panel-header">
                        <div>
                            <p class="eyebrow">Added scope tracking</p>
                            <h3>Job Devices</h3>
                        </div>
                        <div class="panel-header-actions">
                            <button class="button button-secondary" type="button" @onclick="AddJobDevice">Add Device</button>
                            <button class="button button-secondary" type="button" @onclick='() => ToggleSection("job-devices")'>@(IsSectionExpanded("job-devices") ? "Collapse" : "Expand")</button>
                        </div>
                    </div>

                    @if (jobDeviceItems.Count == 0)
                    {
                        <p class="muted">Add devices, material, or other cost items that were not part of the original bid.</p>
                    }
                    else
                    {
                        <div class="stats-inline">
                            <span>Estimated @EstimateMath.GetCurrency(jobDeviceItems.Sum(item => item.EstimatedCost))</span>
                            <span>Est. Sale @EstimateMath.GetCurrency(jobDeviceItems.Sum(item => item.EstimatedSale))</span>
                            <span>Actual @EstimateMath.GetCurrency(jobDeviceItems.Sum(item => item.ActualCost))</span>
                            <span>Variance @EstimateMath.GetCurrency(jobDeviceItems.Sum(item => item.ActualCost - item.EstimatedCost))</span>
