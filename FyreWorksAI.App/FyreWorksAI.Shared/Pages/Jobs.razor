@page "/jobs"
@inject WorkspaceStore Store
@inject NavigationManager NavigationManager

<PageTitle>Jobs</PageTitle>

@if (!Store.IsInitialized)
{
    <div class="loading-state">
        <h1>Loading jobs...</h1>
        <p>Restoring baselines, live costs, commitments, and export settings.</p>
    </div>
}

else
{
    var activeJobs = Store.Workspace.Jobs.Where(item => item.IsActive).OrderBy(item => item.ProjectName).ToList();
    var inactiveJobs = Store.Workspace.Jobs.Where(item => !item.IsActive).OrderByDescending(item => item.CreatedOn).ToList();
    var currentClient = CurrentClient;
    var sourceBid = CurrentSourceBid;
    var bidDeviceItems = SelectedJob?.Baseline.LineItems
        .OrderBy(item => GetDeviceSortOrder(item.CategoryCode))
        .ThenBy(item => item.SourceSection)
        .ThenBy(item => item.Description)
        .ToList() ?? [];
    var officeBidDeviceItems = bidDeviceItems
        .Where(item => JobCostCodes.Normalize(item.CategoryCode) is JobCostCodes.Admin or JobCostCodes.Engineering)
        .ToList();
    var componentBidDeviceItems = bidDeviceItems
        .Where(item => JobCostCodes.Normalize(item.CategoryCode) == JobCostCodes.Components)
        .ToList();
    var wireBidDeviceItems = bidDeviceItems
        .Where(item => JobCostCodes.Normalize(item.CategoryCode) == JobCostCodes.Wire)
        .ToList();
    var materialBidDeviceItems = bidDeviceItems
        .Where(item => JobCostCodes.Normalize(item.CategoryCode) == JobCostCodes.Material)
        .ToList();
    var groupedBidDeviceItems = officeBidDeviceItems
        .Concat(componentBidDeviceItems)
        .Concat(wireBidDeviceItems)
        .Concat(materialBidDeviceItems)
        .DistinctBy(item => item.Id)
        .ToList();
    var bidDeviceTotalItems = groupedBidDeviceItems.Count > 0 ? groupedBidDeviceItems : bidDeviceItems;
    var jobDeviceItems = GetJobDeviceItems();
    var dailyLogItems = (SelectedJob?.DailyLogs ?? [])
        .OrderBy(item => item.WorkDate)
        .ThenBy(item => item.Description)
        .ToList();
    if (IsDailyLogsNewestFirst)
    {
        dailyLogItems = dailyLogItems
            .OrderByDescending(item => item.WorkDate)
            .ThenBy(item => item.Description)
            .ToList();
    }
    var changeOrderItems = SelectedJob?.ChangeOrders
        .OrderByDescending(item => item.ApprovedOn)
        .ThenBy(item => item.Title)
        .ToList() ?? [];
    var invoiceItems = SelectedJob?.Invoices
        .OrderByDescending(item => item.InvoiceDate)
        .ThenBy(item => item.ReferenceNumber)
        .ToList() ?? [];
    var scheduleValueItems = SelectedJob?.ScheduleOfValues
        .OrderBy(item => item.IsChangeOrderLine)
        .ThenBy(item => GetScheduleValueSortOrder(item))
        .ThenBy(item => item.Description)
        .ToList() ?? [];
    var laborScopeSummaries = GetLaborScopeSummaries().ToList();
    var personnelHourSummaries = GetPersonnelHourSummaries().ToList();
    var personnelNameSuggestions = GetPersonnelNameSuggestions().ToList();
    var projectEstimateVariance = GetProjectEstimateVariance();

    @if (personnelNameSuggestions.Count > 0)
    {
        <datalist id="@PersonnelNameSuggestionsListId">
            @foreach (var name in personnelNameSuggestions)
            {
                <option value="@name"></option>
            }
        </datalist>
    }

    <section class="workspace-grid">
        <button class="workspace-flag" type="button" @onclick="ToggleDirectoryPanel" title="Toggle Jobs panel">Jobs</button>
        @if (IsDirectoryPanelExpanded)
        {
            <button class="workspace-drawer-scrim" type="button" @onclick="CloseDirectoryPanel" aria-label="Close Jobs panel"></button>
        }
        <aside class="directory-panel directory-drawer @(IsDirectoryPanelExpanded ? "directory-drawer-open" : null)">
            <div class="panel-header">
                <div>
                    <p class="eyebrow">Project controls</p>
                    <h2>Jobs</h2>
                </div>
                <div class="panel-header-actions">
                    <button class="button" type="button" @onclick="CreateJobAsync">New Job</button>
                    <button class="button button-secondary" type="button" @onclick="CloseDirectoryPanel">Collapse</button>
                </div>
            </div>

            <div class="directory-group">
                <h3>Active</h3>
                @if (activeJobs.Count == 0)
                {
                    <p class="muted">No active jobs yet.</p>
                }
                else
                {
                    @foreach (var job in activeJobs)
                    {
                        <button class="directory-item @(SelectedJob?.Id == job.Id ? "selected" : null)" type="button" @onclick="() => SelectJob(job.Id)">
                            <strong>@job.JobNumber</strong>
                            <span>@job.ProjectName</span>
                            <small>@job.Status</small>
                        </button>
                    }
                }
            </div>

            <div class="directory-group">
                <h3>Inactive</h3>
                @if (inactiveJobs.Count == 0)
                {
                    <p class="muted">No inactive jobs.</p>
                }
                else
                {
                    @foreach (var job in inactiveJobs)
                    {
                        <button class="directory-item @(SelectedJob?.Id == job.Id ? "selected" : null)" type="button" @onclick="() => SelectJob(job.Id)">
                            <strong>@job.JobNumber</strong>
                            <span>@job.ProjectName</span>
                            <small>Closed</small>
                        </button>
                    }
                }
            </div>
        </aside>

        <div class="detail-column">
            @if (SelectedJob is null)
            {
                <section class="empty-state panel">
                    <h2>No job selected</h2>
                    <p>Convert a bid or create a direct-entry job to start cost tracking.</p>
                    <button class="button" type="button" @onclick="CreateJobAsync">Create Job</button>
                </section>
            }
            else
            {
                <section class="panel">
                    <div class="panel-header">
                        <div>
                            <p class="eyebrow">Job editor</p>
                            <h2>@SelectedJob.ProjectName</h2>
                        </div>
                        <div class="button-row">
                            <button class="button button-danger" type="button" @onclick="DeleteJobAsync">Delete Job</button>
                            <button class="button button-secondary" type="button" @onclick="SaveAsync">Save Job</button>
                            <button class="button" type="button" @onclick="ExportAsync">Export Job Report</button>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(StatusMessage))
                    {
                        <p class="callout callout-success">@StatusMessage</p>
                    }

                    <div class="form-grid two-columns">
                        <label>
                            <span>Job Number</span>
                            <input @bind="SelectedJob.JobNumber" />
                        </label>
                        <label>
                            <span>Project Name</span>
                            <input @bind="SelectedJob.ProjectName" @bind:after="RefreshPageSectionNavigation" />
                        </label>
                        <label>
                            <span>Status</span>
                            <select @bind="SelectedJob.Status">
                                <option>Planning</option>
                                <option>In Progress</option>
                                <option>Billing</option>
                                <option>Closeout</option>
                                <option>Closed</option>
                            </select>
                        </label>
                        <label class="checkbox-field">
                            <span>Active</span>
                            <input type="checkbox" @bind="SelectedJob.IsActive" />
                        </label>
                        <label>
                            <span>Created</span>
                            <input type="date" @bind="SelectedJob.CreatedOn" @bind:format="yyyy-MM-dd" />
                        </label>
                        <label>
                            <span>Client</span>
                            <select value="@(SelectedJob.ClientId?.ToString() ?? string.Empty)" @onchange="OnClientChanged">
                                <option value="">Unassigned</option>
                                @foreach (var client in Store.Workspace.Clients.Where(client => client.IsActive))
                                {
                                    <option value="@client.Id">@client.Name</option>
                                }
                            </select>
                        </label>
                    </div>
                </section>

                <section class="panel project-overview-panel">
                    <div class="panel-header">
                        <div>
                            <p class="eyebrow">Current Snapshot</p>
                            <h3>Project Totals</h3>
                        </div>
                        <p class="muted">Revenue, billing, cost, labor, commitments, and crew hours lined up in one place.</p>
                    </div>

                    <div class="project-overview-grid">
                        <article class="summary-card project-overview-card">
                            <p class="eyebrow">Contract + Billing</p>
                            <div class="metric-list">
                                <div><span>Base Contract</span><strong>@EstimateMath.GetCurrency(SelectedJob.Baseline.OriginalRevenue)</strong></div>
                                <div><span>Approved CO Sale</span><strong>@EstimateMath.GetCurrency(EstimateMath.GetJobApprovedChangeOrderRevenue(SelectedJob))</strong></div>
                                <div><span>Total Sale</span><strong>@EstimateMath.GetCurrency(EstimateMath.GetJobRevenue(SelectedJob))</strong></div>
                                <div><span>SOV Total Value</span><strong>@EstimateMath.GetCurrency(scheduleValueItems.Sum(item => item.ScheduledValue))</strong></div>
                                <div><span>Billed To Date</span><strong>@EstimateMath.GetCurrency(EstimateMath.GetJobBilledRevenue(SelectedJob))</strong></div>
                                <div><span>Collected</span><strong>@EstimateMath.GetCurrency(EstimateMath.GetJobCollectedRevenue(SelectedJob))</strong></div>
                                <div><span>Remaining To Bill</span><strong>@EstimateMath.GetCurrency(scheduleValueItems.Sum(item => item.RemainingToBill))</strong></div>
                            </div>
                        </article>

                        <article class="summary-card project-overview-card">
                            <p class="eyebrow">Cost + Profit</p>
                            <div class="metric-list">
                                <div><span>Baseline Estimate</span><strong>@EstimateMath.GetCurrency(SelectedJob.Baseline.EstimatedTotalCost)</strong></div>
                                <div><span>Approved CO Est. Cost</span><strong>@EstimateMath.GetCurrency(EstimateMath.GetJobApprovedChangeOrderCost(SelectedJob))</strong></div>
                                <div><span>Total Estimated Cost</span><strong>@EstimateMath.GetCurrency(EstimateMath.GetJobEstimatedCost(SelectedJob))</strong></div>
                                <div><span>Actual Labor</span><strong>@EstimateMath.GetCurrency(EstimateMath.GetJobActualLaborCost(SelectedJob))</strong></div>
                                <div><span>Actual Material</span><strong>@EstimateMath.GetCurrency(EstimateMath.GetJobActualMaterialCost(SelectedJob))</strong></div>
                                <div><span>Billed Commitments</span><strong>@EstimateMath.GetCurrency(EstimateMath.GetJobBilledCommitments(SelectedJob))</strong></div>
                                <div><span>Actual Cost</span><strong>@EstimateMath.GetCurrency(EstimateMath.GetJobActualCost(SelectedJob))</strong></div>
                                <div><span>Cost Variance To Estimate</span><strong style="@GetEstimateVarianceStyle(projectEstimateVariance)">@EstimateMath.GetCurrency(projectEstimateVariance)</strong></div>
                                <div><span>Profit</span><strong>@EstimateMath.GetCurrency(EstimateMath.GetJobProfit(SelectedJob))</strong></div>
                                <div><span>Margin</span><strong>@EstimateMath.GetPercent(EstimateMath.GetJobMarginPercent(SelectedJob))</strong></div>
                            </div>
                        </article>

                        <article class="summary-card project-overview-card">
                            <p class="eyebrow">Labor + Hours</p>
                            <div class="metric-list">
                                <div><span>Base Planned Hours</span><strong>@EstimateMath.GetHours(GetBaselineTotalHours())</strong></div>
                                <div><span>Approved CO Hours</span><strong>@EstimateMath.GetHours(GetApprovedChangeOrderEstimatedLaborHoursTotal())</strong></div>
                                <div><span>Contract Hours Planned</span><strong>@EstimateMath.GetHours(GetContractPlannedLaborHours())</strong></div>
                                <div><span>Base Used Hours</span><strong>@EstimateMath.GetHours(GetActualHoursTotal(BaselinePhaseCodes))</strong></div>
                                <div><span>Approved CO Used Hours</span><strong>@EstimateMath.GetHours(GetApprovedChangeOrderActualLaborHoursTotal())</strong></div>
                                <div><span>All Logged Hours</span><strong>@EstimateMath.GetHours(EstimateMath.GetJobActualLaborHours(SelectedJob))</strong></div>
                                <div><span>Contract Hours Remaining</span><strong style="@GetRemainingHoursStyle(GetContractRemainingLaborHours())">@EstimateMath.GetHours(GetContractRemainingLaborHours())</strong></div>
                            </div>
                        </article>

                        <article class="summary-card project-overview-card">
                            <p class="eyebrow">Vendor commitments</p>
                            <div class="metric-list">
                                <div><span>Commitment Records</span><strong>@SelectedJob.Commitments.Count</strong></div>
                                <div><span>Committed</span><strong>@EstimateMath.GetCurrency(GetCommittedAmountTotal())</strong></div>
                                <div><span>Billed</span><strong>@EstimateMath.GetCurrency(EstimateMath.GetJobBilledCommitments(SelectedJob))</strong></div>
                                <div><span>Paid</span><strong>@EstimateMath.GetCurrency(GetPaidCommitmentsTotal())</strong></div>
                                <div><span>Unpaid Bills</span><strong>@EstimateMath.GetCurrency(GetOutstandingBilledCommitmentsTotal())</strong></div>
                                <div><span>Remaining To Pay</span><strong>@EstimateMath.GetCurrency(GetRemainingCommitmentBalanceTotal())</strong></div>
                            </div>
                        </article>

                        <article class="summary-card project-overview-card project-overview-card-full">
                            <p class="eyebrow">Crew Hours</p>
                            @if (personnelHourSummaries.Count == 0)
                            {
                                <p class="muted">Crew names entered in Daily Logs will show up here and become reusable suggestions for future logs.</p>
                            }
                            else
                            {
                                <table class="data-table compact-table">
                                    <thead>
                                        <tr>
                                            <th>Name</th>
                                            <th>Hours</th>
                                            <th>Cost</th>
                                            <th>Daily Logs</th>
                                            <th>Entries</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var crewSummary in personnelHourSummaries)
                                        {
                                            <tr>
                                                <td>@crewSummary.Name</td>
                                                <td>@EstimateMath.GetHours(crewSummary.Hours)</td>
                                                <td>@EstimateMath.GetCurrency(crewSummary.Cost)</td>
                                                <td>@crewSummary.DailyLogs</td>
                                                <td>@crewSummary.Entries</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </article>
                    </div>
                </section>

                <section class="panel jobs-workflow-panel">
                    <div class="panel-header">
                        <div>
                            <p class="eyebrow">Recommended Flow</p>
                            <h3>Job Workflow</h3>
                        </div>
                        <p class="muted">Move left to right when you are entering or cleaning up a job so the linked sections stay aligned.</p>
                    </div>

                    <div class="workflow-map-grid">
                        <article class="workflow-step">
                            <p class="eyebrow">Step 1</p>
                            <h4>Setup + Contract</h4>
                            <p class="muted">Anchor the project, client-facing copy, and original estimate first.</p>
                            <div class="section-link-row">
                                <button class="pill pill-button" type="button" @onclick='() => NavigateToJobSectionAsync(ProjectContactsSectionId)'>Contacts</button>
                                <button class="pill pill-button" type="button" @onclick='() => NavigateToJobSectionAsync(ClientFacingSectionId)'>Proposal</button>
                                <button class="pill pill-button" type="button" @onclick='() => NavigateToJobSectionAsync(BaselineReferenceSectionId)'>Baseline</button>
                            </div>
                        </article>
                        <article class="workflow-step">
                            <p class="eyebrow">Step 2</p>
                            <h4>Revenue Plan</h4>
                            <p class="muted">Set change orders before billing lines so SOV values reflect the current contract.</p>
                            <div class="section-link-row">
                                <button class="pill pill-button" type="button" @onclick='() => NavigateToJobSectionAsync(ChangeOrdersSectionId)'>COs</button>
                                <button class="pill pill-button" type="button" @onclick='() => NavigateToJobSectionAsync(ScheduleOfValuesSectionId)'>SOV</button>
                            </div>
                        </article>
                        <article class="workflow-step">
                            <p class="eyebrow">Step 3</p>
                            <h4>Material Cost</h4>
                            <p class="muted">Create invoice shells, then tie base and added scope items back to those bills.</p>
                            <div class="section-link-row">
                                <button class="pill pill-button" type="button" @onclick='() => NavigateToJobSectionAsync(InvoicesSectionId)'>Invoices</button>
                                <button class="pill pill-button" type="button" @onclick='() => NavigateToJobSectionAsync(BidDevicesSectionId)'>Base Scope</button>
                                <button class="pill pill-button" type="button" @onclick='() => NavigateToJobSectionAsync(JobDevicesSectionId)'>Job Scope</button>
                            </div>
                        </article>
                        <article class="workflow-step">
                            <p class="eyebrow">Step 4</p>
                            <h4>Labor + Closeout</h4>
                            <p class="muted">Track time, subcontract/vendor commitments, and final notes once the scope is in place.</p>
                            <div class="section-link-row">
                                <button class="pill pill-button" type="button" @onclick='() => NavigateToJobSectionAsync(TimeEntriesSectionId)'>Labor</button>
                                <button class="pill pill-button" type="button" @onclick='() => NavigateToJobSectionAsync(CommitmentsSectionId)'>Subs + POs</button>
                                <button class="pill pill-button" type="button" @onclick='() => NavigateToJobSectionAsync(ProjectNotesSectionId)'>Notes</button>
                            </div>
                        </article>
                    </div>
                </section>

                <section id="@ProjectContactsElementId" class="panel jobs-section jobs-section-contacts page-section-anchor @(IsSectionExpanded(ProjectContactsSectionId) ? "panel-expanded" : null)">
                    <div class="panel-header">
                        <div>
                            <p class="eyebrow">Client + site</p>
                            <h3>Project Contacts</h3>
                        </div>
                        <div class="panel-header-actions">
                            <button class="button button-secondary" type="button" @onclick="CreateClientForJob">New Client</button>
                            <button class="button button-secondary" type="button" @onclick='() => ToggleSection(ProjectContactsSectionId)'>@(IsSectionExpanded(ProjectContactsSectionId) ? "Collapse" : "Expand")</button>
                        </div>
                    </div>

                    @if (IsSectionExpanded(ProjectContactsSectionId))
                    {
                        @if (currentClient is null)
                        {
                            <p class="muted">Assign a client to link the job to a company record.</p>
                        }
                        else
                        {
                            <div class="form-grid two-columns">
                                <label>
                                    <span>Client Name</span>
                                    <input @bind="currentClient.Name" />
                                </label>
                                <label>
                                    <span>Primary Contact</span>
                                    <input @bind="currentClient.PrimaryContact" />
                                </label>
                                <label>
                                    <span>Email</span>
                                    <input @bind="currentClient.Email" />
                                </label>
                                <label>
                                    <span>Phone</span>
                                    <input @bind="currentClient.Phone" />
                                </label>
                                <label class="full-width">
                                    <span>Billing Address</span>
                                    <textarea class="notes-field" rows="2" @bind="currentClient.BillingAddress"></textarea>
                                </label>
                            </div>
                        }

                        <div class="form-grid two-columns">
                            <label>
                                <span>Site Name</span>
                                <input @bind="SelectedJob.Site.SiteName" />
                            </label>
                            <label>
                                <span>Occupancy</span>
                                <input @bind="SelectedJob.Site.OccupancyType" />
                            </label>
                            <label>
                                <span>Address Line 1</span>
                                <input @bind="SelectedJob.Site.AddressLine1" />
                            </label>
                            <label>
                                <span>Address Line 2</span>
                                <input @bind="SelectedJob.Site.AddressLine2" />
                            </label>
                            <label>
                                <span>City</span>
                                <input @bind="SelectedJob.Site.City" />
                            </label>
                            <label>
                                <span>State</span>
                                <input @bind="SelectedJob.Site.State" />
                            </label>
                            <label>
                                <span>Postal Code</span>
                                <input @bind="SelectedJob.Site.PostalCode" />
                            </label>
                            <label class="full-width">
                                <span>Site Notes</span>
                                <textarea class="notes-field" rows="1" @bind="SelectedJob.Site.Notes"></textarea>
                            </label>
                        </div>
                    }
                </section>

                <section id="@ClientFacingElementId" class="panel jobs-section jobs-section-proposal page-section-anchor @(IsSectionExpanded(ClientFacingSectionId) ? "panel-expanded" : null)">
                    <div class="panel-header">
                        <div>
                            <p class="eyebrow">Client Facing Copy</p>
                            <h3>Exclusions + Proposal</h3>
                        </div>
                        <button class="button button-secondary" type="button" @onclick='() => ToggleSection(ClientFacingSectionId)'>@(IsSectionExpanded(ClientFacingSectionId) ? "Collapse" : "Expand")</button>
                    </div>
                    @if (IsSectionExpanded(ClientFacingSectionId))
                    {
                        <div class="form-grid">
                            <label class="full-width">
                                <span>Exclusions</span>
                                <textarea class="notes-field" rows="2" @bind="SelectedJob.Exclusions"></textarea>
                            </label>
                            <label class="full-width">
                                <span>Proposal Summary</span>
                                <textarea class="notes-field" rows="2" @bind="SelectedJob.ProposalSummary"></textarea>
                            </label>
                            <label class="full-width">
                                <span>Proposal Closing</span>
                                <textarea class="notes-field" rows="2" @bind="SelectedJob.ProposalClosing"></textarea>
                            </label>
                        </div>
                    }
                </section>

                <section id="@BaselineReferenceElementId" class="panel accent jobs-section jobs-section-baseline page-section-anchor">
                    <div class="panel-header">
                        <div>
                            <p class="eyebrow">Original estimate</p>
                            <h3>Baseline Reference</h3>
                        </div>
                        <div class="panel-header-actions">
                            @if (sourceBid is not null)
                            {
                                <button class="pill pill-button" type="button" @onclick='() => NavigateToBid(sourceBid.Id)'>From @sourceBid.BidNumber</button>
                            }
                            else if (!string.IsNullOrWhiteSpace(SelectedJob.Baseline.SourceBidNumber))
                            {
                                <span class="pill">From @SelectedJob.Baseline.SourceBidNumber</span>
                            }
                            <button class="button button-secondary" type="button" @onclick='() => ToggleSection(BaselineReferenceSectionId)'>@(IsSectionExpanded(BaselineReferenceSectionId) ? "Collapse" : "Expand")</button>
                        </div>
                    </div>

                    <div class="stats-inline">
                        <span>Cost @EstimateMath.GetCurrency(SelectedJob.Baseline.EstimatedTotalCost)</span>
                        <span>Sale @EstimateMath.GetCurrency(SelectedJob.Baseline.OriginalRevenue)</span>
                        <span>Total Hours @EstimateMath.GetHours(GetBaselineTotalHours())</span>
                    </div>

                    <div class="section-link-row">
                        <button class="pill pill-button" type="button" @onclick='() => NavigateToJobSectionAsync(ChangeOrdersSectionId)'>To COs</button>
                        <button class="pill pill-button" type="button" @onclick='() => NavigateToJobSectionAsync(ScheduleOfValuesSectionId)'>To SOV</button>
                        <button class="pill pill-button" type="button" @onclick='() => NavigateToJobSectionAsync(InvoicesSectionId)'>To Invoices</button>
                    </div>

                    @if (IsSectionExpanded(BaselineReferenceSectionId))
                    {
                        @if (!string.IsNullOrWhiteSpace(SelectedJob.Baseline.ScopeSummary))
                        {
                            <p>@SelectedJob.Baseline.ScopeSummary</p>
                        }

                        <div class="summary-grid">
                            <article class="summary-card">
                                <p class="eyebrow">Admin / Eng</p>
                                <h3>Cost @EstimateMath.GetCurrency(SelectedJob.Baseline.EstimatedAdminCost + SelectedJob.Baseline.EstimatedEngineeringCost)</h3>
                                <p>Sale @EstimateMath.GetCurrency(SelectedJob.Baseline.EstimatedAdminSale + SelectedJob.Baseline.EstimatedEngineeringSale)</p>
                            </article>
                            <article class="summary-card">
                                <p class="eyebrow">Material</p>
                                <h3>Cost @EstimateMath.GetCurrency(SelectedJob.Baseline.EstimatedComponentCost + SelectedJob.Baseline.EstimatedWireCost + SelectedJob.Baseline.EstimatedMaterialOnlyCost)</h3>
                                <p>Sale @EstimateMath.GetCurrency(SelectedJob.Baseline.EstimatedComponentSale + SelectedJob.Baseline.EstimatedWireSale + SelectedJob.Baseline.EstimatedMaterialOnlySale)</p>
                            </article>
                            <article class="summary-card">
                                <p class="eyebrow">Field Labor</p>
                                <h3>Cost @EstimateMath.GetCurrency(SelectedJob.Baseline.EstimatedInstallCost + SelectedJob.Baseline.EstimatedDemoCost + SelectedJob.Baseline.EstimatedTrimCost + SelectedJob.Baseline.EstimatedTestCost)</h3>
                                <p>Sale @EstimateMath.GetCurrency(SelectedJob.Baseline.EstimatedInstallSale + SelectedJob.Baseline.EstimatedDemoSale + SelectedJob.Baseline.EstimatedTrimSale + SelectedJob.Baseline.EstimatedTestSale)</p>
                            </article>
                            <article class="summary-card">
                                <p class="eyebrow">Bid Components</p>
                                <h3>@GetBidComponentCount()</h3>
                                <p>Original bid components available for cost tracking.</p>
                            </article>
                        </div>

                        <table class="data-table wide">
                            <thead>
                                <tr>
                                    <th>Phase</th>
                                    <th>Specified Hours</th>
                                    <th>Used Hours</th>
                                    <th>Remaining Hours</th>
                                    <th>Estimated Cost</th>
                                    <th>Estimated Sale</th>
                                    <th>Actual Cost</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var costCode in JobCostCodes.TimeEntryCodes.Where(code => code != JobCostCodes.Other && code != JobCostCodes.ChangeOrder))
                                {
                                    var specifiedHours = JobFinancialMath.GetBaselineHours(SelectedJob.Baseline, costCode);
                                    var usedHours = JobFinancialMath.GetJobActualHours(SelectedJob, costCode);
                                    var remainingHours = specifiedHours - usedHours;
                                    <tr>
                                        <td>@JobCostCodes.GetLabel(costCode)</td>
                                        <td>@EstimateMath.GetHours(specifiedHours)</td>
                                        <td>@EstimateMath.GetHours(usedHours)</td>
                                        <td>
                                            <span style="@(remainingHours < 0m ? "color: var(--danger);" : null)">@EstimateMath.GetHours(remainingHours)</span>
                                        </td>
                                        <td>@EstimateMath.GetCurrency(GetBaselineCostForCode(costCode))</td>
                                        <td>@EstimateMath.GetCurrency(GetBaselineSaleForCode(costCode))</td>
                                        <td>@EstimateMath.GetCurrency(GetActualCostForCode(costCode))</td>
                                    </tr>

                                        @if (costCode == JobCostCodes.Engineering)
                                        {
                                            <tr class="sov-total-row">
                                                <td><p class="eyebrow">Office Phase Totals</p></td>
                                                <td><span class="compact-total-value">@EstimateMath.GetHours(GetBaselineHoursTotal(BaselineOfficePhaseCodes))</span></td>
                                                <td><span class="compact-total-value">@EstimateMath.GetHours(GetActualHoursTotal(BaselineOfficePhaseCodes))</span></td>
                                                <td><span class="compact-total-value">@EstimateMath.GetHours(GetRemainingHoursTotal(BaselineOfficePhaseCodes))</span></td>
                                                <td><span class="compact-total-value">@EstimateMath.GetCurrency(GetBaselineCostTotal(BaselineOfficePhaseCodes))</span></td>
                                                <td><span class="compact-total-value">@EstimateMath.GetCurrency(GetBaselineSaleTotal(BaselineOfficePhaseCodes))</span></td>
                                                <td><span class="compact-total-value">@EstimateMath.GetCurrency(GetActualCostTotal(BaselineOfficePhaseCodes))</span></td>
                                            </tr>
                                        }
                                    }
                                <tr class="sov-total-row">
                                    <td><p class="eyebrow">Field Phase Totals</p></td>
                                    <td><span class="compact-total-value">@EstimateMath.GetHours(GetBaselineHoursTotal(BaselineFieldPhaseCodes))</span></td>
                                    <td><span class="compact-total-value">@EstimateMath.GetHours(GetActualHoursTotal(BaselineFieldPhaseCodes))</span></td>
                                    <td><span class="compact-total-value">@EstimateMath.GetHours(GetRemainingHoursTotal(BaselineFieldPhaseCodes))</span></td>
                                    <td><span class="compact-total-value">@EstimateMath.GetCurrency(GetBaselineCostTotal(BaselineFieldPhaseCodes))</span></td>
                                    <td><span class="compact-total-value">@EstimateMath.GetCurrency(GetBaselineSaleTotal(BaselineFieldPhaseCodes))</span></td>
                                    <td><span class="compact-total-value">@EstimateMath.GetCurrency(GetActualCostTotal(BaselineFieldPhaseCodes))</span></td>
                                </tr>
                                <tr class="sov-total-row">
                                    <td><strong>All Phase Totals</strong></td>
                                    <td>@EstimateMath.GetHours(GetBaselineHoursTotal(BaselinePhaseCodes))</td>
                                    <td>@EstimateMath.GetHours(GetActualHoursTotal(BaselinePhaseCodes))</td>
                                    <td>@EstimateMath.GetHours(GetRemainingHoursTotal(BaselinePhaseCodes))</td>
                                    <td>@EstimateMath.GetCurrency(GetBaselineCostTotal(BaselinePhaseCodes))</td>
                                    <td>@EstimateMath.GetCurrency(GetBaselineSaleTotal(BaselinePhaseCodes))</td>
                                    <td>@EstimateMath.GetCurrency(GetActualCostTotal(BaselinePhaseCodes))</td>
                                </tr>
                            </tbody>
                        </table>

                        <p class="muted">Bid devices below compare the original estimated cost and estimated sale against the actual cost you assign and tie back to invoice references.</p>
                    }
                </section>

                <section id="@ScheduleOfValuesElementId" class="panel jobs-section jobs-section-sov page-section-anchor @(IsSectionExpanded(ScheduleOfValuesSectionId) ? "panel-expanded" : null)">
                    <div class="panel-header">
                        <div>
                            <p class="eyebrow">Progress billing</p>
                            <h3>Schedule Of Values</h3>
                        </div>
                        <div class="panel-header-actions">
                            <button class="button button-secondary" type="button" @onclick='() => ToggleSection(ScheduleOfValuesSectionId)'>@(IsSectionExpanded(ScheduleOfValuesSectionId) ? "Collapse" : "Expand")</button>
                        </div>
                    </div>

                    <div class="section-link-row">
                        <button class="pill pill-button" type="button" @onclick='() => NavigateToJobSectionAsync(ChangeOrdersSectionId)'>To COs</button>
                        <button class="pill pill-button" type="button" @onclick='() => NavigateToJobSectionAsync(CommitmentsSectionId)'>To Subs + POs</button>
                        <button class="pill pill-button" type="button" @onclick='() => NavigateToJobSectionAsync(InvoicesSectionId)'>To Invoices</button>
                    </div>

                    @if (SelectedJob.ScheduleOfValues.Count == 0)
                    {
                        <p class="muted">Track bid sale references, total values, billed amounts, and collections by billing line.</p>
                    }
                    else
                    {
                        @if (IsSectionExpanded(ScheduleOfValuesSectionId))
                        {
                            <div class="summary-grid">
                                <article class="summary-card">
                                    <p class="eyebrow">Sale Contract</p>
                                    <h3>@EstimateMath.GetCurrency(EstimateMath.GetJobRevenue(SelectedJob))</h3>
                                    <p>Original contract sale plus approved change orders.</p>
                                </article>
                                <article class="summary-card">
                                    <p class="eyebrow">Total Value</p>
                                    <h3>@EstimateMath.GetCurrency(scheduleValueItems.Sum(item => item.ScheduledValue))</h3>
                                    <p>@EstimateMath.GetCurrency(scheduleValueItems.Sum(item => item.ScheduledValue) - EstimateMath.GetJobRevenue(SelectedJob)) variance to sale contract.</p>
                                </article>
                                <article class="summary-card">
                                    <p class="eyebrow">Billed To Date</p>
                                    <h3>@EstimateMath.GetCurrency(EstimateMath.GetJobBilledRevenue(SelectedJob))</h3>
                                    <p>@EstimateMath.GetCurrency(EstimateMath.GetJobCollectedRevenue(SelectedJob)) paid to date.</p>
                                </article>
                                <article class="summary-card">
                                    <p class="eyebrow">Remaining To Bill</p>
                                    <h3>@EstimateMath.GetCurrency(scheduleValueItems.Sum(item => item.RemainingToBill))</h3>
                                    <p>Bid sale references stay visible beside each line's total value.</p>
                                </article>
                            </div>

                            <div class="field-card-list">
                                @foreach (var item in scheduleValueItems)
                                {
                                    var isExpanded = IsScheduleValueExpanded(item.Id);
                                    var isApprovedChangeOrder = IsScheduleValueChangeOrderApproved(item);

                                    <article id="@GetScheduleValueElementId(item.Id)" class="field-card @(isExpanded ? "field-card-expanded" : "field-card-collapsed") page-section-anchor" style="@(item.IsChangeOrderLine && !isApprovedChangeOrder ? "opacity: 0.68;" : null)" @key="item.Id">
                                        <div class="field-card-summary-row">
                                            <button class="field-card-summary-button" type="button" @onclick="() => ToggleScheduleValueExpanded(item.Id)">
                                                <strong>@item.Description</strong>
                                                <span>@JobCostCodes.GetLabel(item.CategoryCode)</span>
                                                @if (!item.IsChangeOrderLine)
                                                {
                                                    <span>Bid Sale Ref @EstimateMath.GetCurrency(item.ReferenceValue)</span>
                                                }
                                                <span>Total Value @EstimateMath.GetCurrency(item.ScheduledValue)</span>
                                                <span>% Of Contract @EstimateMath.GetPercent(item.PercentageOfTotal / 100m)</span>
                                                <span>Billed @EstimateMath.GetCurrency(item.BilledToDate)</span>
                                                <span>Paid @EstimateMath.GetCurrency(item.PaidToDate)</span>
                                                <span>Linked Commit % @EstimateMath.GetPercent(GetLinkedCommitmentPaidPercent(item) / 100m)</span>
                                            </button>
                                            <div class="field-card-summary-actions">
                                                <span class="pill">
                                                    @(item.IsChangeOrderLine
                                                        ? (isApprovedChangeOrder ? "Approved" : "Unapproved")
                                                        : (isExpanded ? "Expanded" : "Collapsed"))
                                                </span>
                                                @if (!item.IsChangeOrderLine)
                                                {
                                                    <button class="text-button danger" type="button" @onclick="() => RemoveScheduleValue(item.Id)">Remove</button>
                                                }
                                            </div>
                                        </div>

                                        @if (isExpanded)
                                        {
                                            <table class="data-table compact-table sov-line-editor-table">
                                                <thead>
                                                    <tr>
                                                        <th>Line</th>
                                                        <th>Category</th>
                                                        <th>@(item.IsChangeOrderLine ? "Status" : "Bid Sale Ref")</th>
                                                        <th>Total Value</th>
                                                        <th>% Of Contract</th>
                                                        <th>Billed</th>
                                                        <th>Paid</th>
                                                        <th>% Of SOV Paid</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr>
                                                        <td><input @bind="item.Description" disabled="@item.IsChangeOrderLine" /></td>
                                                        <td>
                                                            <select @bind="item.CategoryCode" disabled="@item.IsChangeOrderLine" @bind:after="@(() => OnScheduleValueCategoryChanged(item))">
                                                                @foreach (var categoryCode in JobCostCodes.ScheduleValueCodes)
                                                                {
                                                                    <option value="@categoryCode">@JobCostCodes.GetLabel(categoryCode)</option>
                                                                }
                                                            </select>
                                                        </td>
                                                        <td>
                                                            <span class="compact-readonly-value">@(item.IsChangeOrderLine ? (isApprovedChangeOrder ? "Approved" : "Unapproved") : EstimateMath.GetCurrency(item.ReferenceValue))</span>
                                                        </td>
                                                        <td>
                                                            <span class="compact-readonly-value">@EstimateMath.GetCurrency(item.ScheduledValue)</span>
                                                        </td>
                                                        <td>
                                                            <span class="compact-readonly-value">@EstimateMath.GetPercent(item.PercentageOfTotal / 100m)</span>
                                                        </td>
                                                        <td>
                                                            <span class="compact-readonly-value">@EstimateMath.GetCurrency(item.BilledToDate)</span>
                                                        </td>
                                                        <td>
                                                            <span class="compact-readonly-value">@EstimateMath.GetCurrency(item.PaidToDate)</span>
                                                        </td>
                                                        <td>
                                                            <span class="compact-readonly-value">@EstimateMath.GetPercent(JobFinancialMath.GetScheduleValuePaidPercent(item) / 100m)</span>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>

                                            <label class="full-width">
                                                <span>Notes</span>
                                                <textarea class="notes-field notes-field-compact" rows="1" @bind="item.Notes"></textarea>
                                            </label>

                                            <div class="sov-subline-panel">
                                                <div class="panel-header minor">
                                                    <div>
                                                        <p class="eyebrow">Progress Entries</p>
                                                        <h4>@item.Description</h4>
                                                    </div>
                                                </div>

                                                @if (item.SubLines.Count == 0)
                                                {
                                                    <p class="muted">Add progress entries here to track multiple billings and payments against this SOV line.</p>
                                                }
                                                else
                                                {
                                                    <table class="data-table compact-table">
                                                        <thead>
                                                            <tr>
                                                                <th>Description</th>
                                                                <th>Linked Commitment</th>
                                                                <th>Line Value</th>
                                                                <th>Billed</th>
                                                                <th>Paid</th>
                                                                <th>% Of Line</th>
                                                                <th>Notes</th>
                                                                <th></th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var subLine in item.SubLines)
                                                            {
                                                                <tr id="@GetScheduleValueSubLineElementId(item.Id, subLine.Id)" class="page-section-anchor" @key="subLine.Id">
                                                                    <td><input @bind="subLine.Description" @bind:after="@SyncJobFinancials" /></td>
                                                                    <td><span>@GetScheduleValueSubLineLinkLabel(subLine)</span></td>
                                                                    <td><input type="number" step="0.01" value="@GetCurrencyInputValue(subLine.LineValue)" @oninput="args => OnScheduleValueSubLineLineValueChanged(item, subLine, args)" /></td>
                                                                    <td><input type="number" step="0.01" @bind="subLine.BilledAmount" @bind:event="oninput" @bind:after="@SyncJobFinancials" /></td>
                                                                    <td><input type="number" step="0.01" @bind="subLine.PaidAmount" @bind:event="oninput" @bind:after="@SyncJobFinancials" /></td>
                                                                    <td>@EstimateMath.GetPercent(GetScheduleValueSubLinePaidPercent(subLine) / 100m)</td>
                                                                    <td><textarea class="notes-field notes-field-compact" rows="1" @bind="subLine.Notes"></textarea></td>
                                                                    <td>
                                                                        @if (subLine.IsAutoGenerated)
                                                                        {
                                                                            <span class="muted small">Auto</span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <button class="text-button danger" type="button" @onclick="() => RemoveScheduleValueSubLine(item, subLine.Id)">Remove</button>
                                                                        }
                                                                    </td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                }

                                                <div class="section-add-action">
                                                    <button class="button button-secondary" type="button" @onclick="() => AddScheduleValueSubLine(item)">Add Subline</button>
                                                </div>
                                            </div>
                                        }
                                    </article>
                                }
                            </div>

                            <table class="data-table compact-table">
                                <thead>
                                    <tr>
                                        <th>Total Type</th>
                                        <th>Bid Sale Ref</th>
                                        <th>Total Value</th>
                                        <th>% Of Contract</th>
                                        <th>Billed</th>
                                        <th>Paid</th>
                                        <th>% Of SOV Paid</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr class="sov-total-row">
                                        <td><strong>Totals</strong></td>
                                        <td>@EstimateMath.GetCurrency(GetScheduleValueReferenceTotal(scheduleValueItems))</td>
                                        <td>@EstimateMath.GetCurrency(scheduleValueItems.Sum(item => item.ScheduledValue))</td>
                                        <td><span style="@GetScheduleValuePercentTotalStyle(scheduleValueItems)">@EstimateMath.GetPercent(GetScheduleValuePercentTotal(scheduleValueItems) / 100m)</span></td>
                                        <td>@EstimateMath.GetCurrency(GetScheduleValueBilledTotal(scheduleValueItems))</td>
                                        <td>@EstimateMath.GetCurrency(GetScheduleValuePaidTotal(scheduleValueItems))</td>
                                        <td>@EstimateMath.GetPercent(GetScheduleValuePaidPercentTotal(scheduleValueItems) / 100m)</td>
                                    </tr>
                                </tbody>
                            </table>
                        }
                    }

                    @if (IsSectionExpanded(ScheduleOfValuesSectionId))
                    {
                        <div class="section-add-action">
                            <button class="button button-secondary" type="button" @onclick="AddScheduleValue">Add Line</button>
                        </div>
                    }
                </section>

                <section id="@TimeEntriesElementId" class="panel jobs-section jobs-section-labor page-section-anchor @(IsSectionExpanded(TimeEntriesSectionId) ? "panel-expanded" : null)">
                    <div class="panel-header">
                        <div>
                            <p class="eyebrow">Actual labor</p>
                            <h3>Daily Logs</h3>
                        </div>
                        <div class="panel-header-actions">
                            <button class="button button-secondary" type="button" @onclick="ToggleDailyLogSortOrder">@(IsDailyLogsNewestFirst ? "Newest First" : "Oldest First")</button>
                            <button class="button button-secondary" type="button" @onclick='() => ToggleSection(TimeEntriesSectionId)'>@(IsSectionExpanded(TimeEntriesSectionId) ? "Collapse" : "Expand")</button>
                        </div>
                    </div>

                    <div class="stats-inline">
                        <span>Daily Logs @dailyLogItems.Count</span>
                        <span>Time Logs @SelectedJob.TimeEntries.Count</span>
                        <span>Total Hours @EstimateMath.GetHours(EstimateMath.GetJobActualLaborHours(SelectedJob))</span>
                        <span>Total Cost @EstimateMath.GetCurrency(EstimateMath.GetJobActualLaborCost(SelectedJob))</span>
                        <span>Base Remaining @EstimateMath.GetHours(GetRemainingHoursTotal(BaselinePhaseCodes))</span>
                        <span>CO Remaining @EstimateMath.GetHours(GetAllChangeOrderRemainingLaborHoursTotal())</span>
                        <span>Saved Personnel @personnelNameSuggestions.Count</span>
                    </div>

                    @if (IsSectionExpanded(TimeEntriesSectionId))
                    {
                        <div class="section-totals-grid">
                            <article class="summary-card section-totals-card">
                                <p class="eyebrow">Hours By Scope</p>
                                <table class="data-table compact-table">
                                    <thead>
                                        <tr>
                                            <th>Scope</th>
                                            <th>Planned</th>
                                            <th>Used</th>
                                            <th>Remaining</th>
                                            <th>Actual Cost</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var scopeSummary in laborScopeSummaries)
                                        {
                                            <tr>
                                                <td>@scopeSummary.Scope</td>
                                                <td>@EstimateMath.GetHours(scopeSummary.PlannedHours)</td>
                                                <td>@EstimateMath.GetHours(scopeSummary.UsedHours)</td>
                                                <td><span style="@GetRemainingHoursStyle(scopeSummary.RemainingHours)">@EstimateMath.GetHours(scopeSummary.RemainingHours)</span></td>
                                                <td>@EstimateMath.GetCurrency(scopeSummary.ActualCost)</td>
                                            </tr>
                                        }
                                        <tr class="sov-total-row">
                                            <td><strong>All Labor Totals</strong></td>
                                            <td>@EstimateMath.GetHours(GetAllTrackedLaborPlannedHours())</td>
                                            <td>@EstimateMath.GetHours(EstimateMath.GetJobActualLaborHours(SelectedJob))</td>
                                            <td><span style="@GetRemainingHoursStyle(GetAllTrackedLaborRemainingHours())">@EstimateMath.GetHours(GetAllTrackedLaborRemainingHours())</span></td>
                                            <td>@EstimateMath.GetCurrency(EstimateMath.GetJobActualLaborCost(SelectedJob))</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </article>

                            <article class="summary-card section-totals-card">
                                <p class="eyebrow">Crew Hours</p>
                                @if (personnelHourSummaries.Count == 0)
                                {
                                    <p class="muted">Enter a crew name once and it will show back up as a suggestion on future daily logs.</p>
                                }
                                else
                                {
                                    <table class="data-table compact-table">
                                        <thead>
                                            <tr>
                                                <th>Name</th>
                                                <th>Hours</th>
                                                <th>Cost</th>
                                                <th>Daily Logs</th>
                                                <th>Entries</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var crewSummary in personnelHourSummaries)
                                            {
                                                <tr>
                                                    <td>@crewSummary.Name</td>
                                                    <td>@EstimateMath.GetHours(crewSummary.Hours)</td>
                                                    <td>@EstimateMath.GetCurrency(crewSummary.Cost)</td>
                                                    <td>@crewSummary.DailyLogs</td>
                                                    <td>@crewSummary.Entries</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                            </article>
                        </div>

                        @if (dailyLogItems.Count == 0)
                        {
                            <p class="muted">Track labor by day so each date carries its own report, pictures, and crew time logs.</p>
                        }
                        else
                        {
                            <div class="field-card-list">
                                @foreach (var dailyLog in dailyLogItems)
                                {
                                    var isExpanded = IsDailyLogExpanded(dailyLog.Id);
                                    var dailyEntries = GetDailyLogEntries(dailyLog).ToList();

                                    <article id="@GetDailyLogElementId(dailyLog.Id)" class="field-card daily-log-card @(isExpanded ? "field-card-expanded" : "field-card-collapsed") page-section-anchor" @key="dailyLog.Id">
                                        <div class="field-card-summary-row">
                                            <button class="field-card-summary-button" type="button" @onclick="() => ToggleDailyLogExpanded(dailyLog.Id)">
                                                <strong>@GetDailyLogDateLabel(dailyLog)</strong>
                                                <span>@GetDailyLogDescription(dailyLog)</span>
                                            </button>
                                            <div class="field-card-summary-actions">
                                                <span class="pill">@dailyEntries.Count Log@(dailyEntries.Count == 1 ? string.Empty : "s")</span>
                                                <button class="text-button danger" type="button" @onclick="() => RemoveDailyLog(dailyLog.Id)">Remove</button>
                                            </div>
                                        </div>

                                        @if (isExpanded)
                                        {
                                            <div class="field-card-grid daily-log-header-grid">
                                                <label>
                                                    <span>Date</span>
                                                    <input type="date" @bind="dailyLog.WorkDate" @bind:format="yyyy-MM-dd" @bind:after="@(() => OnDailyLogDateChanged(dailyLog))" />
                                                </label>
                                                <label class="daily-log-description-field">
                                                    <span>Description</span>
                                                    <input @bind="dailyLog.Description" @bind:after="@(() => OnDailyLogDateChanged(dailyLog))" />
                                                </label>
                                                <div class="list-stack compact daily-log-summary-stack">
                                                    <span class="muted small">Hours @EstimateMath.GetHours(GetDailyLogHours(dailyLog))</span>
                                                    <span class="muted small">Cost @EstimateMath.GetCurrency(GetDailyLogCost(dailyLog))</span>
                                                </div>
                                            </div>

                                            @if (dailyEntries.Count == 0)
                                            {
                                                <p class="muted">Use Log Time to add technician entries under this date.</p>
                                            }
                                            else
                                            {
                                                <table class="data-table wide">
                                                    <thead>
                                                        <tr>
                                                            <th>Name</th>
                                                            <th>Class</th>
                                                            <th>Phase</th>
                                                            <th>Scope</th>
                                                            <th>Hours</th>
                                                            <th>Hours Remaining</th>
                                                            <th>Cost Rate</th>
                                                            <th>Overnight</th>
                                                            <th>Notes</th>
                                                            <th></th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var entry in dailyEntries)
                                                        {
                                                            <tr id="@GetDailyLogTimeEntryElementId(dailyLog.Id, entry.Id)" class="page-section-anchor" @key="entry.Id">
                                                                <td><input list="@PersonnelNameSuggestionsListId" @bind="entry.CrewMember" @bind:after="@(() => OnTimeEntryCrewMemberChanged(entry))" /></td>
                                                                <td>
                                                                    <select @bind="entry.LaborClass" @bind:after="@(() => OnTimeEntryLaborTypeChanged(entry))">
                                                                        @foreach (var laborClass in TimeEntryLaborClasses)
                                                                        {
                                                                            <option value="@laborClass">@GetTimeEntryLaborLabel(laborClass)</option>
                                                                        }
                                                                    </select>
                                                                </td>
                                                                <td>
                                                                    <select @bind="entry.CostCode" @bind:after="@(() => OnTimeEntryCostCodeChanged(entry))">
                                                                        @foreach (var costCode in JobCostCodes.TimeEntryCodes)
                                                                        {
                                                                            <option value="@costCode">@JobCostCodes.GetLabel(costCode)</option>
                                                                        }
                                                                    </select>
                                                                </td>
                                                                <td>
                                                                    <select value="@GetTimeEntryScopeValue(entry)" @onchange="args => OnTimeEntryScopeChanged(entry, args)">
                                                                        <option value="@BaseContractScopeValue">Base Contract</option>
                                                                        @foreach (var changeOrder in changeOrderItems)
                                                                        {
                                                                            <option value="@changeOrder.Id">@GetChangeOrderLabel(changeOrder)</option>
                                                                        }
                                                                    </select>
                                                                </td>
                                                                <td><input type="number" step="0.25" value="@GetTimeEntryHoursInputValue(entry)" @oninput="args => OnTimeEntryHoursChanged(entry, args)" /></td>
                                                                <td><span style="@GetTimeEntryRemainingHoursStyle(entry)">@GetTimeEntryRemainingHoursDisplay(entry)</span></td>
                                                                <td><input type="number" step="0.01" @bind="entry.HourlyRate" @bind:event="oninput" @bind:after="@(() => NormalizeTimeEntry(entry))" /></td>
                                                                <td><input type="checkbox" @bind="entry.IsOvernight" @bind:after="@(() => OnTimeEntryOvernightChanged(entry))" disabled="@IsTimeEntryOvernightLocked(entry)" /></td>
                                                                <td><textarea class="notes-field notes-field-compact" rows="1" @bind="entry.Notes"></textarea></td>
                                                                <td><button class="text-button danger" type="button" @onclick="() => RemoveTimeEntry(entry.Id)">Remove</button></td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            }

                                            <div class="section-add-action">
                                                <button class="button button-secondary" type="button" @onclick="() => AddDailyLogTimeEntry(dailyLog)">Log Time</button>
                                            </div>

                                            <AttachmentManager Attachments="dailyLog.Attachments" Area="@GetDailyLogAttachmentArea(dailyLog.Id)" OwnerId="dailyLog.Id" />
                                        }
                                    </article>
                                }
                            </div>
                        }

                        <div class="section-add-action">
                            <button class="button button-secondary" type="button" @onclick="AddDailyLog">Add Daily</button>
                        </div>
                    }
                </section>

                <section id="@BidDevicesElementId" class="panel jobs-section jobs-section-base-scope page-section-anchor @(IsSectionExpanded(BidDevicesSectionId) ? "panel-expanded" : null)">
                    <div class="panel-header">
                        <div>
                            <p class="eyebrow">Original estimate detail</p>
                            <h3>Bid Devices</h3>
                        </div>
                        <button class="button button-secondary" type="button" @onclick='() => ToggleSection(BidDevicesSectionId)'>@(IsSectionExpanded(BidDevicesSectionId) ? "Collapse" : "Expand")</button>
                    </div>

                    @if (bidDeviceItems.Count == 0)
                    {
                        <p class="muted">Convert a bid or keep building this job to populate the original bid device list.</p>
                    }
                    else
                    {
                        <div class="stats-inline">
                            <span>Spec Qty @GetBidDeviceQuantityTotal(bidDeviceTotalItems)</span>
                            <span>Actual Qty @GetBidDeviceActualQuantityTotal(bidDeviceTotalItems)</span>
                            <span>Est. Cost @EstimateMath.GetCurrency(GetBidDeviceEstimatedCostTotal(bidDeviceTotalItems))</span>
                            <span>Est. Sale @EstimateMath.GetCurrency(GetBidDeviceEstimatedSaleTotal(bidDeviceTotalItems))</span>
                            <span>Actual Cost @EstimateMath.GetCurrency(GetBidDeviceActualCostTotal(bidDeviceTotalItems))</span>
                            <span>Cost Variance @EstimateMath.GetCurrency(GetBidDeviceCostVarianceTotal(bidDeviceTotalItems))</span>
                            <span>Sale Variance @EstimateMath.GetCurrency(GetBidDeviceSaleVarianceTotal(bidDeviceTotalItems))</span>
                        </div>

                        @if (IsSectionExpanded(BidDevicesSectionId))
                        {
                            <table class="data-table wide">
                                <thead>
                                    <tr>
                                        <th>Type</th>
                                        <th>Description</th>
                                        <th>Qty</th>
                                        <th>Actual Qty</th>
                                        <th>Unit</th>
                                        <th>Hours</th>
                                        <th>Est. Unit Cost</th>
                                        <th>Est. Sale</th>
                                        <th>Actual Unit Cost</th>
                                        <th>Invoice Ref</th>
                                        <th>Notes</th>
                                        <th>Actual Detail</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in bidDeviceItems)
                                    {
                                        <tr @key="item.Id">
                                            <td>@GetBidDeviceTypeLabel(item)</td>
                                            <td>@item.Description</td>
                                            <td>@item.Quantity</td>
                                            <td>
                                                @if (HasBidDeviceActualPurchaseLines(item))
                                                {
                                                    <input type="number" step="0.01" value="@GetBidDeviceActualQuantityInputValue(item)" disabled />
                                                }
                                                else
                                                {
                                                    <input type="number" step="0.01" value="@GetBidDeviceActualQuantityInputValue(item)" @oninput="args => OnBidDeviceActualQuantityChanged(item, args)" />
                                                }
                                            </td>
                                            <td>@item.UnitLabel</td>
                                            <td>@EstimateMath.GetHours(item.EstimatedHours)</td>
                                            <td>@EstimateMath.GetCurrency(item.EstimatedUnitCost)</td>
                                            <td>@EstimateMath.GetCurrency(item.EstimatedUnitSale)</td>
                                            <td>
                                                @if (HasBidDeviceActualPurchaseLines(item))
                                                {
                                                    <input type="number" step="0.01" value="@GetBidDeviceActualUnitCostInputValue(item)" disabled />
                                                }
                                                else
                                                {
                                                    <input type="number" step="0.01" value="@item.ActualUnitCost" @oninput="args => OnBidDeviceActualCostChanged(item, args)" />
                                                }
                                            </td>
                                            <td>
                                                @if (HasBidDeviceActualPurchaseLines(item))
                                                {
                                                    <span class="muted">Tracked on purchase rows</span>
                                                }
                                                else
                                                {
                                                    <select value="@(item.InvoiceId?.ToString() ?? string.Empty)" @onchange="args => OnBidDeviceInvoiceChanged(item, args)">
                                                        <option value="">Not linked</option>
                                                        @foreach (var invoice in invoiceItems)
                                                        {
                                                            <option value="@invoice.Id">@GetInvoiceLabel(invoice)</option>
                                                        }
                                                    </select>
                                                }
                                            </td>
                                            <td><textarea class="notes-field notes-field-compact" rows="1" @bind="item.Notes"></textarea></td>
                                            <td><button class="button button-secondary" type="button" @onclick="() => AddBidDeviceActualPurchaseLine(item)">Add Purchase</button></td>
                                        </tr>

                                        @if (item.ActualPurchaseLines.Count > 0)
                                        {
                                            @foreach (var purchaseLine in item.ActualPurchaseLines)
                                            {
                                                <tr class="bid-device-actual-purchase-row" @key="purchaseLine.Id">
                                                    <td>Purchase</td>
                                                    <td><input @bind="purchaseLine.Description" @bind:after="@(() => NormalizeBidDeviceActualPurchaseLine(item, purchaseLine))" /></td>
                                                    <td></td>
                                                    <td><input type="number" step="0.01" value="@purchaseLine.Quantity" @oninput="args => OnBidDeviceActualPurchaseQuantityChanged(purchaseLine, args)" /></td>
                                                    <td><input @bind="purchaseLine.UnitLabel" @bind:after="@(() => NormalizeBidDeviceActualPurchaseLine(item, purchaseLine))" /></td>
                                                    <td></td>
                                                    <td></td>
                                                    <td></td>
                                                    <td><input type="number" step="0.01" value="@purchaseLine.ActualUnitCost" @oninput="args => OnBidDeviceActualPurchaseCostChanged(purchaseLine, args)" /></td>
                                                    <td>
                                                        <select value="@(purchaseLine.InvoiceId?.ToString() ?? string.Empty)" @onchange="args => OnBidDeviceActualPurchaseInvoiceChanged(purchaseLine, args)">
                                                            <option value="">Not linked</option>
                                                            @foreach (var invoice in invoiceItems)
                                                            {
                                                                <option value="@invoice.Id">@GetInvoiceLabel(invoice)</option>
                                                            }
                                                        </select>
                                                    </td>
                                                    <td><textarea class="notes-field notes-field-compact" rows="1" @bind="purchaseLine.Notes"></textarea></td>
                                                    <td><button class="text-button danger" type="button" @onclick="() => RemoveBidDeviceActualPurchaseLine(item, purchaseLine.Id)">Remove</button></td>
                                                </tr>
                                            }

                                            <tr class="change-order-line-totals">
                                                <td colspan="12">
                                                    <div class="stats-inline">
                                                        <span>Rolled Qty @GetBidDeviceActualQuantityInputValue(item)</span>
                                                        <span>Weighted Unit Cost @EstimateMath.GetCurrency(item.EffectiveActualUnitCost)</span>
                                                        <span>Actual Cost Total @EstimateMath.GetCurrency(item.ActualCost)</span>
                                                    </div>
                                                </td>
                                            </tr>
                                        }

                                        @if (officeBidDeviceItems.LastOrDefault()?.Id == item.Id)
                                        {
                                            <tr class="sov-total-row">
                                                <td colspan="2"><p class="eyebrow">Admin / Eng Total</p></td>
                                                <td><span class="compact-total-value">@GetBidDeviceQuantityTotal(officeBidDeviceItems)</span></td>
                                                <td><span class="compact-total-value">@GetBidDeviceActualQuantityTotal(officeBidDeviceItems)</span></td>
                                                <td></td>
                                                <td><span class="compact-total-value">@EstimateMath.GetHours(GetBidDeviceHoursTotal(officeBidDeviceItems))</span></td>
                                                <td><span class="compact-total-value">@EstimateMath.GetCurrency(GetBidDeviceEstimatedCostTotal(officeBidDeviceItems))</span></td>
                                                <td><span class="compact-total-value">@EstimateMath.GetCurrency(GetBidDeviceEstimatedSaleTotal(officeBidDeviceItems))</span></td>
                                                <td><span class="compact-total-value">@EstimateMath.GetCurrency(GetBidDeviceActualCostTotal(officeBidDeviceItems))</span></td>
                                                <td></td>
                                                <td></td>
                                                <td></td>
                                            </tr>
                                        }

                                        @if (componentBidDeviceItems.LastOrDefault()?.Id == item.Id)
                                        {
                                            <tr class="sov-total-row">
                                                <td colspan="2"><p class="eyebrow">Component Total</p></td>
                                                <td><span class="compact-total-value">@GetBidDeviceQuantityTotal(componentBidDeviceItems)</span></td>
                                                <td><span class="compact-total-value">@GetBidDeviceActualQuantityTotal(componentBidDeviceItems)</span></td>
                                                <td></td>
                                                <td><span class="compact-total-value">@EstimateMath.GetHours(GetBidDeviceHoursTotal(componentBidDeviceItems))</span></td>
                                                <td><span class="compact-total-value">@EstimateMath.GetCurrency(GetBidDeviceEstimatedCostTotal(componentBidDeviceItems))</span></td>
                                                <td><span class="compact-total-value">@EstimateMath.GetCurrency(GetBidDeviceEstimatedSaleTotal(componentBidDeviceItems))</span></td>
                                                <td><span class="compact-total-value">@EstimateMath.GetCurrency(GetBidDeviceActualCostTotal(componentBidDeviceItems))</span></td>
                                                <td></td>
                                                <td></td>
                                                <td></td>
                                            </tr>
                                        }

                                        @if (wireBidDeviceItems.LastOrDefault()?.Id == item.Id)
                                        {
                                            <tr class="sov-total-row">
                                                <td colspan="2"><p class="eyebrow">Wire Total</p></td>
                                                <td><span class="compact-total-value">@GetBidDeviceQuantityTotal(wireBidDeviceItems)</span></td>
                                                <td><span class="compact-total-value">@GetBidDeviceActualQuantityTotal(wireBidDeviceItems)</span></td>
                                                <td></td>
                                                <td><span class="compact-total-value">@EstimateMath.GetHours(GetBidDeviceHoursTotal(wireBidDeviceItems))</span></td>
                                                <td><span class="compact-total-value">@EstimateMath.GetCurrency(GetBidDeviceEstimatedCostTotal(wireBidDeviceItems))</span></td>
                                                <td><span class="compact-total-value">@EstimateMath.GetCurrency(GetBidDeviceEstimatedSaleTotal(wireBidDeviceItems))</span></td>
                                                <td><span class="compact-total-value">@EstimateMath.GetCurrency(GetBidDeviceActualCostTotal(wireBidDeviceItems))</span></td>
                                                <td></td>
                                                <td></td>
                                                <td></td>
                                            </tr>
                                        }

                                        @if (materialBidDeviceItems.LastOrDefault()?.Id == item.Id)
                                        {
                                            <tr class="sov-total-row">
                                                <td colspan="2"><p class="eyebrow">Material Total</p></td>
                                                <td><span class="compact-total-value">@GetBidDeviceQuantityTotal(materialBidDeviceItems)</span></td>
                                                <td><span class="compact-total-value">@GetBidDeviceActualQuantityTotal(materialBidDeviceItems)</span></td>
                                                <td></td>
                                                <td><span class="compact-total-value">@EstimateMath.GetHours(GetBidDeviceHoursTotal(materialBidDeviceItems))</span></td>
                                                <td><span class="compact-total-value">@EstimateMath.GetCurrency(GetBidDeviceEstimatedCostTotal(materialBidDeviceItems))</span></td>
                                                <td><span class="compact-total-value">@EstimateMath.GetCurrency(GetBidDeviceEstimatedSaleTotal(materialBidDeviceItems))</span></td>
                                                <td><span class="compact-total-value">@EstimateMath.GetCurrency(GetBidDeviceActualCostTotal(materialBidDeviceItems))</span></td>
                                                <td></td>
                                                <td></td>
                                                <td></td>
                                            </tr>
                                        }
                                    }

                                    @if (bidDeviceTotalItems.Count > 0)
                                    {
                                        <tr class="sov-total-row">
                                            <td colspan="2"><strong>All Bid Device Totals</strong></td>
                                            <td>@GetBidDeviceQuantityTotal(bidDeviceTotalItems)</td>
                                            <td>@GetBidDeviceActualQuantityTotal(bidDeviceTotalItems)</td>
                                            <td></td>
                                            <td>@EstimateMath.GetHours(GetBidDeviceHoursTotal(bidDeviceTotalItems))</td>
                                            <td>@EstimateMath.GetCurrency(GetBidDeviceEstimatedCostTotal(bidDeviceTotalItems))</td>
                                            <td>@EstimateMath.GetCurrency(GetBidDeviceEstimatedSaleTotal(bidDeviceTotalItems))</td>
                                            <td>@EstimateMath.GetCurrency(GetBidDeviceActualCostTotal(bidDeviceTotalItems))</td>
                                            <td></td>
                                            <td></td>
                                            <td></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    }
                </section>

                <section id="@JobDevicesElementId" class="panel jobs-section jobs-section-job-scope page-section-anchor @(IsSectionExpanded(JobDevicesSectionId) ? "panel-expanded" : null)">
                    <div class="panel-header">
                        <div>
                            <p class="eyebrow">Added scope tracking</p>
                            <h3>Job Devices</h3>
                        </div>
                        <div class="panel-header-actions">
                            <button class="button button-secondary" type="button" @onclick='() => ToggleSection(JobDevicesSectionId)'>@(IsSectionExpanded(JobDevicesSectionId) ? "Collapse" : "Expand")</button>
                        </div>
                    </div>

                    @if (jobDeviceItems.Count == 0)
                    {
                        <p class="muted">Add devices, material, or other cost items that were not part of the original bid.</p>
                    }
                    else
                    {
                        <div class="stats-inline">
                            <span>Estimated @EstimateMath.GetCurrency(jobDeviceItems.Sum(item => item.EstimatedCost))</span>
                            <span>Est. Sale @EstimateMath.GetCurrency(jobDeviceItems.Sum(item => item.EstimatedSale))</span>
                            <span>Actual @EstimateMath.GetCurrency(jobDeviceItems.Sum(item => item.ActualCost))</span>
                            <span>Variance @EstimateMath.GetCurrency(jobDeviceItems.Sum(item => item.ActualCost - item.EstimatedCost))</span>
                        </div>

                        @if (IsSectionExpanded(JobDevicesSectionId))
                        {
                            <div class="inline-select-row jobs-scope-sort-row">
                                <span class="eyebrow">Sort Job Scope</span>
                                <select @bind="SelectedJobDeviceSortMode">
                                    <option value="@JobDeviceListSortMode.Manual">Manual Entry Order</option>
                                    <option value="@JobDeviceListSortMode.Type">Type</option>
                                    <option value="@JobDeviceListSortMode.Description">Description</option>
                                    <option value="@JobDeviceListSortMode.Reference">Invoice Ref</option>
                                    <option value="@JobDeviceListSortMode.ActualCostLowToHigh">Actual Cost Low to High</option>
                                </select>
                            </div>
                            @if (SelectedJobDeviceSortMode == JobDeviceListSortMode.Manual)
                            {
                                <p class="muted small">New items stay at the bottom until you sort the list.</p>
                            }

                            <table class="data-table wide">
                                <thead>
                                    <tr>
                                        <th>Type</th>
                                        <th>Description</th>
                                        <th>Qty</th>
                                        <th>Unit</th>
                                        <th>Est. Unit Cost</th>
                                        <th>Est. Sale</th>
                                        <th>Actual Unit Cost</th>
                                        <th>Invoice Ref</th>
                                        <th>Notes</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in jobDeviceItems)
                                    {
                                        <tr id="@GetJobDeviceElementId(item.Id)" class="page-section-anchor" @key="item.Id">
                                            <td>
                                                <select @bind="item.CategoryCode" @bind:after="@(() => NormalizeJobDevice(item))">
                                                    <option value="@JobCostCodes.Components">Component</option>
                                                    <option value="@JobCostCodes.Wire">Wire</option>
                                                    <option value="@JobCostCodes.Material">Material</option>
                                                    <option value="@JobCostCodes.Other">Other</option>
                                                </select>
                                            </td>
                                            <td><input @bind="item.Description" /></td>
                                            <td><input type="number" step="0.01" @bind="item.Quantity" @bind:event="oninput" @bind:after="@(() => NormalizeJobDevice(item))" /></td>
                                            <td><input @bind="item.UnitLabel" @bind:after="@(() => NormalizeJobDevice(item))" /></td>
                                            <td><input type="number" step="0.01" value="@item.EstimatedUnitCost" @oninput="args => OnJobDeviceEstimatedCostChanged(item, args)" /></td>
                                            <td><input type="number" step="0.01" value="@item.EstimatedUnitSale" @oninput="args => OnJobDeviceEstimatedSaleChanged(item, args)" /></td>
                                            <td><input type="number" step="0.01" value="@item.ActualUnitCost" @oninput="args => OnJobDeviceActualCostChanged(item, args)" /></td>
                                            <td>
                                                <select value="@(item.InvoiceId?.ToString() ?? string.Empty)" @onchange="args => OnJobDeviceInvoiceChanged(item, args)">
                                                    <option value="">Not linked</option>
                                                    @foreach (var invoice in invoiceItems)
                                                    {
                                                        <option value="@invoice.Id">@GetInvoiceLabel(invoice)</option>
                                                    }
                                                </select>
                                            </td>
                                            <td><textarea class="notes-field notes-field-compact" rows="1" @bind="item.Notes"></textarea></td>
                                            <td><button class="text-button danger" type="button" @onclick="() => RemoveJobDevice(item.Id)">Remove</button></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    }

                    @if (IsSectionExpanded(JobDevicesSectionId))
                    {
                        <div class="section-add-action">
                            <button class="button button-secondary" type="button" @onclick="AddJobDevice">Add Device</button>
                        </div>
                    }
                </section>

                <section id="@InvoicesElementId" class="panel jobs-section jobs-section-invoices page-section-anchor @(IsSectionExpanded(InvoicesSectionId) ? "panel-expanded" : null)">
                    <div class="panel-header">
                        <div>
                            <p class="eyebrow">Invoice tracking</p>
                            <h3>Invoices</h3>
                        </div>
                        <div class="panel-header-actions">
                            <button class="button button-secondary" type="button" @onclick='() => ToggleSection(InvoicesSectionId)'>@(IsSectionExpanded(InvoicesSectionId) ? "Collapse" : "Expand")</button>
                        </div>
                    </div>

                    <div class="section-link-row">
                        <button class="pill pill-button" type="button" @onclick='() => NavigateToJobSectionAsync(BidDevicesSectionId)'>To Base Scope</button>
                        <button class="pill pill-button" type="button" @onclick='() => NavigateToJobSectionAsync(JobDevicesSectionId)'>To Job Scope</button>
                        <button class="pill pill-button" type="button" @onclick='() => NavigateToJobSectionAsync(ChangeOrdersSectionId)'>To COs</button>
                    </div>

                    @if (invoiceItems.Count == 0)
                    {
                        <p class="muted">Create invoice references here, then assign bid devices and job devices to them for actual cost tracking.</p>
                    }
                    else
                    {
                        <div class="stats-inline">
                            <span>Invoice Total @EstimateMath.GetCurrency(invoiceItems.Sum(item => item.InvoiceTotal))</span>
                            <span>Linked Items @EstimateMath.GetCurrency(invoiceItems.Sum(item => JobFinancialMath.GetInvoiceLinkedActualCost(SelectedJob, item.Id)))</span>
                            <span>Tax / Remainder @EstimateMath.GetCurrency(JobFinancialMath.GetInvoiceAutoRemainderTotal(SelectedJob))</span>
                        </div>

                        @if (IsSectionExpanded(InvoicesSectionId))
                        {
                            <div class="field-card-list">
                                @foreach (var invoice in invoiceItems)
                                {
                                    var isExpanded = IsInvoiceExpanded(invoice.Id);

                                    <article id="@GetInvoiceElementId(invoice.Id)" class="field-card @(isExpanded ? "field-card-expanded" : "field-card-collapsed") page-section-anchor" @key="invoice.Id">
                                        <div class="field-card-summary-row">
                                            <button class="field-card-summary-button" type="button" @onclick="() => ToggleInvoiceExpanded(invoice.Id)">
                                                <strong>@GetInvoiceLabel(invoice)</strong>
                                                <span>Total @EstimateMath.GetCurrency(invoice.InvoiceTotal)</span>
                                                <span>Linked @EstimateMath.GetCurrency(JobFinancialMath.GetInvoiceLinkedActualCost(SelectedJob, invoice.Id))</span>
                                                <span>Tax / Remainder @EstimateMath.GetCurrency(JobFinancialMath.GetInvoiceAutoRemainder(SelectedJob, invoice))</span>
                                            </button>
                                            <div class="field-card-summary-actions">
                                                <span class="pill">@((isExpanded ? "Expanded" : "Collapsed"))</span>
                                                <button class="text-button danger" type="button" @onclick="() => RemoveInvoice(invoice.Id)">Remove</button>
                                            </div>
                                        </div>

                                        @if (isExpanded)
                                        {
                                            <div class="field-card-grid field-card-grid-four">
                                                <label>
                                                    <span>Reference #</span>
                                                    <input @bind="invoice.ReferenceNumber" />
                                                </label>
                                                <label>
                                                    <span>Vendor</span>
                                                    <input @bind="invoice.Vendor" />
                                                </label>
                                                <label>
                                                    <span>Invoice #</span>
                                                    <input @bind="invoice.InvoiceNumber" />
                                                </label>
                                                <label>
                                                    <span>Invoice Date</span>
                                                    <input type="date" @bind="invoice.InvoiceDate" @bind:format="yyyy-MM-dd" />
                                                </label>
                                            </div>

                                            <div class="field-card-grid field-card-grid-four">
                                                <label>
                                                    <span>Invoice Total</span>
                                                    <input type="number" step="0.01" @bind="invoice.InvoiceTotal" @bind:event="oninput" @bind:after="@(() => NormalizeInvoice(invoice))" />
                                                </label>
                                                <label>
                                                    <span>Linked Items</span>
                                                    <div class="input-shell value-pill">
                                                        <span class="input-prefix">$</span>
                                                        <span>@EstimateMath.GetCurrency(JobFinancialMath.GetInvoiceLinkedActualCost(SelectedJob, invoice.Id))</span>
                                                    </div>
                                                </label>
                                                <label>
                                                    <span>Auto Tax / Remainder</span>
                                                    <div class="input-shell value-pill">
                                                        <span class="input-prefix">$</span>
                                                        <span>@EstimateMath.GetCurrency(JobFinancialMath.GetInvoiceAutoRemainder(SelectedJob, invoice))</span>
                                                    </div>
                                                </label>
                                                <label>
                                                    <span>Notes</span>
                                                    <textarea class="notes-field" rows="1" @bind="invoice.Notes"></textarea>
                                                </label>
                                            </div>

                                            <AttachmentManager Attachments="invoice.Attachments" Area="@GetInvoiceAttachmentArea()" OwnerId="invoice.Id" />
                                        }
                                    </article>
                                }
                            </div>
                        }
                    }

                    @if (IsSectionExpanded(InvoicesSectionId))
                    {
                        <div class="section-add-action">
                            <button class="button button-secondary" type="button" @onclick="AddInvoice">Add Invoice</button>
                        </div>
                    }
                </section>

                <section id="@ChangeOrdersElementId" class="panel jobs-section jobs-section-change-orders page-section-anchor @(IsSectionExpanded(ChangeOrdersSectionId) ? "panel-expanded" : null)">
                    <div class="panel-header">
                        <div>
                            <p class="eyebrow">Sale adds</p>
                            <h3>Change Orders</h3>
                        </div>
                        <div class="panel-header-actions">
                            <button class="button button-secondary" type="button" @onclick='() => ToggleSection(ChangeOrdersSectionId)'>@(IsSectionExpanded(ChangeOrdersSectionId) ? "Collapse" : "Expand")</button>
                        </div>
                    </div>

                    <div class="section-link-row">
                        <button class="pill pill-button" type="button" @onclick='() => NavigateToJobSectionAsync(ScheduleOfValuesSectionId)'>To SOV</button>
                        <button class="pill pill-button" type="button" @onclick='() => NavigateToJobSectionAsync(InvoicesSectionId)'>To Invoices</button>
                        <button class="pill pill-button" type="button" @onclick='() => NavigateToJobSectionAsync(TimeEntriesSectionId)'>To Labor</button>
                    </div>

                    @if (changeOrderItems.Count == 0)
                    {
                        <p class="muted">Add approved or pending scope changes that affect job sale and projected cost.</p>
                    }
                    else
                    {
                        <div class="stats-inline">
                            <span>Approved Sale @EstimateMath.GetCurrency(EstimateMath.GetJobApprovedChangeOrderRevenue(SelectedJob))</span>
                            <span>Approved Cost @EstimateMath.GetCurrency(EstimateMath.GetJobApprovedChangeOrderCost(SelectedJob))</span>
                            <span>Tracked Actual @EstimateMath.GetCurrency(changeOrderItems.Sum(GetChangeOrderActualCost))</span>
                            <span>Change-order devices stay here so totals do not duplicate in Job Devices.</span>
                        </div>

                        @if (IsSectionExpanded(ChangeOrdersSectionId))
                        {
                            <div class="field-card-list">
                                @foreach (var changeOrder in changeOrderItems)
                                {
                                    var isExpanded = IsChangeOrderExpanded(changeOrder.Id);

                                    <article id="@GetChangeOrderElementId(changeOrder.Id)" class="field-card @(isExpanded ? "field-card-expanded" : "field-card-collapsed") page-section-anchor" @key="changeOrder.Id">
                                        <div class="field-card-summary-row">
                                            <button class="field-card-summary-button" type="button" @onclick="() => ToggleChangeOrderExpanded(changeOrder.Id)">
                                                <strong>@GetChangeOrderLabel(changeOrder)</strong>
                                                <span>@(changeOrder.Approved ? "Approved" : "Pending")</span>
                                                <span>Est. Cost @EstimateMath.GetCurrency(changeOrder.EstimatedCostImpact)</span>
                                                <span>Actual @EstimateMath.GetCurrency(GetChangeOrderActualCost(changeOrder))</span>
                                                <span>Sale @EstimateMath.GetCurrency(changeOrder.RevenueAmount)</span>
                                            </button>
                                            <div class="field-card-summary-actions">
                                                <span class="pill">@((isExpanded ? "Expanded" : "Collapsed"))</span>
                                                <button class="text-button danger" type="button" @onclick="() => RemoveChangeOrder(changeOrder.Id)">Remove</button>
                                            </div>
                                        </div>

                                        @if (isExpanded)
                                        {
                                            <div class="field-card-grid field-card-grid-four">
                                                <label>
                                                    <span>Date</span>
                                                    <input type="date" @bind="changeOrder.ApprovedOn" @bind:format="yyyy-MM-dd" @bind:after="@SyncJobFinancials" />
                                                </label>
                                                <label>
                                                    <span>Title</span>
                                                    <input @bind="changeOrder.Title" @bind:after="@SyncJobFinancials" />
                                                </label>
                                                <label>
                                                    <span>Other Est. Cost</span>
                                                    <input type="number" step="0.01" @bind="changeOrder.AdditionalEstimatedCost" @bind:event="oninput" @bind:after="@SyncJobFinancials" />
                                                    <div class="list-stack compact">
                                                        <span class="muted small">Included in estimated cost and calculated sale.</span>
                                                    </div>
                                                </label>
                                                <label>
                                                    <span>Sale</span>
                                                    <input type="number" step="0.01" value="@GetCurrencyInputValue(changeOrder.RevenueAmount)" @oninput="args => OnChangeOrderSaleChanged(changeOrder, args)" />
                                                    <div class="list-stack compact">
                                                        <span class="muted small">Calculated @EstimateMath.GetCurrency(GetChangeOrderCalculatedSale(changeOrder))</span>
                                                        @if (changeOrder.UseAutoCalculatedSale)
                                                        {
                                                            <span class="muted small">Auto mode is on and updates from scope.</span>
                                                        }
                                                        else
                                                        {
                                                            <button class="text-button" type="button" @onclick="() => UseCalculatedChangeOrderSale(changeOrder)">Use Calculated Sale</button>
                                                        }
                                                    </div>
                                                </label>
                                            </div>

                                            <div class="field-card-grid field-card-grid-four">
                                                <label>
                                                    <span>Labor Hours</span>
                                                    <input type="number" step="0.25" @bind="changeOrder.EstimatedLaborHours" @bind:event="oninput" @bind:after="@SyncJobFinancials" />
                                                    <div class="list-stack compact">
                                                        <span class="muted small">Tracked @EstimateMath.GetHours(GetChangeOrderActualLaborHours(changeOrder))</span>
                                                        <span class="muted small">Remaining @EstimateMath.GetHours(EstimateMath.RoundHours(changeOrder.EstimatedLaborHours - GetChangeOrderActualLaborHours(changeOrder)))</span>
                                                    </div>
                                                </label>
                                                <label>
                                                    <span>Direct Labor Rate</span>
                                                    <input type="number" step="0.01" @bind="changeOrder.DirectLaborRate" @bind:event="oninput" @bind:after="@SyncJobFinancials" />
                                                    <div class="list-stack compact">
                                                        <span class="muted small">Direct Total @EstimateMath.GetCurrency(GetChangeOrderEstimatedDirectLaborCost(changeOrder))</span>
                                                    </div>
                                                </label>
                                                <label>
                                                    <span>Billed Labor Rate</span>
                                                    <input type="number" step="0.01" @bind="changeOrder.BilledLaborRate" @bind:event="oninput" @bind:after="@SyncJobFinancials" />
                                                    <div class="list-stack compact">
                                                        <span class="muted small">Billed Total @EstimateMath.GetCurrency(GetChangeOrderEstimatedBilledLaborAmount(changeOrder))</span>
                                                    </div>
                                                </label>
                                                <label>
                                                    <span>Tracked Labor Cost</span>
                                                    <div class="input-shell value-pill">
                                                        <span class="input-prefix">$</span>
                                                        <span>@EstimateMath.GetCurrency(GetChangeOrderActualLaborCost(changeOrder))</span>
                                                    </div>
                                                    <div class="list-stack compact">
                                                        <span class="muted small">From time entries linked to this change order.</span>
                                                    </div>
                                                </label>
                                            </div>

                                            <div class="field-card-grid field-card-grid-three">
                                                <label class="checkbox-field">
                                                    <span>Approved</span>
                                                    <input type="checkbox" @bind="changeOrder.Approved" @bind:after="@SyncJobFinancials" />
                                                </label>
                                                <label class="full-width">
                                                    <span>Notes</span>
                                                    <textarea class="notes-field" rows="1" @bind="changeOrder.Notes"></textarea>
                                                </label>
                                            </div>

                                            <div class="stats-inline">
                                                <span>Est. Material Cost @EstimateMath.GetCurrency(GetChangeOrderEstimatedMaterialCost(changeOrder))</span>
                                                <span>Est. Material Sale @EstimateMath.GetCurrency(GetChangeOrderEstimatedMaterialSale(changeOrder))</span>
                                                <span>Direct Labor @EstimateMath.GetCurrency(GetChangeOrderEstimatedDirectLaborCost(changeOrder))</span>
                                                <span>Billed Labor @EstimateMath.GetCurrency(GetChangeOrderEstimatedBilledLaborAmount(changeOrder))</span>
                                                <span>Calculated Sale @EstimateMath.GetCurrency(GetChangeOrderCalculatedSale(changeOrder))</span>
                                                <span>Actual Material @EstimateMath.GetCurrency(GetChangeOrderActualMaterialCost(changeOrder))</span>
                                                <span>Tracked Hours @EstimateMath.GetHours(GetChangeOrderActualLaborHours(changeOrder))</span>
                                                <span>Actual Total @EstimateMath.GetCurrency(GetChangeOrderActualCost(changeOrder))</span>
                                                <span>Est. Cost @EstimateMath.GetCurrency(changeOrder.EstimatedCostImpact)</span>
                                                <span>Variance @EstimateMath.GetCurrency(GetChangeOrderVariance(changeOrder))</span>
                                            </div>

                                            <div class="panel-header minor">
                                                <div>
                                                    <p class="eyebrow">Change Order Scope</p>
                                                    <h4>Devices + Material</h4>
                                                </div>
                                            </div>

                                            @if (changeOrder.DeviceItems.Count == 0)
                                            {
                                                <p class="muted">Add device or material lines here, then track labor for this change order from Time Entries by selecting Phase = Change Order and choosing this record.</p>
                                            }
                                            else
                                            {
                                                <table class="data-table wide">
                                                    <thead>
                                                        <tr>
                                                            <th>Type</th>
                                                            <th>Description</th>
                                                            <th>Qty</th>
                                                            <th>Unit</th>
                                                            <th>Est. Unit Cost</th>
                                                            <th>Est. Unit Sale</th>
                                                            <th>Actual Unit Cost</th>
                                                            <th>Invoice Ref</th>
                                                            <th>Notes</th>
                                                            <th></th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var item in changeOrder.DeviceItems)
                                                        {
                                                            <tr id="@GetChangeOrderDeviceElementId(changeOrder.Id, item.Id)" class="page-section-anchor" @key="item.Id">
                                                                <td>
                                                                    <select @bind="item.CategoryCode" @bind:after="@(() => NormalizeChangeOrderDeviceAndSync(item))">
                                                                        <option value="@JobCostCodes.Components">Component</option>
                                                                        <option value="@JobCostCodes.Wire">Wire</option>
                                                                        <option value="@JobCostCodes.Material">Material</option>
                                                                        <option value="@JobCostCodes.Other">Other</option>
                                                                    </select>
                                                                </td>
                                                                <td><input @bind="item.Description" @bind:after="@(() => NormalizeChangeOrderDeviceAndSync(item))" /></td>
                                                                <td><input type="number" step="0.01" @bind="item.Quantity" @bind:event="oninput" @bind:after="@(() => NormalizeChangeOrderDeviceAndSync(item))" /></td>
                                                                <td><input @bind="item.UnitLabel" @bind:after="@(() => NormalizeChangeOrderDeviceAndSync(item))" /></td>
                                                                <td><input type="number" step="0.01" value="@item.EstimatedUnitCost" @oninput="args => OnChangeOrderDeviceEstimatedCostChanged(item, args)" /></td>
                                                                <td><input type="number" step="0.01" value="@item.EstimatedUnitSale" @oninput="args => OnChangeOrderDeviceEstimatedSaleChanged(item, args)" /></td>
                                                                <td><input type="number" step="0.01" value="@item.ActualUnitCost" @oninput="args => OnChangeOrderDeviceActualCostChanged(item, args)" /></td>
                                                                <td>
                                                                    <select value="@(item.InvoiceId?.ToString() ?? string.Empty)" @onchange="args => OnChangeOrderDeviceInvoiceChanged(item, args)">
                                                                        <option value="">Not linked</option>
                                                                        @foreach (var invoice in invoiceItems)
                                                                        {
                                                                            <option value="@invoice.Id">@GetInvoiceLabel(invoice)</option>
                                                                        }
                                                                    </select>
                                                                </td>
                                                                <td><textarea class="notes-field notes-field-compact" rows="1" @bind="item.Notes"></textarea></td>
                                                                <td><button class="text-button danger" type="button" @onclick="() => RemoveChangeOrderDevice(changeOrder, item.Id)">Remove</button></td>
                                                            </tr>
                                                            <tr class="change-order-line-totals">
                                                                <td colspan="10">
                                                                    <div class="stats-inline">
                                                                        <span>Est. Cost Total @EstimateMath.GetCurrency(item.EstimatedCost)</span>
                                                                        <span>Est. Sale Total @EstimateMath.GetCurrency(item.EstimatedSale)</span>
                                                                        <span>Actual Cost Total @EstimateMath.GetCurrency(item.ActualCost)</span>
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                    <tfoot>
                                                        <tr>
                                                            <th colspan="4">All Line Items</th>
                                                            <th>@EstimateMath.GetCurrency(GetChangeOrderEstimatedMaterialCost(changeOrder))</th>
                                                            <th>@EstimateMath.GetCurrency(GetChangeOrderEstimatedMaterialSale(changeOrder))</th>
                                                            <th>@EstimateMath.GetCurrency(GetChangeOrderActualMaterialCost(changeOrder))</th>
                                                            <th colspan="3"></th>
                                                        </tr>
                                                    </tfoot>
                                                </table>
                                            }

                                            <div class="section-add-action">
                                                <button class="button button-secondary" type="button" @onclick="() => AddChangeOrderDevice(changeOrder)">Add Line Item</button>
                                            </div>

                                            <AttachmentManager Attachments="changeOrder.Attachments" Area="@GetChangeOrderAttachmentArea(changeOrder.Id)" OwnerId="changeOrder.Id" />
                                        }
                                    </article>
                                }
                            </div>
                        }
                    }

                    @if (IsSectionExpanded(ChangeOrdersSectionId))
                    {
                        <div class="section-add-action">
                            <button class="button button-secondary" type="button" @onclick="AddChangeOrder">Add Change Order</button>
                        </div>
                    }
                </section>

                <section id="@CommitmentsElementId" class="panel jobs-section jobs-section-commitments page-section-anchor @(IsSectionExpanded(CommitmentsSectionId) ? "panel-expanded" : null)">
                    <div class="panel-header">
                        <div>
                            <p class="eyebrow">Committed cost</p>
                            <h3>Commitments</h3>
                        </div>
                        <div class="panel-header-actions">
                            <button class="button button-secondary" type="button" @onclick='() => ToggleSection(CommitmentsSectionId)'>@(IsSectionExpanded(CommitmentsSectionId) ? "Collapse" : "Expand")</button>
                        </div>
                    </div>

                    <div class="section-link-row">
                        <button class="pill pill-button" type="button" @onclick='() => NavigateToJobSectionAsync(ScheduleOfValuesSectionId)'>To SOV</button>
                        <button class="pill pill-button" type="button" @onclick='() => NavigateToJobSectionAsync(InvoicesSectionId)'>To Invoices</button>
                    </div>

                    @if (SelectedJob.Commitments.Count == 0)
                    {
                        <p class="muted">Use commitments for vendor POs, subcontracts, and other committed costs, then link them to the related schedule-of-values line for visibility.</p>
                    }
                    else
                    {
                        <div class="stats-inline">
                            <span>Committed @EstimateMath.GetCurrency(SelectedJob.Commitments.Sum(item => item.CommittedAmount))</span>
                            <span>Billed @EstimateMath.GetCurrency(SelectedJob.Commitments.Sum(item => item.BilledAmount))</span>
                            <span>Paid @EstimateMath.GetCurrency(SelectedJob.Commitments.Sum(item => item.PaidAmount))</span>
                        </div>

                        @if (IsSectionExpanded(CommitmentsSectionId))
                        {
                            <table class="data-table wide">
                                <thead>
                                    <tr>
                                        <th>Commitment #</th>
                                        <th>Vendor</th>
                                        <th>SOV Line</th>
                                        <th>Description</th>
                                        <th>Committed</th>
                                        <th>Billed</th>
                                        <th>Paid</th>
                                        <th>Invoice #</th>
                                        <th>Invoice Date</th>
                                        <th>Due</th>
                                        <th>Notes</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var commitment in SelectedJob.Commitments)
                                    {
                                        <tr id="@GetCommitmentElementId(commitment.Id)" class="page-section-anchor" @key="commitment.Id">
                                            <td><input @bind="commitment.CommitmentNumber" /></td>
                                            <td><input @bind="commitment.Vendor" /></td>
                                            <td>
                                                <select value="@(commitment.ScheduleValueItemId?.ToString() ?? string.Empty)" @onchange="args => OnCommitmentScheduleValueChanged(commitment, args)">
                                                    <option value="">Not linked</option>
                                                    @foreach (var item in scheduleValueItems)
                                                    {
                                                        <option value="@item.Id">@GetCommitmentScheduleValueLabel(item)</option>
                                                    }
                                                </select>
                                            </td>
                                            <td><input @bind="commitment.Description" /></td>
                                            <td>
                                                <div class="input-shell value-pill">
                                                    <span class="input-prefix">$</span>
                                                    <span>@EstimateMath.GetCurrency(commitment.CommittedAmount)</span>
                                                </div>
                                            </td>
                                            <td><input type="number" step="0.01" @bind="commitment.BilledAmount" @bind:event="oninput" @bind:after="@SyncJobFinancials" /></td>
                                            <td><input type="number" step="0.01" @bind="commitment.PaidAmount" @bind:event="oninput" @bind:after="@SyncJobFinancials" /></td>
                                            <td><input @bind="commitment.InvoiceNumber" /></td>
                                            <td><input type="date" @bind="commitment.InvoiceDate" @bind:format="yyyy-MM-dd" /></td>
                                            <td><input type="date" @bind="commitment.DueDate" @bind:format="yyyy-MM-dd" /></td>
                                            <td><textarea class="notes-field notes-field-compact" rows="1" @bind="commitment.Notes"></textarea></td>
                                            <td><button class="text-button danger" type="button" @onclick="() => RemoveCommitment(commitment.Id)">Remove</button></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    }

                    @if (IsSectionExpanded(CommitmentsSectionId))
                    {
                        <div class="section-add-action">
                            <button class="button button-secondary" type="button" @onclick="AddCommitment">Add Commitment</button>
                        </div>
                    }
                </section>

                <div class="jobs-section jobs-section-attachments">
                    <AttachmentManager Attachments="SelectedJob.Attachments" Area="jobs" OwnerId="SelectedJob.Id" />
                </div>

                <section id="@ProjectNotesElementId" class="panel jobs-section jobs-section-notes page-section-anchor @(IsSectionExpanded(ProjectNotesSectionId) ? "panel-expanded" : null)">
                    <div class="panel-header">
                        <div>
                            <p class="eyebrow">Project notes</p>
                            <h3>Notes</h3>
                        </div>
                        <button class="button button-secondary" type="button" @onclick='() => ToggleSection(ProjectNotesSectionId)'>@(IsSectionExpanded(ProjectNotesSectionId) ? "Collapse" : "Expand")</button>
                    </div>
                    @if (IsSectionExpanded(ProjectNotesSectionId))
                    {
                        <label class="full-width">
                            <span>Notes</span>
                            <textarea class="notes-field" rows="2" @bind="SelectedJob.Notes"></textarea>
                        </label>
                    }
                </section>
            }
        </div>
    </section>
}

@if (IsJobReportExportDialogOpen)
{
    <button class="dialog-scrim" type="button" @onclick="CancelJobReportExport" aria-label="Close export job report dialog"></button>
    <section class="dialog-shell" aria-modal="true" role="dialog" aria-labelledby="job-report-export-dialog-title">
        <article class="dialog-panel">
            <div class="panel-header">
                <div>
                    <p class="eyebrow">Job Report Export</p>
                    <h3 id="job-report-export-dialog-title">Name Job Report File</h3>
                </div>
            </div>

            <p class="muted">The default file name starts with the job number and project name, and you can edit it before the PDF is created.</p>

            <label class="full-width">
                <span>File Name</span>
                <input autofocus @bind="JobReportExportFileName" />
            </label>

            <div class="button-row">
                <button class="button" type="button" @onclick="ConfirmJobReportExportAsync">Export Job Report</button>
                <button class="button button-secondary" type="button" @onclick="CancelJobReportExport">Cancel</button>
            </div>
        </article>
    </section>
}

