                                        @if (materialBidDeviceItems.LastOrDefault()?.Id == item.Id)
                                        {
                                            <tr class="sov-total-row">
                                                <td colspan="2"><p class="eyebrow">Material Total</p></td>
                                                <td><span class="compact-total-value">@GetBidDeviceQuantityTotal(materialBidDeviceItems)</span></td>
