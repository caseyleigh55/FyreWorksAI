                                                <td><span class="compact-total-value">@EstimateMath.GetCurrency(GetBidDeviceEstimatedSaleTotal(wireBidDeviceItems))</span></td>
                                                <td><span class="compact-total-value">@EstimateMath.GetCurrency(GetBidDeviceActualCostTotal(wireBidDeviceItems))</span></td>
                                                <td></td>
                                                <td></td>
                                            </tr>
