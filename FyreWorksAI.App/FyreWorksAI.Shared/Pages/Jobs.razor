                        {
                            <div class="field-card-list">
                                @foreach (var changeOrder in SelectedJob.ChangeOrders.OrderByDescending(item => item.ApprovedOn).ThenBy(item => item.Title))
                                {
                                    var isExpanded = IsChangeOrderExpanded(changeOrder.Id);

                                    <article class="field-card @(isExpanded ? "field-card-expanded" : "field-card-collapsed")" @key="changeOrder.Id">
                                        <div class="field-card-summary-row">
                                            <button class="field-card-summary-button" type="button" @onclick="() => ToggleChangeOrderExpanded(changeOrder.Id)">
                                                <strong>@GetChangeOrderLabel(changeOrder)</strong>
                                                <span>@(changeOrder.Approved ? "Approved" : "Pending")</span>
                                                <span>Cost @EstimateMath.GetCurrency(changeOrder.EstimatedCostImpact)</span>
                                                <span>Sale @EstimateMath.GetCurrency(changeOrder.RevenueAmount)</span>
                                            </button>
                                            <div class="field-card-summary-actions">
                                                <span class="pill">@((isExpanded ? "Expanded" : "Collapsed"))</span>
                                                <button class="text-button danger" type="button" @onclick="() => RemoveChangeOrder(changeOrder.Id)">Remove</button>
                                            </div>
                                        </div>

                                        @if (isExpanded)
                                        {
                                            <div class="field-card-grid field-card-grid-four">
                                                <label>
                                                    <span>Date</span>
                                                    <input type="date" @bind="changeOrder.ApprovedOn" @bind:format="yyyy-MM-dd" @bind:after="@SyncJobFinancials" />
                                                </label>
                                                <label>
                                                    <span>Title</span>
                                                    <input @bind="changeOrder.Title" @bind:after="@SyncJobFinancials" />
                                                </label>
                                                <label>
                                                    <span>Cost</span>
                                                    <input type="number" step="0.01" @bind="changeOrder.EstimatedCostImpact" @bind:event="oninput" @bind:after="@SyncJobFinancials" />
                                                </label>
                                                <label>
                                                    <span>Sale</span>
                                                    <input type="number" step="0.01" @bind="changeOrder.RevenueAmount" @bind:event="oninput" @bind:after="@SyncJobFinancials" />
                                                </label>
                                            </div>

                                            <div class="field-card-grid field-card-grid-three">
                                                <label class="checkbox-field">
                                                    <span>Approved</span>
                                                    <input type="checkbox" @bind="changeOrder.Approved" @bind:after="@SyncJobFinancials" />
                                                </label>
                                                <label class="full-width">
                                                    <span>Notes</span>
                                                    <textarea class="notes-field" rows="1" @bind="changeOrder.Notes"></textarea>
                                                </label>
                                            </div>

                                            <AttachmentManager Attachments="changeOrder.Attachments" Area="@GetChangeOrderAttachmentArea(changeOrder.Id)" OwnerId="changeOrder.Id" />
                                        }
                                    </article>
                                }
                            </div>
                        }
                    }
                </section>

                <section class="panel">
                    <div class="panel-header">
                        <div>
                            <p class="eyebrow">Committed cost</p>
                            <h3>Commitments</h3>
                        </div>
                        <div class="panel-header-actions">
                            <button class="button button-secondary" type="button" @onclick="AddCommitment">Add Commitment</button>
                            <button class="button button-secondary" type="button" @onclick='() => ToggleSection("commitments")'>@(IsSectionExpanded("commitments") ? "Collapse" : "Expand")</button>
                        </div>
                    </div>

                    @if (SelectedJob.Commitments.Count == 0)
                    {
                        <p class="muted">Use commitments for vendor POs, subcontracts, and other committed costs, then link them to the related schedule-of-values line for visibility.</p>
                    }
                    else
                    {
                        <div class="stats-inline">
                            <span>Committed @EstimateMath.GetCurrency(SelectedJob.Commitments.Sum(item => item.CommittedAmount))</span>
                            <span>Billed @EstimateMath.GetCurrency(SelectedJob.Commitments.Sum(item => item.BilledAmount))</span>
                            <span>Paid @EstimateMath.GetCurrency(SelectedJob.Commitments.Sum(item => item.PaidAmount))</span>
                        </div>

                        @if (IsSectionExpanded("commitments"))
                        {
                            <table class="data-table wide">
                                <thead>
                                    <tr>
                                        <th>Commitment #</th>
                                        <th>Vendor</th>
                                        <th>SOV Line</th>
                                        <th>Description</th>
                                        <th>Committed</th>
                                        <th>Billed</th>
                                        <th>Paid</th>
                                        <th>Invoice #</th>
                                        <th>Invoice Date</th>
                                        <th>Due</th>
                                        <th>Notes</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var commitment in SelectedJob.Commitments)
                                    {
                                        <tr @key="commitment.Id">
                                            <td><input @bind="commitment.CommitmentNumber" /></td>
                                            <td><input @bind="commitment.Vendor" /></td>
                                            <td>
                                                <select value="@(commitment.ScheduleValueItemId?.ToString() ?? string.Empty)" @onchange="args => OnCommitmentScheduleValueChanged(commitment, args)">
                                                    <option value="">Not linked</option>
                                                    @foreach (var item in scheduleValueItems)
                                                    {
                                                        <option value="@item.Id">@GetCommitmentScheduleValueLabel(item)</option>
                                                    }
                                                </select>
                                            </td>
                                            <td><input @bind="commitment.Description" /></td>
                                            <td>
                                                <div class="input-shell value-pill">
                                                    <span class="input-prefix">$</span>
                                                    <span>@EstimateMath.GetCurrency(commitment.CommittedAmount)</span>
                                                </div>
                                            </td>
                                            <td><input type="number" step="0.01" @bind="commitment.BilledAmount" @bind:event="oninput" @bind:after="@SyncJobFinancials" /></td>
                                            <td><input type="number" step="0.01" @bind="commitment.PaidAmount" @bind:event="oninput" @bind:after="@SyncJobFinancials" /></td>
                                            <td><input @bind="commitment.InvoiceNumber" /></td>
                                            <td><input type="date" @bind="commitment.InvoiceDate" @bind:format="yyyy-MM-dd" /></td>
                                            <td><input type="date" @bind="commitment.DueDate" @bind:format="yyyy-MM-dd" /></td>
                                            <td><textarea class="notes-field notes-field-compact" rows="1" @bind="commitment.Notes"></textarea></td>
                                            <td><button class="text-button danger" type="button" @onclick="() => RemoveCommitment(commitment.Id)">Remove</button></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    }
                </section>

                <AttachmentManager Attachments="SelectedJob.Attachments" Area="jobs" OwnerId="SelectedJob.Id" />

                <section class="panel">
                    <div class="panel-header">
                        <div>
                            <p class="eyebrow">Project notes</p>
                            <h3>Notes</h3>
                        </div>
                        <button class="button button-secondary" type="button" @onclick='() => ToggleSection("project-notes")'>@(IsSectionExpanded("project-notes") ? "Collapse" : "Expand")</button>
                    </div>
                    @if (IsSectionExpanded("project-notes"))
                    {
                        <label class="full-width">
                            <span>Notes</span>
                            <textarea class="notes-field" rows="2" @bind="SelectedJob.Notes"></textarea>
                        </label>
                    }
                </section>
            }
        </div>
    </section>
}

