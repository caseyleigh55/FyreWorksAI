                                            <td>@EstimateMath.GetHours(GetBidDeviceHoursTotal(bidDeviceTotalItems))</td>
                                            <td>@EstimateMath.GetCurrency(GetBidDeviceEstimatedCostTotal(bidDeviceTotalItems))</td>
