@page "/bids"
@inject WorkspaceStore Store
@inject NavigationManager NavigationManager

<PageTitle>Bids</PageTitle>

@if (!Store.IsInitialized)
{
    <div class="loading-state">
        <h1>Loading bids...</h1>
        <p>Restoring templates, clients, and saved bid records.</p>
    </div>
}
else
{
    var activeBids = Store.Workspace.Bids.Where(item => item.IsActive).OrderBy(item => item.DueDate).ToList();
    var inactiveBids = Store.Workspace.Bids.Where(item => !item.IsActive).OrderByDescending(item => item.CreatedOn).ToList();
    var selectedTemplate = SelectedBid is null ? null : Store.GetTemplate(SelectedBid.TemplateId);
    var hasDemoScope = SelectedBid?.DemoItems.Count > 0;
    var currentClient = CurrentClient;
    var linkedJob = CurrentLinkedJob;
    var wireItems = SelectedBid?.Materials.Where(item => item.Kind == BidMaterialKind.Wire).ToList() ?? [];
    var materialItems = SelectedBid?.Materials.Where(item => item.Kind == BidMaterialKind.Material).ToList() ?? [];

    <section class="workspace-grid">
        <button class="workspace-flag" type="button" @onclick="ToggleDirectoryPanel" title="Toggle Bids panel">Bids</button>
        @if (IsDirectoryPanelExpanded)
        {
            <button class="workspace-drawer-scrim" type="button" @onclick="CloseDirectoryPanel" aria-label="Close Bids panel"></button>
        }
        <aside class="directory-panel directory-drawer @(IsDirectoryPanelExpanded ? "directory-drawer-open" : null)">
            <div class="panel-header">
                <div>
                    <p class="eyebrow">Estimating</p>
                    <h2>Bids</h2>
                </div>
                <div class="panel-header-actions">
                    <button class="button" type="button" @onclick="CreateBidAsync">New Bid</button>
                    <button class="button button-secondary" type="button" @onclick="CloseDirectoryPanel">Collapse</button>
                </div>
            </div>

            <div class="directory-group">
                <h3>Active</h3>
                @foreach (var bid in activeBids)
                {
                    <button class="directory-item @(SelectedBid?.Id == bid.Id ? "selected" : null)" type="button" @onclick="() => SelectBid(bid.Id)">
                        <strong>@bid.BidNumber</strong>
                        <span>@bid.ProjectName</span>
                        <small>@bid.DueDate:MM/dd/yyyy</small>
                    </button>
                }
                @if (activeBids.Count == 0)
                {
                    <p class="muted">No active bids yet.</p>
                }
            </div>

            <div class="directory-group">
                <h3>Inactive</h3>
                @foreach (var bid in inactiveBids)
                {
                    <button class="directory-item @(SelectedBid?.Id == bid.Id ? "selected" : null)" type="button" @onclick="() => SelectBid(bid.Id)">
                        <strong>@bid.BidNumber</strong>
                        <span>@bid.ProjectName</span>
                        <small>@bid.DueDate:MM/dd/yyyy</small>
                    </button>
                }
                @if (inactiveBids.Count == 0)
                {
                    <p class="muted">No inactive bids.</p>
                }
            </div>
        </aside>

        <div class="detail-column">
            @if (SelectedBid is null)
            {
                <section class="empty-state panel">
                    <h2>No bid selected</h2>
                    <p>Create a new bid to start estimating labor, material, and scope.</p>
                    <button class="button" type="button" @onclick="CreateBidAsync">Create Bid</button>
                </section>
            }
            else
            {
                <section class="panel">
                    <div class="panel-header">
                        <div>
                            <p class="eyebrow">Bid editor</p>
                            <h2>@SelectedBid.ProjectName</h2>
                        </div>
                        <div class="button-row">
                            <button class="button button-danger" type="button" @onclick="DeleteBidAsync">Delete Bid</button>
                            <button class="button button-secondary" type="button" @onclick="SaveAsync">Save Bid</button>
                            <button class="button button-secondary" type="button" @onclick="ExportProposalAsync">Export Proposal</button>
                            @if (linkedJob is not null)
                            {
                                <button class="button button-secondary" type="button" @onclick="() => NavigateToJob(linkedJob.Id)">Job Reference</button>
                            }
                            <button class="button" type="button" @onclick="ConvertToJobAsync">Convert To Job</button>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(StatusMessage))
                    {
                        <p class="callout callout-success">@StatusMessage</p>
                    }

                    <div class="panel-header minor">
                        <div>
                            <p class="eyebrow">Bid Info</p>
                        </div>
                    </div>
                    <div class="form-grid two-columns">
                        <label><span>Bid Number</span><input @bind="SelectedBid.BidNumber" /></label>
                        <label><span>Project Name</span><input @bind="SelectedBid.ProjectName" /></label>
                        <label>
                            <span>Status</span>
                            <select @bind="SelectedBid.Status">
                                <option>Draft</option><option>Submitted</option><option>Awarded</option><option>Lost</option>
                            </select>
                        </label>
                        <label class="checkbox-field"><span>Active</span><input type="checkbox" @bind="SelectedBid.IsActive" /></label>
                        <label><span>Created</span><input type="date" @bind="SelectedBid.CreatedOn" @bind:format="yyyy-MM-dd" /></label>
                        <label><span>Due Date</span><input type="date" @bind="SelectedBid.DueDate" @bind:format="yyyy-MM-dd" /></label>
                        <label class="full-width">
                            <span>Bid Template</span>
                            <select value="@(SelectedBid.TemplateId?.ToString() ?? string.Empty)" @onchange="OnTemplateChanged">
                                <option value="">No template</option>
                                @foreach (var template in Store.Workspace.Templates.Where(template => !template.IsArchived).OrderBy(template => template.Name))
                                {
                                    <option value="@template.Id">@template.Name</option>
                                }
                            </select>
                        </label>
                        <label class="full-width">
                            <span>Global Markup %</span>
                            <div class="input-shell money-input-shell">
                                <input class="shell-input" type="number" step="0.01" @bind="SelectedBid.MarkupPercent" @bind:event="oninput" @bind:after="SyncAllCalculatedSales" />
                                <span class="input-suffix">%</span>
                            </div>
                        </label>
                        <label class="full-width">
                            <span>Client</span>
                            <div class="inline-select-row">
                                <select value="@(SelectedBid.ClientId?.ToString() ?? string.Empty)" @onchange="OnClientChanged">
                                    <option value="">Unassigned</option>
                                    @foreach (var client in Store.Workspace.Clients.Where(client => client.IsActive))
                                    {
                                        <option value="@client.Id">@client.Name</option>
                                    }
                                </select>
                                <button class="button button-secondary" type="button" @onclick="CreateClientForBid">New Client</button>
                            </div>
                        </label>
                    </div>
                </section>

                <section class="panel">
                    <div class="panel-header">
                        <div><p class="eyebrow">Client Details</p><h3>Contact + Billing</h3></div>
                        @if (selectedTemplate is not null)
                        {
                            <span class="pill">@selectedTemplate.Name</span>
                        }
                    </div>
                    @if (currentClient is null)
                    {
                        <p class="muted">Select or create a client in Bid Info to edit the client record here.</p>
                    }
                    else
                    {
                        <div class="form-grid two-columns">
                            <label><span>Client Name</span><input @bind="currentClient.Name" /></label>
                            <label><span>Primary Contact</span><input @bind="currentClient.PrimaryContact" /></label>
                            <label><span>Email</span><input @bind="currentClient.Email" /></label>
                            <label><span>Phone</span><input @bind="currentClient.Phone" /></label>
                            <label class="full-width"><span>Billing Address</span><textarea rows="2" @bind="currentClient.BillingAddress"></textarea></label>
                        </div>
                    }
                </section>

                <section class="panel">
                    <div class="panel-header">
                        <div><p class="eyebrow">Totals Overview</p><h3>Calculated and Accepted Pricing</h3></div>
                    </div>
                    <div class="totals-grid">
                        <article class="summary-card">
                            <p class="eyebrow">Calculated Totals</p>
                            <div class="metric-list">
                                <div><span>Total Cost</span><strong>@EstimateMath.GetCurrency(EstimateMath.GetBidEstimatedCost(SelectedBid))</strong></div>
                                <div><span>Total Sale</span><strong>@EstimateMath.GetCurrency(EstimateMath.GetBidCalculatedSale(SelectedBid))</strong></div>
                                <div><span>Profit</span><strong>@EstimateMath.GetCurrency(EstimateMath.GetBidCalculatedProfit(SelectedBid))</strong></div>
                                <div><span>Margin</span><strong>@EstimateMath.GetPercent(EstimateMath.GetBidCalculatedMarginPercent(SelectedBid))</strong></div>
                            </div>
                        </article>
                        <article class="summary-card">
                            <p class="eyebrow">Adjusted Totals</p>
                            <div class="metric-list">
                                <label class="metric-input">
                                    <span>Accepted Sale</span>
                                    <div class="input-shell money-input-shell">
                                        <span class="input-prefix">$</span>
                                        <input class="shell-input" type="number" step="0.01" @bind="SelectedBid.AcceptedSalePrice" @bind:event="oninput" @bind:after="RoundAcceptedSale" />
                                    </div>
                                </label>
                                <div><span>Profit</span><strong>@EstimateMath.GetCurrency(EstimateMath.GetBidAdjustedProfit(SelectedBid))</strong></div>
                                <div><span>Margin</span><strong>@EstimateMath.GetPercent(EstimateMath.GetBidAdjustedMarginPercent(SelectedBid))</strong></div>
                            </div>
                        </article>
                    </div>
                    <table class="data-table compact-table">
                        <thead><tr><th>Personnel</th><th>Regular Hours</th><th>Overnight Hours</th></tr></thead>
                        <tbody>
                            <tr><td>Journeyman</td><td>@EstimateMath.GetHours(EstimateMath.GetBidAllocatedHours(SelectedBid, PersonnelType.Journeyman, HourType.Regular))</td><td>@EstimateMath.GetHours(EstimateMath.GetBidAllocatedHours(SelectedBid, PersonnelType.Journeyman, HourType.Overnight))</td></tr>
                            <tr><td>Apprentice</td><td>@EstimateMath.GetHours(EstimateMath.GetBidAllocatedHours(SelectedBid, PersonnelType.Apprentice, HourType.Regular))</td><td>@EstimateMath.GetHours(EstimateMath.GetBidAllocatedHours(SelectedBid, PersonnelType.Apprentice, HourType.Overnight))</td></tr>
                        </tbody>
                    </table>
                </section>

                <section class="panel">
                    <div class="panel-header">
                        <div><p class="eyebrow">Site Info</p><h3>Project Scope + Code Data</h3></div>
                    </div>
                    <div class="form-grid two-columns">
                        <label><span>Site Name</span><input @bind="SelectedBid.Site.SiteName" /></label>
                        <label><span>Occupancy</span><input @bind="SelectedBid.Site.OccupancyType" /></label>
                        <label class="full-width"><span>Scope Of Work</span><textarea rows="3" @bind="SelectedBid.Site.ScopeOfWork"></textarea></label>
                        <label><span>Address Line 1</span><input @bind="SelectedBid.Site.AddressLine1" /></label>
                        <label><span>Address Line 2</span><input @bind="SelectedBid.Site.AddressLine2" /></label>
                        <label><span>City</span><input @bind="SelectedBid.Site.City" /></label>
                        <label><span>State</span><input @bind="SelectedBid.Site.State" /></label>
                        <label><span>Postal Code</span><input @bind="SelectedBid.Site.PostalCode" /></label>
                        <label><span>Parcel Number</span><input @bind="SelectedBid.Site.ParcelNumber" /></label>
                        <label><span>Jurisdiction</span><input @bind="SelectedBid.Site.Jurisdiction" /></label>
                        <label><span>Building Area</span><input @bind="SelectedBid.Site.BuildingArea" /></label>
                        <label><span>Number Of Stories</span><input @bind="SelectedBid.Site.NumberOfStories" /></label>
                        <label><span>Occupancy Group</span><input @bind="SelectedBid.Site.OccupancyGroup" /></label>
                        <label><span>Occupant Load</span><input @bind="SelectedBid.Site.OccupantLoad" /></label>
                        <label><span>Construction Type</span><input @bind="SelectedBid.Site.ConstructionType" /></label>
                        <label class="checkbox-field"><span>Sprinklered</span><input type="checkbox" @bind="SelectedBid.Site.IsSprinklered" /></label>
                    </div>
                </section>

                <section class="panel">
                    <div class="panel-header">
                        <div><p class="eyebrow">Proposal Setup</p><h3>Exclusions</h3></div>
                    </div>
                    <label class="full-width">
                        <span>Exclusions</span>
                        <textarea rows="4" @bind="SelectedBid.Exclusions"></textarea>
                    </label>
                </section>

                <section class="panel">
                    <div class="panel-header">
                        <div><p class="eyebrow">Client Facing Copy</p><h3>Proposal</h3></div>
                    </div>
                    <div class="form-grid">
                        <label class="full-width">
                            <span>Proposal Summary</span>
                            <textarea rows="5" @bind="SelectedBid.ProposalSummary"></textarea>
                        </label>
                        <label class="full-width">
                            <span>Proposal Closing</span>
                            <textarea rows="3" @bind="SelectedBid.ProposalClosing"></textarea>
                        </label>
                    </div>
                    <p class="muted">The export uses this proposal copy plus the client, project, scope, exclusions, and pricing already captured on the bid.</p>
                </section>

                <section class="panel">
                    <div class="panel-header"><div><p class="eyebrow">Field Labor Allocation</p><h3>Device Hours + Manual Mix</h3></div></div>
                    <div class="summary-grid compact-summary-grid">
                        <article class="summary-card"><p class="eyebrow">Install</p><h3>@EstimateMath.GetHours(EstimateMath.GetBidInstallHours(SelectedBid))</h3></article>
                        @if (hasDemoScope)
                        {
                            <article class="summary-card"><p class="eyebrow">Demo</p><h3>@EstimateMath.GetHours(EstimateMath.GetBidDemoHours(SelectedBid))</h3></article>
                        }
                        <article class="summary-card"><p class="eyebrow">Trim</p><h3>@EstimateMath.GetHours(EstimateMath.GetBidTrimHours(SelectedBid))</h3></article>
                        <article class="summary-card"><p class="eyebrow">Test</p><h3>@EstimateMath.GetHours(EstimateMath.GetBidTestHours(SelectedBid))</h3></article>
                    </div>
                    <table class="data-table wide">
                        <thead>
                            <tr>
                                <th>Personnel</th>
                                <th>Hour Type</th>
                                <th>Install</th>
                                @if (hasDemoScope)
                                {
                                    <th>Demo</th>
                                }
                                <th>Trim</th>
                                <th>Test</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in SelectedBid.LaborDistribution.OrderBy(line => line.PersonnelType).ThenBy(line => line.HourType))
                            {
                                <tr @key="line.Id">
                                    <td>@line.PersonnelType</td>
                                    <td>@line.HourType</td>
                                    <td><div class="input-shell"><input class="shell-input" type="number" step="0.25" @bind="line.InstallHours" @bind:event="oninput" @bind:after="() => NormalizeLaborLine(line)" /><span class="input-suffix">hrs</span></div></td>
                                    @if (hasDemoScope)
                                    {
                                        <td><div class="input-shell"><input class="shell-input" type="number" step="0.25" @bind="line.DemoHours" @bind:event="oninput" @bind:after="() => NormalizeLaborLine(line)" /><span class="input-suffix">hrs</span></div></td>
                                    }
                                    <td><div class="input-shell"><input class="shell-input" type="number" step="0.25" @bind="line.TrimHours" @bind:event="oninput" @bind:after="() => NormalizeLaborLine(line)" /><span class="input-suffix">hrs</span></div></td>
                                    <td><div class="input-shell"><input class="shell-input" type="number" step="0.25" @bind="line.TestHours" @bind:event="oninput" @bind:after="() => NormalizeLaborLine(line)" /><span class="input-suffix">hrs</span></div></td>
                                    <td>@EstimateMath.GetHours(line.TotalHours)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div class="stats-inline">
                        <span>Calculated scope hours @EstimateMath.GetHours(EstimateMath.GetBidCalculatedFieldHours(SelectedBid))</span>
                        <span>Allocated field hours @EstimateMath.GetHours(EstimateMath.GetBidAllocatedFieldHours(SelectedBid))</span>
                        <span>Field cost @EstimateMath.GetCurrency(EstimateMath.GetBidFieldLaborCost(SelectedBid))</span>
                        <span>Field sale @EstimateMath.GetCurrency(EstimateMath.GetBidFieldLaborSale(SelectedBid))</span>
                    </div>
                </section>

                <section class="panel">
                    <div class="panel-header">
                        <div><p class="eyebrow">Administrative Tasks</p><h3>Office Scope</h3></div>
                        <button class="button button-secondary" type="button" @onclick="AddAdministrativeTask">Add Task</button>
                    </div>
                    <BidTaskTable Bid="SelectedBid" Tasks="SelectedBid.AdministrativeTasks" Administrative="true" OnRemove="RemoveAdministrativeTask" OnChanged="RefreshBidView" />
                    <div class="stats-inline">
                        <span>Cost @EstimateMath.GetCurrency(EstimateMath.GetBidAdministrativeTaskCost(SelectedBid))</span>
                        <span>Sale @EstimateMath.GetCurrency(EstimateMath.GetBidAdministrativeTaskSale(SelectedBid))</span>
                    </div>
                </section>

                <section class="panel">
                    <div class="panel-header">
                        <div><p class="eyebrow">Engineering Tasks</p><h3>Engineering Scope</h3></div>
                        <button class="button button-secondary" type="button" @onclick="AddEngineeringTask">Add Task</button>
                    </div>
                    <BidTaskTable Bid="SelectedBid" Tasks="SelectedBid.EngineeringTasks" OnRemove="RemoveEngineeringTask" OnChanged="RefreshBidView" />
                    <div class="stats-inline">
                        <span>Cost @EstimateMath.GetCurrency(EstimateMath.GetBidEngineeringTaskCost(SelectedBid))</span>
                        <span>Sale @EstimateMath.GetCurrency(EstimateMath.GetBidEngineeringTaskSale(SelectedBid))</span>
                    </div>
                </section>

                <datalist id="location-profiles">
                    @if (selectedTemplate is not null)
                    {
                        @foreach (var location in selectedTemplate.Rules.Select(rule => rule.LocationProfile).Distinct(StringComparer.OrdinalIgnoreCase))
                        {
                            <option value="@location"></option>
                        }
                    }
                </datalist>
                <datalist id="install-types">
                    @if (selectedTemplate is not null)
                    {
                        @foreach (var installType in selectedTemplate.Rules.Select(rule => rule.InstallType).Distinct(StringComparer.OrdinalIgnoreCase))
                        {
                            <option value="@installType"></option>
                        }
                    }
                </datalist>

                <section class="panel">
                    <div class="panel-header">
                        <div><p class="eyebrow">Field Demo</p><h3>Demo Scope</h3></div>
                        <button class="button button-secondary" type="button" @onclick="AddDemoItem">Add Demo Line</button>
                    </div>
                    @if (SelectedBid.DemoItems.Count == 0)
                    {
                        <p class="muted">Add labor-only demo lines when removal work should be tracked apart from install components.</p>
                    }
                    else
                    {
                        <div class="field-card-list">
                            @foreach (var demoItem in SelectedBid.DemoItems)
                            {
                                <article class="field-card" @key="demoItem.Id">
                                    <div class="field-card-header">
                                        <div>
                                            <p class="eyebrow">Demo line</p>
                                            <h4>@demoItem.Name</h4>
                                        </div>
                                        <button class="text-button danger" type="button" @onclick="() => RemoveDemoItem(demoItem.Id)">Remove</button>
                                    </div>

                                    <div class="field-card-grid field-card-grid-four">
                                        <label>
                                            <span>Demo Item</span>
                                            <input @bind="demoItem.Name" />
                                        </label>
                                        <label>
                                            <span>Qty</span>
                                            <input type="number" step="1" @bind="demoItem.Quantity" @bind:event="oninput" @bind:after="RefreshFieldLaborMix" />
                                        </label>
                                        <label>
                                            <span>Template Location</span>
                                            <input list="location-profiles" @bind="demoItem.LocationProfile" @bind:event="oninput" @bind:after="() => MatchDemoItemAndRefresh(demoItem)" />
                                        </label>
                                        <label>
                                            <span>Template Condition</span>
                                            <input list="install-types" @bind="demoItem.InstallType" @bind:event="oninput" @bind:after="() => MatchDemoItemAndRefresh(demoItem)" />
                                        </label>
                                    </div>

                                    <div class="field-card-grid field-card-grid-three">
                                        <label>
                                            <span>Demo Hours Each</span>
                                            <div class="input-shell">
                                                <input class="shell-input" type="number" step="0.25" @bind="demoItem.DemoHoursEach" @bind:event="oninput" @bind:after="() => NormalizeDemoHours(demoItem)" />
                                                <span class="input-suffix">hrs</span>
                                            </div>
                                        </label>
                                        <label>
                                            <span>Total Demo Hours</span>
                                            <div class="pill value-pill">@EstimateMath.GetHours(demoItem.TotalHours) hrs</div>
                                        </label>
                                        <label>
                                            <span>Notes</span>
                                            <input @bind="demoItem.Notes" />
                                        </label>
                                    </div>
                                </article>
                            }
                        </div>
                    }
                    <div class="stats-inline">
                        <span>Demo hours @EstimateMath.GetHours(SelectedBid.DemoItems.Sum(item => item.TotalHours))</span>
                        <span>Calculated demo scope rolls into the hour summaries above</span>
                    </div>
                </section>

                <section class="panel">
                    <div class="panel-header">
                        <div><p class="eyebrow">Field Buildout</p><h3>Components</h3></div>
                        <button class="button button-secondary" type="button" @onclick="AddComponent">Add Component</button>
                    </div>
                    @if (SelectedBid.Components.Count == 0)
                    {
                        <p class="muted">Add devices, panels, and field items.</p>
                    }
                    else
                    {
                        <p class="eyebrow list-caption">Component Lines</p>
                        <div class="field-card-list">
                            @foreach (var component in SelectedBid.Components)
                            {
                                var isExpanded = IsComponentExpanded(component.Id);

                                <article class="field-card @(isExpanded ? "field-card-expanded" : "field-card-collapsed")" @key="component.Id">
                                    <div class="field-card-summary-row">
                                        <button class="field-card-summary-button" type="button" @onclick="() => ToggleComponentExpanded(component.Id)">
                                            <strong>@GetComponentDisplayName(component)</strong>
                                            <span>Qty @FormatCompactNumber(component.Quantity)</span>
                                            <span>Unit Cost @EstimateMath.GetCurrency(component.UnitCost)</span>
                                            <span>Unit Sale @EstimateMath.GetCurrency(component.UnitSale)</span>
                                        </button>
                                        <div class="field-card-summary-actions">
                                            <span class="pill">@((isExpanded ? "Expanded" : "Collapsed"))</span>
                                            <button class="text-button danger" type="button" @onclick="() => RemoveComponent(component.Id)">Remove</button>
                                        </div>
                                    </div>

                                    @if (isExpanded)
                                    {
                                        <div class="field-card-grid field-card-grid-four">
                                            <label>
                                                <span>Component</span>
                                                <input @bind="component.Name" />
                                            </label>
                                            <label>
                                                <span>Qty</span>
                                                <input type="number" step="1" @bind="component.Quantity" @bind:event="oninput" @bind:after="RefreshFieldLaborMix" />
                                            </label>
                                            <label>
                                                <span>Unit Cost</span>
                                                <div class="input-shell money-input-shell">
                                                    <span class="input-prefix">$</span>
                                                    <input class="shell-input" type="number" step="0.01" @bind="component.UnitCost" @bind:event="oninput" @bind:after="() => NormalizeComponentCost(component)" />
                                                </div>
                                            </label>
                                            <label>
                                                <span>Unit Sale</span>
                                                <div class="input-shell money-input-shell">
                                                    <span class="input-prefix">$</span>
                                                    <input class="shell-input" type="number" step="0.01" @bind="component.UnitSale" @bind:event="oninput" @bind:after="() => NormalizeComponentSale(component)" />
                                                </div>
                                            </label>
                                        </div>

                                        <div class="field-card-grid field-card-grid-three">
                                            <label>
                                                <span>Template Location</span>
                                                <input list="location-profiles" @bind="component.LocationProfile" @bind:event="oninput" @bind:after="() => MatchComponentAndRefresh(component)" />
                                            </label>
                                            <label>
                                                <span>Template Condition</span>
                                                <input list="install-types" @bind="component.InstallType" @bind:event="oninput" @bind:after="() => MatchComponentAndRefresh(component)" />
                                            </label>
                                            <label>
                                                <span>Notes</span>
                                                <input @bind="component.Notes" />
                                            </label>
                                        </div>

                                        <div class="field-card-grid field-card-grid-three">
                                            <label>
                                                <div class="field-toggle-label">
                                                    <span>Install Time</span>
                                                    <input type="checkbox" @bind="component.IncludeInstall" @bind:after="RefreshFieldLaborMix" />
                                                </div>
                                                <div class="input-shell @(component.IncludeInstall ? null : "input-shell-disabled")">
                                                    <input class="shell-input" type="number" step="1" @bind="component.InstallMinutes" @bind:event="oninput" @bind:after="RefreshFieldLaborMix" />
                                                    <span class="input-suffix">min</span>
                                                </div>
                                            </label>
                                            <label>
                                                <div class="field-toggle-label">
                                                    <span>Trim Time</span>
                                                    <input type="checkbox" @bind="component.IncludeTrim" @bind:after="RefreshFieldLaborMix" />
                                                </div>
                                                <div class="input-shell @(component.IncludeTrim ? null : "input-shell-disabled")">
                                                    <input class="shell-input" type="number" step="1" @bind="component.TrimMinutes" @bind:event="oninput" @bind:after="RefreshFieldLaborMix" />
                                                    <span class="input-suffix">min</span>
                                                </div>
                                            </label>
                                            <label>
                                                <div class="field-toggle-label">
                                                    <span>Test Time</span>
                                                    <input type="checkbox" @bind="component.IncludeTest" @bind:after="RefreshFieldLaborMix" />
                                                </div>
                                                <div class="input-shell @(component.IncludeTest ? null : "input-shell-disabled")">
                                                    <input class="shell-input" type="number" step="1" @bind="component.TestMinutes" @bind:event="oninput" @bind:after="RefreshFieldLaborMix" />
                                                    <span class="input-suffix">min</span>
                                                </div>
                                            </label>
                                        </div>

                                        <div class="stats-inline">
                                            <span>Material cost @EstimateMath.GetCurrency(component.TotalMaterialCost)</span>
                                            <span>Material sale @EstimateMath.GetCurrency(component.TotalMaterialSale)</span>
                                            <span>Total labor time @EstimateMath.GetHours(component.TotalMinutes / 60m) hrs</span>
                                        </div>
                                    }
                                </article>
                            }
                        </div>
                    }
                    <div class="stats-inline">
                        <span>Cost @EstimateMath.GetCurrency(EstimateMath.GetBidComponentCost(SelectedBid))</span>
                        <span>Sale @EstimateMath.GetCurrency(EstimateMath.GetBidComponentSale(SelectedBid))</span>
                    </div>
                </section>

                <section class="panel">
                    <div class="panel-header"><div><p class="eyebrow">Wire</p><h3>Wire Items</h3></div><button class="button button-secondary" type="button" @onclick="AddWire">Add Wire</button></div>
                    <BidMaterialTable Label="Wire" Items="wireItems" MarkupPercent="SelectedBid.MarkupPercent" OnRemove="RemoveMaterial" OnChanged="RefreshBidView" />
                    <div class="stats-inline"><span>Cost @EstimateMath.GetCurrency(EstimateMath.GetBidWireCost(SelectedBid))</span><span>Sale @EstimateMath.GetCurrency(EstimateMath.GetBidWireSale(SelectedBid))</span></div>
                </section>

                <section class="panel">
                    <div class="panel-header"><div><p class="eyebrow">Material</p><h3>Material Items</h3></div><button class="button button-secondary" type="button" @onclick="AddMaterial">Add Material</button></div>
                    <BidMaterialTable Label="Material" Items="materialItems" MarkupPercent="SelectedBid.MarkupPercent" OnRemove="RemoveMaterial" OnChanged="RefreshBidView" />
                    <div class="stats-inline"><span>Cost @EstimateMath.GetCurrency(EstimateMath.GetBidMaterialOnlyCost(SelectedBid))</span><span>Sale @EstimateMath.GetCurrency(EstimateMath.GetBidMaterialOnlySale(SelectedBid))</span></div>
                </section>

                <AttachmentManager Attachments="SelectedBid.Attachments" Area="bids" OwnerId="SelectedBid.Id" />

                <section class="panel">
                    <p class="eyebrow">Notes</p>
                    <label class="full-width"><span>Combined Notes</span><textarea rows="5" @bind="SelectedBid.Notes"></textarea></label>
                </section>
            }
        </div>
    </section>
}

