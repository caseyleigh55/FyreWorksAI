@page "/"
@inject WorkspaceStore Store
@inject NavigationManager NavigationManager

<PageTitle>FyreWorks Dashboard</PageTitle>

@if (!Store.IsInitialized)
{
    <div class="loading-state">
        <h1>Loading workspace...</h1>
        <p>Bringing bids, jobs, service agreements, and templates online.</p>
    </div>
}
else
{
    var activeBids = Store.Workspace.Bids.Where(item => item.IsActive).OrderBy(item => item.DueDate).ToList();
    var activeJobs = Store.Workspace.Jobs.Where(item => item.IsActive).OrderBy(item => item.ProjectName).ToList();
    var activeService = Store.Workspace.ServiceAgreements.Where(item => item.IsActive).OrderBy(item => EstimateMath.GetNextBillingDate(item)).ToList();
    var inactiveCount = Store.Workspace.Bids.Count(item => !item.IsActive) + Store.Workspace.Jobs.Count(item => !item.IsActive) + Store.Workspace.ServiceAgreements.Count(item => !item.IsActive);

    <section class="hero hero-compact">
        <div class="hero-center">
            <p class="eyebrow">Office Command Center</p>
            <h1>Office workflow management</h1>
            <p class="hero-copy">Manage bids, job costing, and recurring service from one workspace while the evolving profile system settles into place.</p>
        </div>
    </section>

    <section class="summary-grid">
        <article class="summary-card"><p class="eyebrow">Bids</p><h2>@Store.Workspace.Bids.Count</h2><p>@activeBids.Count active / @Store.Workspace.Bids.Count(item => !item.IsActive) inactive</p></article>
        <article class="summary-card"><p class="eyebrow">Jobs</p><h2>@Store.Workspace.Jobs.Count</h2><p>@activeJobs.Count active / @Store.Workspace.Jobs.Count(item => !item.IsActive) inactive</p></article>
        <article class="summary-card"><p class="eyebrow">Service</p><h2>@Store.Workspace.ServiceAgreements.Count</h2><p>@activeService.Count active / @Store.Workspace.ServiceAgreements.Count(item => !item.IsActive) inactive</p></article>
        <article class="summary-card"><p class="eyebrow">Dormant Work</p><h2>@inactiveCount</h2><p>Closed, archived, or inactive records still available for editing.</p></article>
    </section>

    <section class="dashboard-grid">
        <article class="panel">
            <div class="panel-header">
                <div>
                    <p class="queue-label">Bids Queue</p>
                    <h3 class="queue-subtitle">Bids Due Soon</h3>
                </div>
                <NavLink class="button" href="/bids">Go to bids</NavLink>
            </div>
            @if (activeBids.Count == 0)
            {
                <p class="muted">No active bids yet. Start one from the bids page and the dashboard will surface it here.</p>
            }
            else
            {
                <div class="list-stack">
                    @foreach (var bid in activeBids.Take(5))
                    {
                        <button class="list-row list-row-button" type="button" @onclick="() => OpenBid(bid.Id)">
                            <div>
                                <strong>@bid.BidNumber</strong>
                                <p>@bid.ProjectName</p>
                            </div>
                            <div class="align-right">
                                <p>@bid.DueDate:MM/dd/yyyy</p>
                                <span class="pill">@bid.Status</span>
                            </div>
                        </button>
                    }
                </div>
            }
        </article>

        <article class="panel">
            <div class="panel-header">
                <div>
                    <p class="queue-label">Jobs Queue</p>
                    <h3 class="queue-subtitle">Active Jobs</h3>
                </div>
                <NavLink class="button button-secondary" href="/jobs">Go to jobs</NavLink>
            </div>
            @if (activeJobs.Count == 0)
            {
                <p class="muted">Converted jobs and direct-entry projects appear here.</p>
            }
            else
            {
                <div class="list-stack">
                    @foreach (var job in activeJobs.Take(5))
                    {
                        <button class="list-row list-row-button" type="button" @onclick="() => OpenJob(job.Id)">
                            <div>
                                <strong>@job.JobNumber</strong>
                                <p>@job.ProjectName</p>
                            </div>
                            <div class="align-right">
                                <p>@EstimateMath.GetCurrency(EstimateMath.GetJobProfit(job))</p>
                                <span class="pill">@job.Status</span>
                            </div>
                        </button>
                    }
                </div>
            }
        </article>

        <article class="panel">
            <div class="panel-header">
                <div>
                    <p class="queue-label">Service Queue</p>
                    <h3 class="queue-subtitle">Upcoming Service and Billing</h3>
                </div>
                <NavLink class="button button-secondary" href="/service">Go to service</NavLink>
            </div>
            @if (activeService.Count == 0)
            {
                <p class="muted">Create a monitoring agreement to track inspection dates and monthly payments.</p>
            }
            else
            {
                <div class="list-stack">
                    @foreach (var agreement in activeService.Take(5))
                    {
                        <button class="list-row list-row-button" type="button" @onclick="() => OpenService(agreement.Id)">
                            <div>
                                <strong>@agreement.AgreementNumber</strong>
                                <p>@agreement.AgreementName</p>
                            </div>
                            <div class="align-right">
                                <p>Bill @EstimateMath.GetNextBillingDate(agreement):MM/dd/yyyy</p>
                                <span class="pill">@agreement.NextInspectionDate:MM/dd/yyyy</span>
                            </div>
                        </button>
                    }
                </div>
            }
        </article>

        <article class="panel accent">
            <div class="panel-header">
                <div>
                    <p class="queue-label">Profiles Placeholder</p>
                    <h3 class="queue-subtitle">Template Profiles In Progress</h3>
                </div>
                <NavLink class="button button-secondary" href="/templates">Open Templates</NavLink>
            </div>
            <p class="muted">Bid profiles are live now, and the dashboard placeholder stays here while job and service profile ideas are still taking shape.</p>
            <p class="muted small">Current default: @(Store.GetTemplate(Store.Workspace.Settings.DefaultTemplateId)?.Name ?? "None selected")</p>
        </article>
    </section>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        await Store.InitializeAsync();
    }

    private void OpenBid(Guid bidId) => NavigationManager.NavigateTo($"/bids?selected={bidId}");
    private void OpenJob(Guid jobId) => NavigationManager.NavigateTo($"/jobs?selected={jobId}");
    private void OpenService(Guid agreementId) => NavigationManager.NavigateTo($"/service?selected={agreementId}");
}
