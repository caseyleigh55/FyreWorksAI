@page "/service"
@inject WorkspaceStore Store
@inject NavigationManager NavigationManager

<PageTitle>Service</PageTitle>

@if (!Store.IsInitialized)
{
    <div class="loading-state">
        <h1>Loading service agreements...</h1>
        <p>Restoring monitoring schedules, inspections, calls, and service quotes.</p>
    </div>
}
else
{
    var activeAgreements = Store.Workspace.ServiceAgreements.Where(item => item.IsActive).OrderBy(item => EstimateMath.GetNextBillingDate(item)).ToList();
    var inactiveAgreements = Store.Workspace.ServiceAgreements.Where(item => !item.IsActive).OrderByDescending(item => item.ContractStart).ToList();
    var currentClient = CurrentClient;

    <section class="workspace-grid">
        <button class="workspace-flag" type="button" @onclick="ToggleDirectoryPanel" title="Toggle Service panel">Service</button>
        @if (IsDirectoryPanelExpanded)
        {
            <button class="workspace-drawer-scrim" type="button" @onclick="CloseDirectoryPanel" aria-label="Close Service panel"></button>
        }
        <aside class="directory-panel directory-drawer @(IsDirectoryPanelExpanded ? "directory-drawer-open" : null)">
            <div class="panel-header">
                <div>
                    <p class="eyebrow">Monitoring + service</p>
                    <h2>Service</h2>
                </div>
                <div class="panel-header-actions">
                    <button class="button" type="button" @onclick="CreateAgreementAsync">New Agreement</button>
                    <button class="button button-secondary" type="button" @onclick="CloseDirectoryPanel">Collapse</button>
                </div>
            </div>

            <div class="directory-group">
                <h3>Active</h3>
                @if (activeAgreements.Count == 0)
                {
                    <p class="muted">No active service agreements yet.</p>
                }
                else
                {
                    @foreach (var agreement in activeAgreements)
                    {
                        <button class="directory-item @(SelectedAgreement?.Id == agreement.Id ? "selected" : null)" type="button" @onclick="() => SelectAgreement(agreement.Id)">
                            <strong>@agreement.AgreementNumber</strong>
                            <span>@agreement.AgreementName</span>
                            <small>Bill @EstimateMath.GetNextBillingDate(agreement):d</small>
                        </button>
                    }
                }
            </div>

            <div class="directory-group">
                <h3>Inactive</h3>
                @if (inactiveAgreements.Count == 0)
                {
                    <p class="muted">No inactive service agreements.</p>
                }
                else
                {
                    @foreach (var agreement in inactiveAgreements)
                    {
                        <button class="directory-item @(SelectedAgreement?.Id == agreement.Id ? "selected" : null)" type="button" @onclick="() => SelectAgreement(agreement.Id)">
                            <strong>@agreement.AgreementNumber</strong>
                            <span>@agreement.AgreementName</span>
                            <small>Inactive</small>
                        </button>
                    }
                }
            </div>
        </aside>

        <div class="detail-column">
            @if (SelectedAgreement is null)
            {
                <section class="empty-state panel">
                    <h2>No service agreement selected</h2>
                    <p>Create an agreement to track contract billing, inspections, service calls, and service quotes.</p>
                    <button class="button" type="button" @onclick="CreateAgreementAsync">Create Agreement</button>
                </section>
            }
            else
            {
                var orderedMonitoringPayments = GetOrderedMonitoringPayments();
                var orderedServiceCalls = GetOrderedServiceCalls();
                var linkedCurrentQuoteCall = SelectedQuote is null ? null : GetLinkedServiceCall(SelectedQuote);

                <section id="@AgreementInfoElementId" class="panel page-section-anchor">
                    <div class="panel-header">
                        <div>
                            <p class="eyebrow">Agreement editor</p>
                            <h2>@SelectedAgreement.AgreementName</h2>
                        </div>
                        <div class="button-row">
                            <button class="button button-secondary" type="button" @onclick="RegenerateScheduleAsync">Rebuild Billing Schedule</button>
                            <button class="button" type="button" @onclick="SaveAsync">Save Agreement</button>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(StatusMessage))
                    {
                        <p class="callout callout-success">@StatusMessage</p>
                    }

                    <div class="form-grid two-columns">
                        <label>
                            <span>Agreement Number</span>
                            <input @bind="SelectedAgreement.AgreementNumber" />
                        </label>
                        <label>
                            <span>Agreement Name</span>
                            <input @bind="SelectedAgreement.AgreementName" @bind:after="RefreshPageSectionNavigation" />
                        </label>
                        <label class="checkbox-field">
                            <span>Active</span>
                            <input type="checkbox" @bind="SelectedAgreement.IsActive" />
                        </label>
                        <label>
                            <span>Client</span>
                            <select value="@(SelectedAgreement.ClientId?.ToString() ?? string.Empty)" @onchange="OnClientChanged">
                                <option value="">Unassigned</option>
                                @foreach (var client in Store.Workspace.Clients.Where(client => client.IsActive))
                                {
                                    <option value="@client.Id">@client.Name</option>
                                }
                            </select>
                        </label>
                        <label>
                            <span>Contract Start</span>
                            <input type="date" @bind="SelectedAgreement.ContractStart" @bind:format="yyyy-MM-dd" />
                        </label>
                        <label>
                            <span>Contract Months</span>
                            <input type="number" step="1" @bind="SelectedAgreement.ContractMonths" />
                        </label>
                        <label>
                            <span>Monthly Monitoring</span>
                            <input type="number" step="0.01" @bind="SelectedAgreement.MonthlyMonitoringAmount" />
                        </label>
                        <label>
                            <span>Inspection Interval (Months)</span>
                            <input type="number" step="1" @bind="SelectedAgreement.InspectionIntervalMonths" />
                        </label>
                        <label>
                            <span>Next Inspection</span>
                            <input type="date" @bind="SelectedAgreement.NextInspectionDate" @bind:format="yyyy-MM-dd" />
                        </label>
                    </div>
                </section>

                <section class="summary-grid">
                    <article class="summary-card">
                        <p class="eyebrow">Contract Value</p>
                        <h3>@EstimateMath.GetCurrency(EstimateMath.GetServiceContractValue(SelectedAgreement))</h3>
                        <p>@SelectedAgreement.ContractMonths months of monitoring scheduled.</p>
                    </article>
                    <article class="summary-card">
                        <p class="eyebrow">Received</p>
                        <h3>@EstimateMath.GetCurrency(EstimateMath.GetServicePaid(SelectedAgreement))</h3>
                        <p>Monitoring cash collected against the agreement.</p>
                    </article>
                    <article class="summary-card">
                        <p class="eyebrow">Remaining</p>
                        <h3>@EstimateMath.GetCurrency(EstimateMath.GetServiceOutstanding(SelectedAgreement))</h3>
                        <p>Contract balance still outstanding.</p>
                    </article>
                    <article class="summary-card">
                        <p class="eyebrow">Current Installment</p>
                        <h3>@(EstimateMath.GetCurrentServiceInstallment(SelectedAgreement) is null ? "Complete" : $"#{EstimateMath.GetCurrentServiceInstallmentNumber(SelectedAgreement)}")</h3>
                        <p>@GetCurrentMonitoringInstallmentSummary()</p>
                    </article>
                </section>

                <section id="@ProtectedPremisesElementId" class="panel page-section-anchor @(IsSectionExpanded(ProtectedPremisesSectionId) ? "panel-expanded" : null)">
                    <div class="panel-header">
                        <div>
                            <p class="eyebrow">Client + site</p>
                            <h3>Protected Premises</h3>
                        </div>
                        <div class="panel-header-actions">
                            <button class="button button-secondary" type="button" @onclick="CreateClientForAgreement">New Client</button>
                            <button class="button button-secondary" type="button" @onclick='() => ToggleSection(ProtectedPremisesSectionId)'>@(IsSectionExpanded(ProtectedPremisesSectionId) ? "Collapse" : "Expand")</button>
                        </div>
                    </div>

                    @if (IsSectionExpanded(ProtectedPremisesSectionId) && currentClient is null)
                    {
                        <p class="muted">Assign a service client to connect billing and monitoring history to a reusable customer record.</p>
                    }
                    else if (IsSectionExpanded(ProtectedPremisesSectionId))
                    {
                        var editableClient = currentClient!;

                        <div class="form-grid two-columns">
                            <label>
                                <span>Client Name</span>
                                <input @bind="editableClient.Name" />
                            </label>
                            <label>
                                <span>Primary Contact</span>
                                <input @bind="editableClient.PrimaryContact" />
                            </label>
                            <label>
                                <span>Email</span>
                                <input @bind="editableClient.Email" />
                            </label>
                            <label>
                                <span>Phone</span>
                                <input @bind="editableClient.Phone" />
                            </label>
                            <label class="full-width">
                                <span>Billing Address</span>
                                <textarea class="notes-field" rows="2" @bind="editableClient.BillingAddress"></textarea>
                            </label>
                        </div>
                    }

                    @if (IsSectionExpanded(ProtectedPremisesSectionId))
                    {
                        <div class="form-grid two-columns">
                            <label>
                                <span>Site Name</span>
                                <input @bind="SelectedAgreement.Site.SiteName" />
                            </label>
                            <label>
                                <span>Occupancy</span>
                                <input @bind="SelectedAgreement.Site.OccupancyType" />
                            </label>
                            <label>
                                <span>Address Line 1</span>
                                <input @bind="SelectedAgreement.Site.AddressLine1" />
                            </label>
                            <label>
                                <span>Address Line 2</span>
                                <input @bind="SelectedAgreement.Site.AddressLine2" />
                            </label>
                            <label>
                                <span>City</span>
                                <input @bind="SelectedAgreement.Site.City" />
                            </label>
                            <label>
                                <span>State</span>
                                <input @bind="SelectedAgreement.Site.State" />
                            </label>
                            <label>
                                <span>Postal Code</span>
                                <input @bind="SelectedAgreement.Site.PostalCode" />
                            </label>
                            <label class="full-width">
                                <span>Site Notes</span>
                                <textarea class="notes-field" rows="1" @bind="SelectedAgreement.Site.Notes"></textarea>
                            </label>
                        </div>
                    }
                </section>

                <section id="@MonitoringPaymentsElementId" class="panel page-section-anchor @(IsSectionExpanded(MonitoringPaymentsSectionId) ? "panel-expanded" : null)">
                    <div class="panel-header">
                        <div>
                            <p class="eyebrow">Recurring billing</p>
                            <h3>Monitoring Payments</h3>
                        </div>
                        <div class="panel-header-actions">
                            <button class="button button-secondary" type="button" @onclick='() => ToggleSection(MonitoringPaymentsSectionId)'>@(IsSectionExpanded(MonitoringPaymentsSectionId) ? "Collapse" : "Expand")</button>
                        </div>
                    </div>

                    @if (IsSectionExpanded(MonitoringPaymentsSectionId) && orderedMonitoringPayments.Count == 0)
                    {
                        <p class="muted">No monitoring installments have been scheduled yet.</p>
                    }
                    else if (IsSectionExpanded(MonitoringPaymentsSectionId))
                    {
                        <table class="data-table wide">
                            <thead>
                                <tr>
                                    <th>Installment</th>
                                    <th>Due Date</th>
                                    <th>Amount</th>
                                    <th>Amount Billed</th>
                                    <th>Billed Date</th>
                                    <th>Received Amount</th>
                                    <th>Received Date</th>
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var payment in orderedMonitoringPayments)
                                {
                                    <tr id="@GetMonitoringPaymentElementId(payment.Id)" class="page-section-anchor" @key="payment.Id">
                                        <td><span class="compact-readonly-value">#@GetMonitoringPaymentInstallmentNumber(payment)</span></td>
                                        <td><input type="date" @bind="payment.DueDate" @bind:format="yyyy-MM-dd" /></td>
                                        <td><input type="number" step="0.01" @bind="payment.Amount" @bind:after="@(() => NormalizeMonitoringPayment(payment))" /></td>
                                        <td><input type="number" step="0.01" @bind="payment.AmountBilled" @bind:after="@(() => NormalizeMonitoringPayment(payment))" /></td>
                                        <td><input type="date" value="@GetDateInputValue(payment.BilledOn)" @onchange="args => OnMonitoringPaymentBilledDateChanged(payment, args)" /></td>
                                        <td><input type="number" step="0.01" @bind="payment.ReceivedAmount" @bind:after="@(() => NormalizeMonitoringPayment(payment))" /></td>
                                        <td><input type="date" value="@GetDateInputValue(payment.ReceivedOn)" @onchange="args => OnMonitoringPaymentReceivedDateChanged(payment, args)" /></td>
                                        <td><span class="pill service-status-pill">@GetMonitoringPaymentStatus(payment)</span></td>
                                        <td><button class="text-button danger" type="button" @onclick="() => RemoveMonitoringPayment(payment.Id)">Remove</button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <div class="stats-inline">
                            <span>Contract @EstimateMath.GetCurrency(EstimateMath.GetServiceContractValue(SelectedAgreement))</span>
                            <span>Billed @EstimateMath.GetCurrency(EstimateMath.GetServiceBilled(SelectedAgreement))</span>
                            <span>Received @EstimateMath.GetCurrency(EstimateMath.GetServicePaid(SelectedAgreement))</span>
                            <span>Remaining @EstimateMath.GetCurrency(EstimateMath.GetServiceOutstanding(SelectedAgreement))</span>
                            <span>Paid Installments @EstimateMath.GetServicePaidInstallmentCount(SelectedAgreement) / @orderedMonitoringPayments.Count</span>
                            <span>Contract Received @($"{EstimateMath.GetServiceReceivedPercent(SelectedAgreement):N1}%")</span>
                            <span>@GetCurrentMonitoringInstallmentSummary()</span>
                        </div>
                    }

                    @if (IsSectionExpanded(MonitoringPaymentsSectionId))
                    {
                        <div class="section-add-action">
                            <button class="button button-secondary" type="button" @onclick="AddMonitoringPayment">Add Payment Row</button>
                        </div>
                    }
                </section>

                <section id="@ServiceCallsElementId" class="panel page-section-anchor @(IsSectionExpanded(ServiceCallsSectionId) ? "panel-expanded" : null)">
                    <div class="panel-header">
                        <div>
                            <p class="eyebrow">Field support</p>
                            <h3>Service Calls</h3>
                        </div>
                        <div class="panel-header-actions">
                            <button class="button button-secondary" type="button" @onclick='() => ToggleSection(ServiceCallsSectionId)'>@(IsSectionExpanded(ServiceCallsSectionId) ? "Collapse" : "Expand")</button>
                        </div>
                    </div>

                    @if (IsSectionExpanded(ServiceCallsSectionId) && orderedServiceCalls.Count == 0)
                    {
                        <p class="muted">Track each service ticket, return visit, billing record, and call-specific files here.</p>
                    }
                    else if (IsSectionExpanded(ServiceCallsSectionId))
                    {
                        <div class="list-stack service-record-stack">
                            @foreach (var serviceCall in orderedServiceCalls)
                            {
                                var linkedQuote = serviceCall.SourceQuoteId is null
                                    ? null
                                    : SelectedAgreement.Quotes.FirstOrDefault(quote => quote.Id == serviceCall.SourceQuoteId.Value);
                                var isExpanded = IsServiceCallExpanded(serviceCall.Id);

                                <article id="@GetServiceCallElementId(serviceCall.Id)" class="service-record-shell page-section-anchor @(isExpanded ? "service-record-shell-expanded" : null)" @key="serviceCall.Id">
                                    <button class="list-row list-row-button service-record-toggle" type="button" @onclick="() => ToggleServiceCall(serviceCall.Id)">
                                        <div class="service-record-copy">
                                            <strong>@serviceCall.ServiceJobNumber</strong>
                                            <p>@(string.IsNullOrWhiteSpace(serviceCall.Title) ? "Service Call" : serviceCall.Title)</p>
                                        </div>
                                        <div class="service-record-pills">
                                            <span class="pill service-status-pill">@serviceCall.Status</span>
                                            @if (!string.Equals(serviceCall.ServiceJobNumber, serviceCall.ServiceTicketNumber, StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span class="pill">Return Visit</span>
                                            }
                                            @if (linkedQuote is not null)
                                            {
                                                <span class="pill">Quote Linked</span>
                                            }
                                            <span class="pill">@EstimateMath.GetCurrency(EstimateMath.GetServiceCallInvoiceAmount(serviceCall))</span>
                                        </div>
                                    </button>

                                    @if (isExpanded)
                                    {
                                        <div class="service-record-body">
                                            <div class="form-grid two-columns">
                                                <label>
                                                    <span>Service Job Number</span>
                                                    <input value="@serviceCall.ServiceJobNumber" readonly />
                                                </label>
                                                <label>
                                                    <span>Service Ticket</span>
                                                    <input value="@serviceCall.ServiceTicketNumber" readonly />
                                                </label>
                                                <label>
                                                    <span>Call Title</span>
                                                    <input @bind="serviceCall.Title" />
                                                </label>
                                                <label>
                                                    <span>Status</span>
                                                    <select @bind="serviceCall.Status">
                                                        <option>Open</option>
                                                        <option>Scheduled</option>
                                                        <option>Completed</option>
                                                        <option>Cancelled</option>
                                                    </select>
                                                </label>
                                                <label>
                                                    <span>Opened</span>
                                                    <input type="date" @bind="serviceCall.OpenedOn" @bind:format="yyyy-MM-dd" />
                                                </label>
                                                <label>
                                                    <span>Scheduled</span>
                                                    <input type="date" @bind="serviceCall.ScheduledFor" @bind:format="yyyy-MM-dd" />
                                                </label>
                                                <label>
                                                    <span>Completed</span>
                                                    <input type="date" @bind="serviceCall.CompletedOn" @bind:format="yyyy-MM-dd" />
                                                </label>
                                                <label>
                                                    <span>Technician</span>
                                                    <input @bind="serviceCall.Technician" />
                                                </label>
                                                <label class="full-width">
                                                    <span>Call Notes</span>
                                                    <textarea class="notes-field" rows="1" @bind="serviceCall.Description"></textarea>
                                                </label>
                                            </div>

                                            @if (linkedQuote is not null)
                                            {
                                                <div class="stats-inline">
                                                    <span>Quote @linkedQuote.Title</span>
                                                    <span>Quoted @EstimateMath.GetCurrency(serviceCall.SourceQuoteAmount)</span>
                                                    <span>Quote Status @linkedQuote.Status</span>
                                                </div>

                                                <div class="section-add-action">
                                                    <button class="button button-secondary" type="button" @onclick="() => NavigateToQuote(linkedQuote.Id)">Open Linked Quote</button>
                                                </div>
                                            }

                                            <div class="panel-header minor">
                                                <h4>Call Billing</h4>
                                            </div>

                                            <div class="form-grid two-columns">
                                                <label>
                                                    <span>Invoice Number</span>
                                                    <input @bind="serviceCall.Billing.InvoiceNumber" />
                                                </label>
                                                <label>
                                                    <span>Labor Hours</span>
                                                    <input type="number" step="0.25" @bind="serviceCall.Billing.LaborHours" @bind:after="@(() => NormalizeServiceCallBilling(serviceCall))" />
                                                </label>
                                                <label>
                                                    <span>Labor Amount</span>
                                                    <input type="number" step="0.01" @bind="serviceCall.Billing.LaborAmount" @bind:after="@(() => NormalizeServiceCallBilling(serviceCall))" />
                                                </label>
                                                <label>
                                                    <span>Material Amount</span>
                                                    <input type="number" step="0.01" @bind="serviceCall.Billing.MaterialAmount" @bind:after="@(() => NormalizeServiceCallBilling(serviceCall))" />
                                                </label>
                                                <label>
                                                    <span>Invoice Amount</span>
                                                    <input type="number" step="0.01" @bind="serviceCall.Billing.InvoiceAmount" @bind:after="@(() => NormalizeServiceCallBilling(serviceCall))" />
                                                </label>
                                                <label>
                                                    <span>Billed Amount</span>
                                                    <input type="number" step="0.01" @bind="serviceCall.Billing.BilledAmount" @bind:after="@(() => NormalizeServiceCallBilling(serviceCall))" />
                                                </label>
                                                <label>
                                                    <span>Billed Date</span>
                                                    <input type="date" value="@GetDateInputValue(serviceCall.Billing.BilledOn)" @onchange="args => OnServiceCallBilledDateChanged(serviceCall, args)" />
                                                </label>
                                                <label>
                                                    <span>Paid Amount</span>
                                                    <input type="number" step="0.01" @bind="serviceCall.Billing.PaidAmount" @bind:after="@(() => NormalizeServiceCallBilling(serviceCall))" />
                                                </label>
                                                <label>
                                                    <span>Paid Date</span>
                                                    <input type="date" value="@GetDateInputValue(serviceCall.Billing.PaidOn)" @onchange="args => OnServiceCallPaidDateChanged(serviceCall, args)" />
                                                </label>
                                                <label class="full-width">
                                                    <span>Billing Notes</span>
                                                    <textarea class="notes-field" rows="1" @bind="serviceCall.Billing.Notes"></textarea>
                                                </label>
                                            </div>

                                            <div class="stats-inline">
                                                @if (serviceCall.SourceQuoteAmount > 0m)
                                                {
                                                    <span>Quoted @EstimateMath.GetCurrency(serviceCall.SourceQuoteAmount)</span>
                                                }
                                                <span>Invoice @EstimateMath.GetCurrency(EstimateMath.GetServiceCallInvoiceAmount(serviceCall))</span>
                                                <span>Billed @EstimateMath.GetCurrency(EstimateMath.GetServiceCallBilledAmount(serviceCall))</span>
                                                <span>Paid @EstimateMath.GetCurrency(EstimateMath.GetServiceCallPaidAmount(serviceCall))</span>
                                                <span>Outstanding @EstimateMath.GetCurrency(EstimateMath.GetServiceCallOutstandingAmount(serviceCall))</span>
                                            </div>

                                            <AttachmentManager Attachments="serviceCall.Attachments" Area="service-calls" OwnerId="serviceCall.Id" Eyebrow="Call Files" Title="Attachments" InitiallyExpanded="false" />

                                            <div class="button-row service-record-actions">
                                                <button class="button button-secondary" type="button" @onclick="() => AddReturnVisit(serviceCall)">Add Return Visit</button>
                                                <button class="button button-danger" type="button" @onclick="() => RemoveServiceCall(serviceCall.Id)">Remove Service Call</button>
                                            </div>
                                        </div>
                                    }
                                </article>
                            }
                        </div>

                        <div class="stats-inline">
                            <span>Calls @orderedServiceCalls.Count</span>
                            <span>Open @GetOpenServiceCallCount()</span>
                            <span>Hours @EstimateMath.GetHours(GetTotalServiceCallHours())</span>
                            <span>Quoted @EstimateMath.GetCurrency(GetTotalServiceCallQuotedAmount())</span>
                            <span>Invoice @EstimateMath.GetCurrency(GetTotalServiceCallInvoiceAmount())</span>
                            <span>Billed @EstimateMath.GetCurrency(GetTotalServiceCallBilledAmount())</span>
                            <span>Paid @EstimateMath.GetCurrency(GetTotalServiceCallPaidAmount())</span>
                            <span>Outstanding @EstimateMath.GetCurrency(GetTotalServiceCallOutstandingAmount())</span>
                        </div>
                    }

                    @if (IsSectionExpanded(ServiceCallsSectionId))
                    {
                        <div class="section-add-action">
                            <button class="button button-secondary" type="button" @onclick="AddServiceCall">Add Service Call</button>
                        </div>
                    }
                </section>

                <section id="@ServiceQuotesElementId" class="panel page-section-anchor @(IsSectionExpanded(ServiceQuotesSectionId) ? "panel-expanded" : null)">
                    <div class="panel-header">
                        <div>
                            <p class="eyebrow">Client quoting</p>
                            <h3>Service Quotes</h3>
                        </div>
                        <div class="panel-header-actions">
                            <button class="button button-secondary" type="button" @onclick='() => ToggleSection(ServiceQuotesSectionId)'>@(IsSectionExpanded(ServiceQuotesSectionId) ? "Collapse" : "Expand")</button>
                        </div>
                    </div>

                    @if (IsSectionExpanded(ServiceQuotesSectionId))
                    {
                        <div class="quote-layout">
                            <div class="quote-directory">
                                @if (SelectedAgreement.Quotes.Count == 0)
                                {
                                    <p class="muted">No service quotes yet.</p>
                                }
                                else
                                {
                                    @foreach (var quote in SelectedAgreement.Quotes)
                                    {
                                        var linkedServiceCall = GetLinkedServiceCall(quote);

                                        <button id="@GetServiceQuoteElementId(quote.Id)" class="directory-item @(SelectedQuote?.Id == quote.Id ? "selected" : null) page-section-anchor" type="button" @onclick="() => SelectQuote(quote.Id)">
                                            <strong>@quote.Title</strong>
                                            <span>@quote.Status</span>
                                            <small>@EstimateMath.GetCurrency(EstimateMath.GetServiceQuoteRevenue(quote))@(linkedServiceCall is null ? string.Empty : $" | {linkedServiceCall.ServiceJobNumber}")</small>
                                        </button>
                                    }
                                }

                                <div class="section-add-action">
                                    <button class="button button-secondary" type="button" @onclick="AddQuote">Add Quote</button>
                                </div>
                            </div>

                            <div>
                                @if (SelectedQuote is null)
                                {
                                    <p class="muted">Select a quote to edit its scope, export it for the client, or convert it into a service call.</p>
                                }
                                else
                                {
                                    <div class="panel-header minor">
                                        <div>
                                            <p class="eyebrow">Quote detail</p>
                                            <h4>@SelectedQuote.Title</h4>
                                        </div>
                                        <div class="button-row">
                                            <button class="button button-secondary" type="button" @onclick="ExportSelectedQuoteAsync">Export Quote</button>
                                            <button class="button" type="button" @onclick="ConvertSelectedQuoteToServiceCallAsync">@GetQuoteConversionButtonLabel(SelectedQuote)</button>
                                        </div>
                                    </div>

                                    <div class="form-grid two-columns">
                                        <label>
                                            <span>Quote Title</span>
                                            <input @bind="SelectedQuote.Title" />
                                        </label>
                                        <label>
                                            <span>Status</span>
                                            <select @bind="SelectedQuote.Status">
                                                <option>Draft</option>
                                                <option>Sent</option>
                                                <option>Accepted</option>
                                                <option>Rejected</option>
                                            </select>
                                        </label>
                                        <label>
                                            <span>Created</span>
                                            <input type="date" @bind="SelectedQuote.CreatedOn" @bind:format="yyyy-MM-dd" />
                                        </label>
                                        <label>
                                            <span>Accepted On</span>
                                            <input type="date" value="@GetDateInputValue(SelectedQuote.AcceptedOn)" @onchange="args => SelectedQuote.AcceptedOn = ParseNullableDate(args.Value?.ToString())" />
                                        </label>
                                    </div>

                                    <label class="full-width">
                                        <span>Quote Notes</span>
                                        <textarea class="notes-field" rows="1" @bind="SelectedQuote.Notes"></textarea>
                                    </label>

                                    <div class="panel-header minor">
                                        <h4>Service Labor Rates</h4>
                                    </div>

                                    @if (SelectedQuote.LaborLines.Count == 0)
                                    {
                                        <p class="muted">Add separate labor rows for first hour, additional hours, overtime, or any other rate structure.</p>
                                    }
                                    else
                                    {
                                        <table class="data-table wide">
                                            <thead>
                                                <tr>
                                                    <th>Description</th>
                                                    <th>Hours</th>
                                                    <th>Cost Rate</th>
                                                    <th>Sale Rate</th>
                                                    <th>Cost</th>
                                                    <th>Sale</th>
                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var laborLine in SelectedQuote.LaborLines)
                                                {
                                                    <tr id="@GetServiceQuoteLaborLineElementId(laborLine.Id)" class="page-section-anchor" @key="laborLine.Id">
                                                        <td><input @bind="laborLine.Description" @bind:after="@(() => NormalizeServiceQuoteLaborLine(laborLine))" /></td>
                                                        <td>
                                                            <div class="input-shell">
                                                                <input class="shell-input" type="number" step="0.25" @bind="laborLine.Hours" @bind:event="oninput" @bind:after="@(() => NormalizeServiceQuoteLaborLine(laborLine))" />
                                                                <span class="input-suffix">hrs</span>
                                                            </div>
                                                        </td>
                                                        <td>
                                                            <div class="input-shell money-input-shell">
                                                                <span class="input-prefix">$</span>
                                                                <input class="shell-input" type="number" step="0.01" @bind="laborLine.CostRate" @bind:event="oninput" @bind:after="@(() => NormalizeServiceQuoteLaborLine(laborLine))" />
                                                            </div>
                                                        </td>
                                                        <td>
                                                            <div class="input-shell money-input-shell">
                                                                <span class="input-prefix">$</span>
                                                                <input class="shell-input" type="number" step="0.01" @bind="laborLine.SaleRate" @bind:event="oninput" @bind:after="@(() => NormalizeServiceQuoteLaborLine(laborLine))" />
                                                            </div>
                                                        </td>
                                                        <td><span class="compact-readonly-value">@EstimateMath.GetCurrency(laborLine.TotalCost)</span></td>
                                                        <td><span class="compact-readonly-value">@EstimateMath.GetCurrency(laborLine.TotalSale)</span></td>
                                                        <td><button class="text-button danger" type="button" @onclick="() => RemoveQuoteLaborLine(laborLine.Id)">Remove</button></td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    }

                                    <div class="section-add-action">
                                        <button class="button button-secondary" type="button" @onclick="AddQuoteLaborLine">Add Labor Rate</button>
                                    </div>

                                    <div class="totals-grid">
                                        <article class="summary-card">
                                            <p class="eyebrow">Calculated Totals</p>
                                            <div class="metric-list">
                                                <div><span>Service Hours</span><strong>@EstimateMath.GetHours(EstimateMath.GetServiceQuoteLaborHours(SelectedQuote))</strong></div>
                                                <div><span>Labor Cost</span><strong>@EstimateMath.GetCurrency(EstimateMath.GetServiceQuoteLaborCost(SelectedQuote))</strong></div>
                                                <div><span>Material Cost</span><strong>@EstimateMath.GetCurrency(EstimateMath.GetServiceQuoteMaterialCost(SelectedQuote))</strong></div>
                                                <div><span>Total Cost</span><strong>@EstimateMath.GetCurrency(EstimateMath.GetServiceQuoteCost(SelectedQuote))</strong></div>
                                                <div><span>Calculated Sale</span><strong>@EstimateMath.GetCurrency(EstimateMath.GetServiceQuoteCalculatedRevenue(SelectedQuote))</strong></div>
                                                <div><span>Profit</span><strong>@EstimateMath.GetCurrency(EstimateMath.GetServiceQuoteCalculatedProfit(SelectedQuote))</strong></div>
                                                <div><span>Margin</span><strong>@EstimateMath.GetPercent(EstimateMath.GetServiceQuoteCalculatedMarginPercent(SelectedQuote))</strong></div>
                                            </div>
                                        </article>
                                        <article class="summary-card">
                                            <p class="eyebrow">Adjusted Totals</p>
                                            <div class="metric-list">
                                                <label class="metric-input">
                                                    <span>Adjusted Sale</span>
                                                    <div class="input-shell money-input-shell">
                                                        <span class="input-prefix">$</span>
                                                        <input class="shell-input" type="number" step="0.01" @bind="SelectedQuote.AdjustedSalePrice" @bind:event="oninput" @bind:after="RoundServiceQuoteAdjustedSale" />
                                                    </div>
                                                </label>
                                                <div><span>Actual Sale</span><strong>@EstimateMath.GetCurrency(EstimateMath.GetServiceQuoteAdjustedRevenue(SelectedQuote))</strong></div>
                                                <div><span>Profit</span><strong>@EstimateMath.GetCurrency(EstimateMath.GetServiceQuoteAdjustedProfit(SelectedQuote))</strong></div>
                                                <div><span>Margin</span><strong>@EstimateMath.GetPercent(EstimateMath.GetServiceQuoteAdjustedMarginPercent(SelectedQuote))</strong></div>
                                            </div>
                                        </article>
                                    </div>

                                    <div class="stats-inline">
                                        <span>Material Sale @EstimateMath.GetCurrency(EstimateMath.GetServiceQuoteMaterialRevenue(SelectedQuote))</span>
                                        <span>Labor Sale @EstimateMath.GetCurrency(EstimateMath.GetServiceQuoteLaborRevenue(SelectedQuote))</span>
                                        @if (linkedCurrentQuoteCall is not null)
                                        {
                                            <span>Linked Call @linkedCurrentQuoteCall.ServiceJobNumber</span>
                                        }
                                    </div>

                                    @if (linkedCurrentQuoteCall is not null)
                                    {
                                        <div class="section-add-action">
                                            <button class="button button-secondary" type="button" @onclick="() => NavigateToServiceCall(linkedCurrentQuoteCall.Id)">Open Linked Service Call</button>
                                        </div>
                                    }

                                    <div class="panel-header minor">
                                        <h4>Quoted Items</h4>
                                    </div>

                                    @if (SelectedQuote.Items.Count == 0)
                                    {
                                        <p class="muted">Add line items for labor, materials, corrective work, or call-specific scope.</p>
                                    }
                                    else
                                    {
                                        <table class="data-table wide">
                                            <thead>
                                                <tr>
                                                    <th>Description</th>
                                                    <th>Qty</th>
                                                    <th>Unit Cost</th>
                                                    <th>Unit Price</th>
                                                    <th>Notes</th>
                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in SelectedQuote.Items)
                                                {
                                                    <tr id="@GetServiceQuoteItemElementId(item.Id)" class="page-section-anchor" @key="item.Id">
                                                        <td><input @bind="item.Description" /></td>
                                                        <td><input type="number" step="1" @bind="item.Quantity" /></td>
                                                        <td><input type="number" step="0.01" @bind="item.UnitCost" /></td>
                                                        <td><input type="number" step="0.01" @bind="item.UnitPrice" /></td>
                                                        <td><input @bind="item.Notes" /></td>
                                                        <td><button class="text-button danger" type="button" @onclick="() => RemoveQuoteItem(item.Id)">Remove</button></td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    }

                                    <div class="section-add-action">
                                        <button class="button button-secondary" type="button" @onclick="AddQuoteItem">Add Line Item</button>
                                    </div>

                                    <AttachmentManager Attachments="SelectedQuote.Attachments" Area="service-quotes" OwnerId="SelectedQuote.Id" Eyebrow="Quote Files" Title="Attachments" InitiallyExpanded="false" />
                                }
                            </div>
                        </div>
                    }
                </section>

                <AttachmentManager Attachments="SelectedAgreement.Attachments" Area="service" OwnerId="SelectedAgreement.Id" Eyebrow="Agreement Files" Title="Attachments" InitiallyExpanded="false" />

                <section id="@ServiceNotesElementId" class="panel page-section-anchor @(IsSectionExpanded(ServiceNotesSectionId) ? "panel-expanded" : null)">
                    <div class="panel-header">
                        <div>
                            <p class="eyebrow">Agreement notes</p>
                            <h3>Notes</h3>
                        </div>
                        <button class="button button-secondary" type="button" @onclick='() => ToggleSection(ServiceNotesSectionId)'>@(IsSectionExpanded(ServiceNotesSectionId) ? "Collapse" : "Expand")</button>
                    </div>

                    @if (IsSectionExpanded(ServiceNotesSectionId))
                    {
                        <label class="full-width">
                            <span>Notes</span>
                            <textarea class="notes-field" rows="2" @bind="SelectedAgreement.Notes"></textarea>
                        </label>
                    }
                </section>
            }
        </div>
    </section>
}

@if (IsServiceQuoteExportDialogOpen)
{
    <button class="dialog-scrim" type="button" @onclick="CancelServiceQuoteExport" aria-label="Close service quote export dialog"></button>
    <section class="dialog-shell" aria-modal="true" role="dialog" aria-labelledby="service-quote-export-dialog-title">
        <article class="dialog-panel">
            <div class="panel-header">
                <div>
                    <p class="eyebrow">Service Quote Export</p>
                    <h3 id="service-quote-export-dialog-title">Name Quote File</h3>
                </div>
            </div>

            <p class="muted">The default file name is based on the service site and quote title, and you can adjust it before the PDF is created.</p>

            <label class="full-width">
                <span>File Name</span>
                <input autofocus @bind="ServiceQuoteExportFileName" />
            </label>

            <div class="button-row">
                <button class="button" type="button" @onclick="ConfirmServiceQuoteExportAsync">Export Quote</button>
                <button class="button button-secondary" type="button" @onclick="CancelServiceQuoteExport">Cancel</button>
            </div>
        </article>
    </section>
}
