@page "/settings"
@inject WorkspaceStore Store

<PageTitle>Settings</PageTitle>

@if (!Store.IsInitialized)
{
    <div class="loading-state">
        <h1>Loading settings...</h1>
        <p>Preparing storage, defaults, and backup paths.</p>
    </div>
}
else
{
    <section class="dashboard-grid">
        <article class="panel accent">
            <div class="panel-header">
                <div>
                    <p class="eyebrow">Storage</p>
                    <h2>@Store.Workspace.Settings.StorageMode</h2>
                </div>
                <button class="button" type="button" @onclick="BackupAsync">Create Backup</button>
            </div>

            @if (!string.IsNullOrWhiteSpace(StatusMessage))
            {
                <p class="callout callout-success">@StatusMessage</p>
            }

            <p>@Store.Workspace.Settings.StorageNotes</p>
            <div class="list-stack compact">
                <div class="list-row storage-path-row">
                    <div class="storage-path-copy">
                        <strong>Data File</strong>
                        <span>@Store.DataFilePath</span>
                    </div>
                    @if (Store.CanOpenStorageLocations)
                    {
                        <button class="button button-secondary" type="button" @onclick="OpenDataDirectoryAsync">Open Folder</button>
                    }
                </div>
                <div class="list-row storage-path-row">
                    <div class="storage-path-copy">
                        <strong>Attachments</strong>
                        <span>@Store.AttachmentRootPath</span>
                    </div>
                    @if (Store.CanOpenStorageLocations)
                    {
                        <button class="button button-secondary" type="button" @onclick="OpenAttachmentDirectoryAsync">Open Folder</button>
                    }
                </div>
                <div class="list-row storage-path-row">
                    <div class="storage-path-copy">
                        <strong>Branding</strong>
                        <span>@Store.BrandingRootPath</span>
                    </div>
                    @if (Store.CanOpenStorageLocations)
                    {
                        <button class="button button-secondary" type="button" @onclick="OpenBrandingDirectoryAsync">Open Folder</button>
                    }
                </div>
                <div class="list-row storage-path-row">
                    <div class="storage-path-copy">
                        <strong>Exports</strong>
                        <span>@Store.ExportRootPath</span>
                    </div>
                    @if (Store.CanOpenStorageLocations)
                    {
                        <button class="button button-secondary" type="button" @onclick="OpenExportDirectoryAsync">Open Folder</button>
                    }
                </div>
                <div class="list-row storage-path-row">
                    <div class="storage-path-copy">
                        <strong>Backups</strong>
                        <span>@Store.BackupRootPath</span>
                    </div>
                    @if (Store.CanOpenStorageLocations)
                    {
                        <button class="button button-secondary" type="button" @onclick="OpenBackupDirectoryAsync">Open Folder</button>
                    }
                </div>
            </div>
        </article>

        <article class="panel">
            <div class="panel-header">
                <div>
                    <p class="eyebrow">Workspace defaults</p>
                    <h2>Service + Storage Defaults</h2>
                </div>
                <button class="button" type="button" @onclick="SaveAsync">Save Settings</button>
            </div>

            <p class="muted">Bid labor rates, markup, and numbering now live on the Templates page. This screen holds workspace storage and service defaults.</p>

            <div class="form-grid two-columns">
                <label>
                    <span>Field Labor Rate</span>
                    <input type="number" step="0.01" @bind="Store.Workspace.Settings.FieldLaborRate" />
                </label>
                <label>
                    <span>Admin Labor Rate</span>
                    <input type="number" step="0.01" @bind="Store.Workspace.Settings.AdminLaborRate" />
                </label>
                <label>
                    <span>Engineering Labor Rate</span>
                    <input type="number" step="0.01" @bind="Store.Workspace.Settings.EngineeringLaborRate" />
                </label>
                <label>
                    <span>Default Markup %</span>
                    <input type="number" step="0.01" @bind="Store.Workspace.Settings.DefaultMarkupPercent" />
                </label>
                <label>
                    <span>Default Contract Months</span>
                    <input type="number" step="1" @bind="Store.Workspace.Settings.DefaultServiceContractMonths" />
                </label>
                <label>
                    <span>Default Inspection Interval</span>
                    <input type="number" step="1" @bind="Store.Workspace.Settings.DefaultInspectionIntervalMonths" />
                </label>
                <label>
                    <span>Default Monthly Monitoring</span>
                    <input type="number" step="0.01" @bind="Store.Workspace.Settings.DefaultMonthlyMonitoringAmount" />
                </label>
            </div>

            <label class="full-width">
                <span>Storage Notes</span>
                <textarea rows="3" @bind="Store.Workspace.Settings.StorageNotes"></textarea>
            </label>
        </article>

        <article class="panel">
            <div class="panel-header">
                <div>
                    <p class="eyebrow">Proposal branding</p>
                    <h2>Logo + Company Footer</h2>
                </div>
                <div class="button-row">
                    @if (Store.CanPickAttachments)
                    {
                        <button class="button button-secondary" type="button" @onclick="SelectProposalLogoAsync">Choose Logo</button>
                    }
                    @if (HasProposalLogo)
                    {
                        <button class="button button-secondary" type="button" @onclick="RemoveProposalLogoAsync">Remove Logo</button>
                    }
                    <button class="button" type="button" @onclick="SaveAsync">Save Settings</button>
                </div>
            </div>

            <p class="muted">The proposal export places the logo above the proposal content and uses the company details below as the sendable footer.</p>

            <div class="branding-preview-grid">
                @if (!string.IsNullOrWhiteSpace(ProposalLogoPreviewDataUri))
                {
                    <div class="proposal-logo-preview-shell">
                        <img class="proposal-logo-preview-image" src="@ProposalLogoPreviewDataUri" alt="Proposal logo preview" />
                    </div>
                }
                else
                {
                    <div class="branding-empty-state">
                        <strong>No logo selected</strong>
                        <p class="muted small">Add a PNG, JPG, SVG, GIF, BMP, or WEBP logo to place it above the proposal header.</p>
                    </div>
                }

                <div class="list-stack compact">
                    <div class="list-row">
                        <div class="storage-path-copy">
                            <strong>Stored Logo</strong>
                            <span>@(string.IsNullOrWhiteSpace(Store.Workspace.Settings.ProposalLogoOriginalFileName) ? "No file saved yet." : Store.Workspace.Settings.ProposalLogoOriginalFileName)</span>
                        </div>
                    </div>
                    @if (!Store.CanPickAttachments)
                    {
                        <div class="list-row">
                            <div class="storage-path-copy">
                                <strong>Logo Upload</strong>
                                <span>Logo selection is currently available in the desktop app host.</span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="form-grid two-columns">
                <label>
                    <span>Company Name</span>
                    <input @bind="Store.Workspace.Settings.ProposalCompanyName" />
                </label>
                <label>
                    <span>License Number</span>
                    <input @bind="Store.Workspace.Settings.ProposalCompanyLicenseNumber" />
                </label>
                <label>
                    <span>Phone Number</span>
                    <input @bind="Store.Workspace.Settings.ProposalCompanyPhoneNumber" />
                </label>
                <label>
                    <span>Email</span>
                    <input type="email" @bind="Store.Workspace.Settings.ProposalCompanyEmail" />
                </label>
                <label class="full-width">
                    <span>Address</span>
                    <textarea rows="2" @bind="Store.Workspace.Settings.ProposalCompanyAddress"></textarea>
                </label>
            </div>
        </article>

        <article class="panel">
            <p class="eyebrow">Current default template</p>
            <h2>@(DefaultTemplate?.Name ?? "None selected")</h2>
            <p class="muted">Set or change the default install-time template from the templates page.</p>
        </article>
    </section>
}

