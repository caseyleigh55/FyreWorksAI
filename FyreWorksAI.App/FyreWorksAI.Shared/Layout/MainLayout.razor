@inherits LayoutComponentBase

<div class="shell @((PageSectionNavigationState.HasItems || PageSectionNavigationState.HasContext) ? "shell-with-page-sections" : null)">
    <header class="shell-topbar">
        <div class="topbar-brand">
            <p class="eyebrow">FyreWorks</p>
            <h1>Operations Hub</h1>
        </div>
        <div class="topbar-center">
            <nav class="shell-nav">
                <NavLink href="/" Match="NavLinkMatch.All">Dashboard</NavLink>
                <NavLink href="/bids">Bids</NavLink>
                <NavLink href="/jobs">Jobs</NavLink>
                <NavLink href="/service">Service</NavLink>
                <NavLink href="/templates">Templates</NavLink>
                <NavLink href="/settings">Settings</NavLink>
            </nav>

            @if (PageSectionNavigationState.HasContext)
            {
                <div class="shell-page-context" aria-label="Current record">
                    @if (!string.IsNullOrWhiteSpace(PageSectionNavigationState.ContextLabel))
                    {
                        <span class="shell-page-context-label">@PageSectionNavigationState.ContextLabel</span>
                    }
                    <strong class="shell-page-context-value">@PageSectionNavigationState.ContextValue</strong>
                </div>
            }

            @if (PageSectionNavigationState.HasItems)
            {
                <nav class="shell-page-section-nav" aria-label="Page sections">
                    @foreach (var item in PageSectionNavigationState.NavigationItems)
                    {
                        <button class="shell-page-section-link @(PageSectionNavigationState.ActiveSectionId == item.SectionId ? "shell-page-section-link-active" : null)"
                                type="button"
                                @onclick="() => NavigateToSectionAsync(item)">
                            @item.Label
                        </button>
                    }
                </nav>
            }
        </div>
        <div class="header-badge">
            <span>Text file storage active</span>
        </div>
    </header>

    <main class="shell-main">
        <header class="shell-header">
            <div>
                <p class="eyebrow">Command center</p>
                <h2>Office workflow management</h2>
            </div>
        </header>

        <section class="shell-body">
            @Body
        </section>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
